server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/conf.d/snippets/security-headers.conf;

    # Hashed build files never change under the same name.
    location /assets/ {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
    }

    location ~ ^/(sw\.js|manifest\.webmanifest|offline\.html|pwa/.*)$ {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        types { application/manifest+json webmanifest; application/javascript js; text/html html; image/png png; }
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # SPA fallback: any other path is a client-side route.
    location / {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
