{
	"name": "citypark-admin",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"check": "npm run typecheck && npm run lint && prettier --check . && npm run test",
		"e2e": "playwright test",
		"api:gen": "openapi-typescript ../citypark-go/internal/apidocs/openapi.yaml -o src/shared/api/schema.d.ts"
	},
	"dependencies": {
		"@heroui/react": "^3.2.6",
		"@heroui/styles": "^3.2.6",
		"@internationalized/date": "^3.12.4",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-router": "^1.170.46",
		"@tiptap/extension-link": "^3.32.0",
		"@tiptap/extension-placeholder": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/react": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"openapi-fetch": "^0.17.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-plugin": "^1.168.48",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^10.13.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	}
}
