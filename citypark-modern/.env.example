# Server-only citypark-go API, including /api/v1. Never prefix with NEXT_PUBLIC_.
# In production use the backend's reachable internal URL; never expose credentials or session tokens to the browser.
MENU_API_URL=http://localhost:3000/api/v1
# Server-only public website origin for redirects and links; exactly match the backend's CUSTOMER_PUBLIC_ORIGIN.
# Production must use public HTTPS without a path or trailing slash.
CUSTOMER_PUBLIC_ORIGIN=http://localhost:3001
# Optional: host of the menu photos (from iiko), allowed for next/image. Empty = no remote photos.
MENU_IMAGE_HOST=
# Optional: the backend's PUBLIC_BASE_URL (e.g. http://localhost:3000), allowed for next/image so uploaded photos load. Empty = no uploaded photos.
UPLOADS_ORIGIN=
# Optional: Yandex Maps JS API key (https://developer.tech.yandex.ru/), read on the server. Restrict it by HTTP Referer in the cabinet. Empty = the map stays a placeholder.
YANDEX_MAPS_API_KEY=
# Optional: DaData API key (dadata.ru cabinet, «API-ключ»), read on the server. Enables typed address suggestions and automatic reverse geocoding on checkout; empty keeps manual entry available.
DADATA_API_KEY=
# Optional: set to 1 for full DaData geolocation responses and town-matching reasons in the Next.js terminal.
# Only active in development. Restart npm run dev after changing; provider responses include address data.
DADATA_DEBUG=
# Optional: configured Telegram bot Mini App link (https://t.me/<bot>/<app>). Used after external payment if the embedded view closes.
TELEGRAM_MINI_APP_URL=
