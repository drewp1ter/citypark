
Процедура ДобавитьСуммуПрихода(Дата, Организация, Касса, Сумма, СтатьяДвижения = Неопределено) Экспорт
	
	Движение = ДобавитьПриход();
	Движение.Период = Дата;
	Движение.Организация = Организация;
	Движение.Касса = Касса;
	Движение.Сумма = Сумма;
	Если СтатьяДвижения <> Неопределено Тогда
		Движение.СтатьяДвижения = СтатьяДвижения;
	КонецЕсли;
	
КонецПроцедуры

