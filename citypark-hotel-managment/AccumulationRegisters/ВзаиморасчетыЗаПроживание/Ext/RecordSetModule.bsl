
Процедура ДобавитьОплату(Дата, ДокументРасчетов, Сумма) Экспорт
	
	НоваяЗапись = ДобавитьРасход();
	НоваяЗапись.Период = Дата;
	НоваяЗапись.ДокументРасчетов = ДокументРасчетов;
	НоваяЗапись.Сумма = Сумма;
	
КонецПроцедуры

Процедура ДобавитьЗадолженностьПоТарифам(ДатаЗаселения, ДокументРасчетов, Тариф, Количество, Цена) Экспорт
	
	Для ТекЕдиницаТарифа = 0 По Количество - 1 Цикл
		
		НоваяЗапись = ДобавитьПриход();
		НоваяЗапись.Период = УправлениеЗаселением.РассчитатьДатуПоТарифу(ДатаЗаселения, Тариф, ТекЕдиницаТарифа);
		НоваяЗапись.ДокументРасчетов = ДокументРасчетов;
		НоваяЗапись.Сумма = Цена;
		
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЗадолженностьПоТарифамДляПоследнейСтроки(ДатаЗаселения, ДатаВыселения, ДокументРасчетов, Тариф, Количество, Цена) Экспорт
	
	//Если Количество < 1 Тогда
	//	
	//	Количество = 1 ;		
	//	
	//КонецЕсли;
	//
	Для ТекЕдиницаТарифа = 0 По Количество - 1 Цикл
		
		НоваяЗапись = ДобавитьПриход();
		ДатаНачисленияДолга = УправлениеЗаселением.РассчитатьДатуПоТарифу(ДатаЗаселения, Тариф, ТекЕдиницаТарифа);
		
		Если ДатаНачисленияДолга < ДатаЗаселения Тогда
			ДатаНачисленияДолга = ДатаЗаселения;
		КонецЕсли;
		
		Если ДатаНачисленияДолга > ДатаВыселения Тогда
			ДатаНачисленияДолга = ДатаВыселения;
		КонецЕсли;
		
		НоваяЗапись.Период = ДатаНачисленияДолга;		
		НоваяЗапись.ДокументРасчетов = ДокументРасчетов;
		НоваяЗапись.Сумма = Цена;
		
	КонецЦикла;

КонецПроцедуры


Процедура ДобавитьЗадолженность(Дата, ДокументРасчетов, Сумма) Экспорт
	
	НоваяЗапись = ДобавитьПриход();
	НоваяЗапись.Период = Дата;
	НоваяЗапись.ДокументРасчетов = ДокументРасчетов;
	НоваяЗапись.Сумма = Сумма;

КонецПроцедуры