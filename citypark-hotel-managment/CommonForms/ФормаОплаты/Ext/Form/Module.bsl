&НаКлиенте
Процедура ДокументыОплатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтрокаОплаты = ДокументыОплаты.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ЗначениеЗаполнено(СтрокаОплаты.Регистратор) Тогда
		ПараметрыОткрытия = Новый Структура("Ключ, ТолькоПросмотр", СтрокаОплаты.Регистратор, Истина);
		
		Если СтрокаОплаты.ВидДокумента = "БН" Тогда
			
			ОткрытьФорму("Документ.БезналичнаяОплата.ФормаОбъекта", ПараметрыОткрытия);
			
		ИначеЕсли СтрокаОплаты.ВидДокумента = "ПКО" Тогда 
			
			ОткрытьФорму("Документ.ПриходныйКассовыйОрдер.ФормаОбъекта", ПараметрыОткрытия);
			
		ИначеЕсли СтрокаОплаты.ВидДокумента = "РКО" Тогда
			
			ОткрытьФорму("Документ.РасходныйКассовыйОрдер.ФормаОбъекта", ПараметрыОткрытия);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


