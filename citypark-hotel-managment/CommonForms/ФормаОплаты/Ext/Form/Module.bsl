&НаСервере
Процедура ЗаполнитьДокументыОплаты()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Основание", Основание);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВзаиморасчетыЗаПроживаниеОбороты.Регистратор,
	               |	ВзаиморасчетыЗаПроживаниеОбороты.СуммаПриход * -1 КАК Сумма,
	               |	ВзаиморасчетыЗаПроживаниеОбороты.Период КАК Дата,
	               |	ВЫБОР
	               |		КОГДА ВзаиморасчетыЗаПроживаниеОбороты.Регистратор ССЫЛКА Документ.БезналичнаяОплата
	               |			ТОГДА ""БН""
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ВзаиморасчетыЗаПроживаниеОбороты.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	               |					ТОГДА ""ПКО""
	               |				ИНАЧЕ ""РКО""
	               |			КОНЕЦ
	               |	КОНЕЦ КАК ВидДокумента
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыЗаПроживание.Обороты(, , Регистратор, ДокументРасчетов = &Основание) КАК ВзаиморасчетыЗаПроживаниеОбороты
	               |ГДЕ
	               |	НЕ ВзаиморасчетыЗаПроживаниеОбороты.Регистратор ССЫЛКА Документ.Заселение
	               |	И НЕ ВзаиморасчетыЗаПроживаниеОбороты.Регистратор ССЫЛКА Документ.Выселение
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВзаиморасчетыЗаПроживаниеОбороты.Регистратор,
	               |	ВзаиморасчетыЗаПроживаниеОбороты.СуммаРасход,
	               |	ВзаиморасчетыЗаПроживаниеОбороты.Период,
	               |	ВЫБОР
	               |		КОГДА ВзаиморасчетыЗаПроживаниеОбороты.Регистратор ССЫЛКА Документ.БезналичнаяОплата
	               |			ТОГДА ""БН""
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ВзаиморасчетыЗаПроживаниеОбороты.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	               |					ТОГДА ""ПКО""
	               |				ИНАЧЕ ""РКО""
	               |			КОНЕЦ
	               |	КОНЕЦ
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыЗаПроживание.Обороты(, , Регистратор, ДокументРасчетов = &Основание) КАК ВзаиморасчетыЗаПроживаниеОбороты
	               |ГДЕ
	               |	НЕ ВзаиморасчетыЗаПроживаниеОбороты.Регистратор ССЫЛКА Документ.Заселение
	               |	И НЕ ВзаиморасчетыЗаПроживаниеОбороты.Регистратор ССЫЛКА Документ.Выселение
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата";
				   
	ДокументыОплаты.Загрузить(Запрос.Выполнить().Выгрузить());
	ОплаченоРанее = ДокументыОплаты.Итог("Сумма");
	
КонецПроцедуры

Функция ПостроитьРазделитель(ДлинаПоля = 32)
	
	ДлинаПоля = 32;
	ТекстПолный = "";
	ТекущаяДлина = 0;
	Пока ТекущаяДлина < ДлинаПоля Цикл
		ТекстПолный = ТекстПолный + "-";
		ТекущаяДлина = ТекущаяДлина + 1;
	КонецЦикла;
	
	Возврат ТекстПолный;
	
КонецФункции

&НаСервере
Функция ПечатьТоварногоЧекаНаСервере(ШиринаСтрокиПечатающегоУстройва)
	
	ФорматЧисла = "ЧРД=,;ЧЦ=10;ЧДЦ=2;ЧН=0,00";
	
	// Шапка
	Текст = "ТОВАРНЫЙ ЧЕК от " + Формат(ТекущаяДата(), "ДЛФ=ДД") + Символы.ПС +
		ПостроитьРазделитель(ШиринаСтрокиПечатающегоУстройва) + Символы.ПС +
		"Организация: " +   Символы.ПС +
		"Вид операции: " +  Символы.ПС;
	
	//Если ЗначениеЗаполнено(Клиент) Тогда
	//	Текст = Текст + "Клиент: " + Клиент + Символы.ПС;
	//КонецЕсли;
	
	Текст = Текст + ПостроитьРазделитель(ШиринаСтрокиПечатающегоУстройва) + Символы.ПС;
	
	// Товары
	Для Каждого СтрокаТЧ ИЗ Товары Цикл
		
		СтрокаТовара = "" + СтрокаТЧ.Номенклатура + Символы.ПС +
			Формат(СтрокаТЧ.Количество, "ЧРД=,;ЧЦ=10;ЧДЦ=3;ЧН=0,000") + " х " + Формат(СтрокаТЧ.Цена, ФорматЧисла) +
			" = " + Формат(СтрокаТЧ.Сумма, ФорматЧисла) + Символы.ПС;
		Текст = Текст + СтрокаТовара;
		
	КонецЦикла;
	
	//Для Каждого СтрокаТЧ ИЗ Товары Цикл
	//	
	//	СтрокаТовара = "" + СтрокаТЧ.Номенклатура + Символы.ПС +
	//		Формат(СтрокаТЧ.Количество, "ЧРД=,;ЧЦ=10;ЧДЦ=3;ЧН=0,000") + " х " + Формат(СтрокаТЧ.Цена, ФорматЧисла) +
	//		" = " + Формат(СтрокаТЧ.Сумма, ФорматЧисла) + Символы.ПС;
	//	Текст = Текст + СтрокаТовара;
	//	
	//КонецЦикла;

	
	Текст = Текст + ПостроитьРазделитель(ШиринаСтрокиПечатающегоУстройва) + Символы.ПС;
	
	// Итоги
	Текст = Текст + "         ИТОГ = " + Формат(ПолученоНаличными + ПолученоПоКартам - Сдача, ФорматЧисла) + Символы.ПС +
		"       СКИДКА = " + Формат(СуммаСкидки, ФорматЧисла) + Символы.ПС +
		"    СУММА НДС = " + Формат(0, ФорматЧисла) + Символы.ПС;
	
	Текст = Текст + ПостроитьРазделитель(ШиринаСтрокиПечатающегоУстройва) + Символы.ПС;
	//                                      
	//// Оплата
	//ВидОплаты = Перечисления.ФормыОплаты.Наличные;
	Текст = Текст + "    НАЛИЧНЫМИ = " + Формат(ПолученоНаличными, ФорматЧисла) + Символы.ПС;
	//ВидОплаты = Перечисления.ФормыОплаты.ПлатежнаяКарта;
	Текст = Текст + "  ПЛАТ.КАРТОЙ = " + Формат(ПолученоПоКартам, ФорматЧисла) + Символы.ПС;
	//ВидОплаты = Перечисления.ФормыОплаты.Кредит;
	//Текст = Текст + "     КРЕДИТОМ = " + Формат(ВернутьИтогиОплатыПоВиду(ВидОплаты), ФорматЧисла) + Символы.ПС;
	//ВидОплаты = Перечисления.ФормыОплаты.Сертификат;
	//Текст = Текст + " СЕРТИФИКАТОМ = " + Формат(ВернутьИтогиОплатыПоВиду(ВидОплаты), ФорматЧисла) + Символы.ПС;
	//
	Текст = Текст + ПостроитьРазделитель(ШиринаСтрокиПечатающегоУстройва) + Символы.ПС;
	// Сдача
	Текст = Текст + "        СДАЧА = " + Формат(Сдача, ФорматЧисла) + Символы.ПС;
	
	Текст = Текст + ПостроитьРазделитель(ШиринаСтрокиПечатающегоУстройва) + Символы.ПС;
	Текст = Текст + "       КАССИР:  " + ЗаполнениеДокументовВызовСервера.ПолучитьТекущегоПользователя() + Символы.ПС;
	Текст = Текст + ПостроитьРазделитель(ШиринаСтрокиПечатающегоУстройва) + Символы.ПС + Символы.ПС + Символы.ПС;
	Текст = Формат(Текст,"Л = ru");
	
	Возврат Текст;

КонецФункции


