#КонецОбласти

#Область ОбщиеМетодыКлиентаИСервера


Процедура ПересчитатьСуммы()
	
	Доплатить = КОплате - ПолученоНаличными - ПолученоПоКартам;
	Сдача = ?(Доплатить < 0, Доплатить * (-1), 0);
	Доплатить = Доплатить + Сдача;	
	
КонецПроцедуры

Процедура УстановитьВидимость()
	
	Элементы.КомандаПробитьЧек.Доступность = ?(РазрешенаЧастичнаяОплата, Истина, Доплатить = 0);
	Элементы.ГруппаТоваров.Видимость = Товары.Количество() > 0;
	Элементы.ГруппаПроживания.Видимость = Проживание.Количество() > 0;
	
КонецПроцедуры


#КонецОбласти

