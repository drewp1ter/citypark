&НаКлиенте
Процедура КомандаОплатитьНаличными(Команда)
	
	ОповещениеВводаНаличных = Новый ОписаниеОповещения("ПользовательВвелСуммуНаличных", ЭтаФорма);
	ЦифроваяКлавиатура.НачатьВводЧисла(ОповещениеВводаНаличных);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОплатитьКартой(Команда)
	
	ОповещениеВводаБезналичных = Новый ОписаниеОповещения("ПользовательВвелСуммуБезналичных", ЭтаФорма);
	ЦифроваяКлавиатура.НачатьВводЧисла(ОповещениеВводаБезналичных);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПробитьЧек(Команда)
	
	// Печать чека
	ОписаниеОповещения = Новый ОписаниеОповещения("ПечатьТоварногоЧекаЗавершение", ЭтотОбъект);
	МенеджерОборудованияКлиент.ПредложитьВыбратьУстройство(ОписаниеОповещения, "ЧековыйПринтер",
			НСтр("ru='Выберите чековый принтер'"), НСтр("ru='Чековый принтер не подключен.'"));
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	ЭтаФорма.Закрыть(0);
	
КонецПроцедуры


