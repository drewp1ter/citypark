&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СуммаБезСкидки = Параметры.СуммаБезСкидки;
	СуммаСкидки = Параметры.СуммаСкидки;
	КОплате = Параметры.КОплате; 
	РазрешенаЧастичнаяОплата = Параметры.РазрешенаЧастичнаяОплата;
	Основание = Параметры.Основание;
	
	Если ЗначениеЗаполнено(Параметры.Товары) Тогда
		Товары.Загрузить(Параметры.Товары.Выгрузить());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Проживание) Тогда
		Проживание.Загрузить(Параметры.Проживание.Выгрузить());
	КонецЕсли;
	
	Если РазрешенаЧастичнаяОплата Тогда
		
		ЗаполнитьДокументыОплаты();
		
	КонецЕсли;
	
	Если КОплате <= 0 Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если СуммаБезСкидки = 0 Тогда
		СуммаБезСкидки = КОплате;
	КонецЕсли;
	
	ПересчитатьСуммы();
	УстановитьВидимость();
	
КонецПроцедуры


