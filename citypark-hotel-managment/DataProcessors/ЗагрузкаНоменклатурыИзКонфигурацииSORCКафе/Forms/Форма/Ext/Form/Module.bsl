&НаСервере
Функция ПолучитьГруппуНоменклатуры(КОМСсылка) 
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", КОМСсылка.Наименование);
	Запрос.Текст = "ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа
	|	И Номенклатура.Наименование = &Наименование";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;		
		
	КонецЕсли;
	
	// Ничего не найдено, создаем новую
	
	НоваяГруппа = Справочники.Номенклатура.СоздатьГруппу();	
	НоваяГруппа.Наименование = КомСсылка.Наименование;
	
	Если КомСсылка.Родитель.Код <> "" Тогда // Нет Родителя
		
		НоваяГруппа.Родитель = ПолучитьГруппуНоменклатуры(КомСсылка.Родитель);
		
	КонецЕсли;
	
	НоваяГруппа.Записать();
	
	Возврат НоваяГруппа.Ссылка;
	
КонецФункции

