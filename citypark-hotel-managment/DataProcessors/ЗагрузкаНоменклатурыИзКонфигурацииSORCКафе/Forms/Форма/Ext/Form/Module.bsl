&НаСервере
Функция ПолучитьЕдиницуИзмерения(КОМСсылка, Номенклатура) 
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", КОМСсылка.Наименование);
	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕдиницыИзмерения.Ссылка
	               |ИЗ
	               |	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	               |ГДЕ
	               |	ЕдиницыИзмерения.Наименование = &Наименование
	               |	И ЕдиницыИзмерения.Владелец = &Владелец";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;		
		
	КонецЕсли;
	
	// Ничего не найдено, создаем новый элемент
	
	НовыйЭлемент = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();	
	НовыйЭлемент.Наименование = КомСсылка.Наименование;
	НовыйЭлемент.Коэффициент = КомСсылка.Коэффициент;
	НовыйЭлемент.Владелец = Номенклатура;
	
	НовыйЭлемент.Записать();
	
	Возврат НовыйЭлемент.Ссылка;
	
КонецФункции

&НаСервере
Функция ПолучитьНоменклатуру(КОМСсылка, Родитель, НоменклатурнаяГруппа) 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", КОМСсылка.Наименование);
	Запрос.УстановитьПараметр("Родитель", Родитель);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	НЕ Номенклатура.ЭтоГруппа
	               |	И Номенклатура.Наименование = &Наименование
	               |	И Номенклатура.Родитель = &Родитель";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
				
		Возврат Выборка.Ссылка;
		
	КонецЕсли;
	
	// Ничего не найдено, создаем новую
	
	НоваяНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();	
	НоваяНоменклатура.Наименование = КомСсылка.Наименование;
	НоваяНоменклатура.Родитель = Родитель;
	НоваяНоменклатура.БазоваяЕдиницаИзмерения = ПолучитьБазовуюЕдиницуИзмерения(КомСсылка.БазоваяЕдиницаИзмерения);
	НоваяНоменклатура.НоменклатурнаяГруппа = НоменклатурнаяГруппа;
	НоваяНоменклатура.Загружена = Истина;
	НоваяНоменклатура.Записать();
	НоваяНоменклатура.ОсновнаяЕдиницаИзмерения = ПолучитьЕдиницуИзмерения(КомСсылка.ОсновнаяЕдиницаИзмерения, НоваяНоменклатура.Ссылка);
	НоваяНоменклатура.Записать();
	
	Возврат НоваяНоменклатура.Ссылка;
	
КонецФункции


&НаСервере
Процедура КомандаЗагрузитьНаСервере()
	
	// Создание объекта-коннектора
	Коннектор = Новый COMObject("V83.COMConnector");

	// создается объект COM-соединение
	Соединение = Коннектор.Connect("File=""" + Объект.ПутьКБазе + """;Usr=""" + Объект.Пользователь + """; PWD=""" + Объект.Пароль + """");
	//Соединение = Коннектор.Connect("File=""D:\work 2014\Development 1С\SORC Кафе"";Usr=""ws""; PWD=""ws""");
	
	КаталогПродукции =  Соединение.Константы.КаталогПродукцииКафе.Получить(); 	
	
	Запрос = Соединение.NewObject("Запрос");
	Запрос.Текст = "ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Номенклатура.ВидМестаПриготовления) КАК НоменклатурнаяГруппа
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В ИЕРАРХИИ(&Владелец)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ПОМЕСТИТЬ ВТ_Цены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, ) КАК ЦеныНоменклатурыСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Ссылка,
	|	ВТ_Номенклатура.НоменклатурнаяГруппа,
	|	ЕСТЬNULL(ВТ_Цены.Цена, 0) КАК Цена
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ВТ_Цены
	|		ПО ВТ_Номенклатура.Ссылка = ВТ_Цены.Номенклатура";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Владелец", КаталогПродукции);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		НачатьТранзакцию();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		УстановкаЦен = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		УстановкаЦен.Дата = ТекущаяДата();
		УстановкаЦен.ТипЦен = Объект.ТипЦен;
				
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Ссылка.ЭтоГруппа Тогда
				
				НайденнаяГруппа = ПолучитьГруппуНоменклатуры(Выборка.Ссылка);
				
			Иначе
				
				НайденнаяНоменклатура = ПолучитьНоменклатуру(Выборка.Ссылка, ПолучитьГруппуНоменклатуры(Выборка.Ссылка.Родитель), ПолучитьНоменклатурнуюГруппу(Выборка.НоменклатурнаяГруппа));
				
				Если Выборка.Цена <> 0 Тогда
					
					СтрокаЦен = УстановкаЦен.Товары.Добавить();
					СтрокаЦен.Номенклатура = НайденнаяНоменклатура;
					СтрокаЦен.ЕдиницаИзмерения = НайденнаяНоменклатура.ОсновнаяЕдиницаИзмерения;
					СтрокаЦен.Цена = Выборка.Цена;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		УстановкаЦен.Записать();
		
		ЗафиксироватьТранзакцию();
		
	КонецЕсли;				   
	
КонецПроцедуры


