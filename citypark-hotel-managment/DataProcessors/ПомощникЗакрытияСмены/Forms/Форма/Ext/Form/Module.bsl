Процедура УстановитьВидимость()
	
	Элементы.ВидОперации.Заголовок = Строка(Объект.ТекущаяОперация + 1) + ". " + СписокОпераций[Объект.ТекущаяОперация].Представление;
	Элементы.КомандаДалее.Заголовок = ?(Объект.ТекущаяОперация = СписокОпераций.Количество() - 1 , "Готово" , "Далее >"); 
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.Найти(СписокОпераций[Объект.ТекущаяОперация].Значение);
	
КонецПроцедуры

Процедура УстановитьДоступность()
	
	Элементы.КомандаНазад.Доступность = Объект.ТекущаяОперация <> 0;
	
КонецПроцедуры

Процедура ПересчитатьПоказателиПоНачалуСмены()
	
	Разница = Объект.НаНачалоФакт - Объект.НаНачало;
	Если Разница >= 0 Тогда
		Объект.Излишки = Разница;
		Объект.Недостачи = Объект.НеоплаченныеДокументыПроживания.Итог("Сумма");
	ИначеЕсли Разница < 0 Тогда
		Объект.Излишки = 0;
		Объект.Недостачи = (Разница * (-1)) + Объект.НеоплаченныеДокументыПроживания.Итог("Сумма");
	КонецЕсли;
	
	Объект.НаКонецФакт = Объект.НаНачало + Объект.Приход - Объект.Расход;
	
КонецПроцедуры

Процедура ПересчитатьПоказателиПоОкончаниюСмены()
	
	Разница = Объект.НаКонецФакт - (Объект.НаНачалоФакт + Объект.Приход - Объект.Расход);
	Если Разница >= 0 Тогда
		Объект.Излишки = Разница;
		Объект.Недостачи = Объект.НеоплаченныеДокументыПроживания.Итог("Сумма");
	ИначеЕсли Разница < 0 Тогда
		Объект.Излишки = 0;
		Объект.Недостачи = (Разница * (-1)) + Объект.НеоплаченныеДокументыВыселения.Итог("Сумма");
	КонецЕсли;
	
КонецПроцедуры

