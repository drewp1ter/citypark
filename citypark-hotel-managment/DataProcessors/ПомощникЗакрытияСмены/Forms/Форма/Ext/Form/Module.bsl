&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Организация
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		Объект.Организация = Параметры.Организация;
	Иначе
		Объект.Организация = ЗаполнениеДокументов.ПолучитьЗначениеПользователяПоУмолчанию("ОсновнаяОрганизация");
	КонецЕсли;
	
	// Гостиничный корпус
	Если ЗначениеЗаполнено(Параметры.ГостиничныйКорпус) Тогда
		Объект.ГостиничныйКорпус = Параметры.ГостиничныйКорпус;
	Иначе
		Объект.ГостиничныйКорпус = ЗаполнениеДокументов.ПолучитьЗначениеПользователяПоУмолчанию("ОсновнойГостиничныйКорпус");
	КонецЕсли;
	
	// Торговая точка
	Если ЗначениеЗаполнено(Параметры.ТорговаяТочка) Тогда
		Объект.ТорговаяТочка = Параметры.ТорговаяТочка;
	Иначе
		Объект.ТорговаяТочка = ЗаполнениеДокументов.ПолучитьЗначениеПользователяПоУмолчанию("ОсновнаяТорговаяТочка");		
	КонецЕсли;
	
	// Касса
	Если ЗначениеЗаполнено(Параметры.Касса) Тогда
		Объект.Касса = Параметры.Касса;
	Иначе
		Объект.Касса = ЗаполнениеДокументов.ПолучитьЗначениеПользователяПоУмолчанию("ОсновнаяКасса");
	КонецЕсли;
	
	// Смену сдал 
	Если ЗначениеЗаполнено(Параметры.СменуСдал) Тогда
		Объект.СменуСдал = Параметры.СменуСдал;
	Иначе
		Объект.СменуСдал = ЗаполнениеДокументов.ПолучитьЗначениеПользователяПоУмолчанию("ФизическоеЛицо");
	КонецЕсли;
	
	Объект.НачалоСмены = ЗаполнениеДокументовВызовСервера.ПолучитьДатуПрошлогоЗакрытияСменыГостиницы(Объект.Организация, Объект.ГостиничныйКорпус);
	Объект.КонецСмены = ТекущаяДата();
	
	СписокОпераций = Новый СписокЗначений;
	СписокОпераций.Добавить("ЗакрытиеСменыАдминистратораГостиницы", "Информация по номерному фонду");
	СписокОпераций.Добавить("ОтчетОРозничныхПродажах", "Информация по продажам");
	СписокОпераций.Добавить("ЗакрытиеКассовойСмены", "Информация по кассовым операциям");
	
	Объект.ТекущаяОперация = 0;
	
	ЗаполнитьДанные();
	
	УстановитьВидимость();
	УстановитьДоступность();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанные()
	
	Для Каждого ТекущаяОперация Из СписокОпераций Цикл
		
		Если ТекущаяОперация.Значение = "ЗакрытиеСменыАдминистратораГостиницы" Тогда
			
			ЗаполнитьДанныеЗакрытияСменыГостиницы();
		
		КонецЕсли;
		
		Если ТекущаяОперация.Значение = "ОтчетОРозничныхПродажах" Тогда
			
			ЗаполнитьДанныеОтчетаОРозничныхПродажах();
			
		КонецЕсли;
		
		Если ТекущаяОперация.Значение = "ЗакрытиеКассовойСмены" Тогда
			
			ЗаполнитьДанныеКассовойСмены();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#Область ЗакрытиеСменыГостиницы

&НаСервере
Процедура ЗаполнитьДанныеЗакрытияСменыГостиницы()
	
	ЗаполнитьДанныеПоЗанятымНомерамГостиницы();
	ЗаполнитьДанныеПоНезакрытымДокументамГостиницы();
	ЗаполнитьДанныеПоВыселениямИзГостиницы();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоЗанятымНомерамГостиницы()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Объект.КонецСмены);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ГостиничныйКорпус", Объект.ГостиничныйКорпус);
	Запрос.Текст = "ВЫБРАТЬ
	|	СостояниеНомеровСрезПоследних.ГостиничныйНомер,
	|	СостояниеНомеровСрезПоследних.Состояние,
	|	МАКСИМУМ(СостояниеНомеровСрезПоследних.ДатаЗаселения) КАК Дата,
	|	СостояниеНомеровСрезПоследних.ДатаВыселения
	|ИЗ
	|	РегистрСведений.СостояниеНомеров.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ГостиничныйНомер.Владелец = &ГостиничныйКорпус) КАК СостояниеНомеровСрезПоследних
	|ГДЕ
	|	СостояниеНомеровСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Завершен)
	|	И СостояниеНомеровСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Свободен)
	|	И &Период МЕЖДУ СостояниеНомеровСрезПоследних.ДатаЗаселения И СостояниеНомеровСрезПоследних.ДатаВыселения
	|
	|СГРУППИРОВАТЬ ПО
	|	СостояниеНомеровСрезПоследних.ДатаВыселения,
	|	СостояниеНомеровСрезПоследних.ГостиничныйНомер,
	|	СостояниеНомеровСрезПоследних.Состояние";
	
	Объект.ЗанятыеНомераГостиницы.Очистить();
	Объект.ЗанятыеНомераГостиницы.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоНезакрытымДокументамГостиницы()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Объект.КонецСмены);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ГостиничныйКорпус", Объект.ГостиничныйКорпус);
	Запрос.Текст = "ВЫБРАТЬ
	|	СостояниеНомеровСрезПоследних.ГостиничныйНомер,
	|	СостояниеНомеровСрезПоследних.Состояние,
	|	МАКСИМУМ(СостояниеНомеровСрезПоследних.ДатаЗаселения) КАК Дата,
	|	СостояниеНомеровСрезПоследних.ДатаВыселения,
	|	СостояниеНомеровСрезПоследних.Регистратор КАК Документ
	|ИЗ
	|	РегистрСведений.СостояниеНомеров.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ГостиничныйНомер.Владелец = &ГостиничныйКорпус) КАК СостояниеНомеровСрезПоследних
	|ГДЕ
	|	СостояниеНомеровСрезПоследних.ДатаВыселения < &Период
	|	И СостояниеНомеровСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Завершен)
	|	И СостояниеНомеровСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Свободен)
	|
	|СГРУППИРОВАТЬ ПО
	|	СостояниеНомеровСрезПоследних.ДатаВыселения,
	|	СостояниеНомеровСрезПоследних.ГостиничныйНомер,
	|	СостояниеНомеровСрезПоследних.Состояние,
	|	СостояниеНомеровСрезПоследних.Регистратор";
	
	Объект.НезакрытыеДокументыГостиницы.Очистить();
	Объект.НезакрытыеДокументыГостиницы.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоВыселениямИзГостиницы()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ГостиничныйКорпус", Объект.ГостиничныйКорпус);
	Запрос.УстановитьПараметр("НачалоСмены", Объект.НачалоСмены);
	Запрос.УстановитьПараметр("КонецСмены", Объект.КонецСмены);
	Запрос.Текст = "ВЫБРАТЬ
	|	Выселение.ГостиничныйНомер,
	|	Выселение.Ссылка КАК Документ,
	|	СУММА(ОстаткиЗадолженности.Задолженность) КАК Задолженность
	|ИЗ
	|	Документ.Выселение КАК Выселение
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВзаиморасчетыЗаПроживаниеОстатки.ДокументРасчетов КАК ДокументРасчетов,
	|			ВзаиморасчетыЗаПроживаниеОстатки.СуммаОстаток КАК Задолженность
	|		ИЗ
	|			РегистрНакопления.ВзаиморасчетыЗаПроживание.Остатки(&КонецСмены, ) КАК ВзаиморасчетыЗаПроживаниеОстатки
	|		ГДЕ
	|			ВзаиморасчетыЗаПроживаниеОстатки.СуммаОстаток > 0) КАК ОстаткиЗадолженности
	|		ПО Выселение.Основание = ОстаткиЗадолженности.ДокументРасчетов
	|ГДЕ
	|	Выселение.Дата МЕЖДУ &НачалоСмены И &КонецСмены
	|	И Выселение.Организация = &Организация
	|	И Выселение.ГостиничныйКорпус = &ГостиничныйКорпус
	|
	|СГРУППИРОВАТЬ ПО
	|	Выселение.Ссылка,
	|	Выселение.ГостиничныйНомер";
	
	Объект.ВыселенияИзГостиницы.Очистить();
	Объект.ВыселенияИзГостиницы.Загрузить(Запрос.Выполнить().Выгрузить()); 
	
КонецПроцедуры

#КонецОбласти

#Область ЗакрытиеОтчетаОРозничныхПродажах

&НаСервере
Процедура ЗаполнитьДанныеОтчетаОРозничныхПродажах()
	
	ЗаполнитьДанныеПоДокументамПродаж();
	ЗаполнитьДанныеПоПроданнымТоварам();
	ЗаполнитьДанныеПоМатериаламПотраченнымНаПродажу();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоДокументамПродаж()
	
	Объект.ДокументыПродаж.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоСмены);
	Запрос.УстановитьПараметр("КонецПериода", Объект.КонецСмены);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ТорговаяТочка", Объект.ТорговаяТочка);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЧекККМ.Ссылка КАК Документ,
	|	ЧекККМ.Сумма,
	|	ЧекККМ.ВидОперации
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ЧекККМ.ТорговаяТочка = &ТорговаяТочка
	|	И ЧекККМ.Организация = &Организация
	|	И ЧекККМ.СтатусДокумента = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Открыт)
	|	И НЕ ЧекККМ.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЧекККМ.Дата";
	
	Объект.ДокументыПродаж.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоПроданнымТоварам()
	
	Объект.ПроданныеТовары.Очистить();
	Объект.РасходМатериалов.Очистить();
	
	Для Каждого ТекущийДокумент Из Объект.ДокументыПродаж Цикл
		
		Для Каждого СтрокаТовара Из ТекущийДокумент.Документ.Товары Цикл
			
			НоваяСтрокаТовара = Объект.ПроданныеТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТовара, СтрокаТовара);
			НоваяСтрокаТовара.ЧекККМ = ТекущийДокумент.Документ;
			
			НоваяСтрокаМатериала = Объект.РасходМатериалов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаМатериала, СтрокаТовара);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоМатериаламПотраченнымНаПродажу()
	
	
	
КонецПроцедуры

#КонецОбласти

#Область ЗакрытиеКассовойСмены

&НаСервере
Процедура ЗаполнитьДанныеКассовойСмены()
	
	ЗаполнитьДанныеПараметрыСмены();
	ЗаполнитьДанныеПоПриходуВКассу();
	ЗаполнитьДанныеПоЭквайрингу();
	ЗаполнитьДанныеПоРасходуИзКассы();
	ЗаполнитьДанныеПоНеоплаченнымДокументамВыселения();
	ПересчитатьПоказателиПоНачалуСмены();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПараметрыСмены()
	
	ПараметрыСмены = УправлениеКассами.ПолучитьСтруктуруДанныхКассыЗаПериод(Объект.НачалоСмены, Объект.КонецСмены, Объект.Организация, Объект.Касса);
	ЗаполнитьЗначенияСвойств(Объект, ПараметрыСмены);
	Объект.НаНачалоФакт = Объект.НаНачало;	
	Объект.НаКонецФакт = Объект.НаКонец;
		
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеПоПриходуВКассу()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоСмены);
	Запрос.УстановитьПараметр("КонецПериода", Объект.КонецСмены);
	Запрос.Текст = "ВЫБРАТЬ
	|	ПриходныйКассовыйОрдер.Ссылка КАК Документ,
	|	ПриходныйКассовыйОрдер.Сумма,
	|	ПриходныйКассовыйОрдер.СтатьяДвижения
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	ПриходныйКассовыйОрдер.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ПриходныйКассовыйОрдер.Проведен";
	
	Объект.КассаПриход.Очистить();
	Объект.КассаПриход.Загрузить(Запрос.Выполнить().Выгрузить());
	//Объект.Приход = Объект.КассаПриход.Итог("Сумма");
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоЭквайрингу()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоСмены);
	Запрос.УстановитьПараметр("КонецПериода", Объект.КонецСмены);
	Запрос.Текст = "ВЫБРАТЬ
	               |	БезналичнаяОплата.Ссылка КАК Документ,
	               |	БезналичнаяОплата.ВидОперации,
	               |	БезналичнаяОплата.Сумма
	               |ИЗ
	               |	Документ.БезналичнаяОплата КАК БезналичнаяОплата
	               |ГДЕ
	               |	БезналичнаяОплата.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И БезналичнаяОплата.Проведен";
	
	Объект.Эквайринг.Очистить();
	Объект.Эквайринг.Загрузить(Запрос.Выполнить().Выгрузить());
	//Объект.Приход = Объект.КассаПриход.Итог("Сумма");
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоРасходуИзКассы()
	
	Запрос = Новый Запрос;
	ЗАпрос.УстановитьПараметр("НачалоПериода",ОБъект.НачалоСмены);
	Запрос.УстановитьПараметр("КонецПериода",Объект.КонецСмены);
	Запрос.Текст = "ВЫБРАТЬ
	|	РасходныйКассовыйОрдер.Ссылка КАК Документ,
	|	РасходныйКассовыйОрдер.Сумма,
	|	РасходныйКассовыйОрдер.СтатьяДвижения
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|ГДЕ
	|	РасходныйКассовыйОрдер.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И РасходныйКассовыйОрдер.Проведен";
	
	Объект.КассаРасход.Очистить();
	Объект.КассаРасход.Загрузить(Запрос.Выполнить().Выгрузить());
	//Объект.Расход = Объект.КассаРасход.Итог("Сумма");
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоНеоплаченнымДокументамВыселения()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Заселение.ГостиничныйНомер,
	               |	Заселение.Ссылка КАК ДокументРасчетов,
	               |	Заселение.Сумма
	               |ИЗ
	               |	Документ.Заселение КАК Заселение
	               |ГДЕ
	               |	Заселение.Сумма < 0";
	
	Объект.НеоплаченныеДокументыПроживания.Очистить();
	Объект.НеоплаченныеДокументыПроживания.Загрузить(Запрос.Выполнить().Выгрузить());
		
КонецПроцедуры

&НаСервере
Функция ЗакончитьЗакрытиеСмен(ДокументГостиницы, ДокументКассы, ДокументПродажи)
	
	//Создание документов	
	ЗакрытиеСменыГостиницы = Документы.ЗакрытиеСменыАдминистратораГостиницы.СоздатьДокумент();
	ЗакрытиеСменыКассы = Документы.ЗакрытиеКассовойСмены.СоздатьДокумент();
	ОтчетОРозничныхПродажах = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();
	
	//ЗаполнениеРеквизитовДокументов
	
	//Закрытие смены Гостиницы
	ЗакрытиеСменыГостиницы.Дата = ТекущаяДата();
	ЗаполнитьЗначенияСвойств(ЗакрытиеСменыГостиницы, Объект);
	ЗакрытиеСменыГостиницы.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт;
	ЗакрытиеСменыГостиницы.Ответственный = Объект.СменуСдал;
	ЗакрытиеСменыГостиницы.Выселения.Загрузить(Объект.ВыселенияИзГостиницы.Выгрузить());
	ЗакрытиеСменыГостиницы.НезакрытыеДокументы.Загрузить(Объект.НеоплаченныеДокументыПроживания.Выгрузить());
	ЗакрытиеСменыГостиницы.ЗанятыеНомера.Загрузить(Объект.ЗанятыеНомераГостиницы.Выгрузить());
	ЗакрытиеСменыГостиницы.Ответственный = Объект.СменуСдал;
	ЗакрытиеСменыГостиницы.Записать(РежимЗаписиДокумента.Проведение);	
	ДокументГостиницы = ЗакрытиеСменыГостиницы.Ссылка;
	
	//Закрытие кассовой смены
	ЗакрытиеСменыКассы.Дата = ТекущаяДата();
	ЗаполнитьЗначенияСвойств(ЗакрытиеСменыКассы, Объект);	
	ЗакрытиеСменыКассы.Ответственный = Объект.СменуСдал;
	ЗакрытиеСменыКассы.ДокументыПрихода.Загрузить(Объект.КассаПриход.Выгрузить());
	ЗакрытиеСменыКассы.ДокументыРасхода.Загрузить(Объект.КассаРасход.Выгрузить());
    ЗакрытиеСменыКассы.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт; 
	ЗакрытиеСменыКассы.Ответственный = Объект.СменуСдал;
	ЗакрытиеСменыКассы.Записать(РежимЗаписиДокумента.Проведение);
	ДокументКассы = ЗакрытиеСменыКассы.Ссылка;
	
	
	//Отчет о розничных продажах
	ОтчетОРозничныхПродажах.Дата = ТекущаяДата();
	ЗаполнитьЗначенияСвойств(ОтчетОРозничныхПродажах, Объект);
	ОтчетОРозничныхПродажах.Продавец = Объект.СменуСдал;
	ОтчетОРозничныхПродажах.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт;  	
	ОтчетОРозничныхПродажах.Документы.Загрузить(Объект.ДокументыПродаж.Выгрузить());
	ОтчетОРозничныхПродажах.Материалы.Загрузить(Объект.РасходМатериалов.Выгрузить());
	ОтчетОРозничныхПродажах.Товары.Загрузить(Объект.ПроданныеТовары.Выгрузить());
	ОтчетОРозничныхПродажах.Записать(РежимЗаписиДокумента.Проведение);
	ДокументПродажи = ОтчетОРозничныхПродажах.Ссылка;
	
КонецФункции


#КонецОбласти

&НаСервере
Функция ПроверкаПройдена()
	
	Результат = Истина;
	
	ТекущаяОперация = СписокОпераций[Объект.ТекущаяОперация].Значение;
	
	// Проверяем общие реквизиты
	
	Если Не ЗначениеЗаполнено(Объект.СменуПринял) Тогда
		
		Сообщить("Не заполнено поле 'Cмену принял'" , СтатусСообщения.ОченьВажное);	
		
		КонецЕсли;
	
	// Проверяем реквизиты страниц
	Если ТекущаяОперация = "ЗакрытиеСменыАдминистратораГостиницы" Тогда
		
		Результат = ПроверкаЗакрытияСменыАдминистратораГостиницыПройдена();
		
	ИначеЕсли ТекущаяОперация = "ОтчетОРозничныхПродажах" Тогда
		
		Результат = ПроверкаОтчетаОРозничныхПродажахПройдена();
		
	ИначеЕсли ТекущаяОперация = "ЗакрытиеКассовойСмены" Тогда
		
		Результат = ПроверкаЗакрытияКассовойСменыПройдена();		
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПроверкаЗакрытияСменыАдминистратораГостиницыПройдена()
	
	Результат = Истина;
	
	Если Объект.НезакрытыеДокументыГостиницы.Количество() > 0 Тогда
		
		Результат = Ложь;
		Для Каждого ТекущаяСтрока Из Объект.НезакрытыеДокументыГостиницы Цикл
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ необходимо продлить или закрыть!",, "Объект.НезакрытыеДокументыГостиницы[" + Строка(ТекущаяСтрока.НомерСтроки - 1) + "].Документ");
			
		КонецЦикла;			
		
	КонецЕсли;
	
	Если Объект.ВыселенияИзГостиницы.Итог("Задолженность") <> 0 Тогда
		
		Результат = Ложь;
		Для Каждого ТекущаяСтрока Из Объект.ВыселенияИзГостиницы Цикл
			
			Если ТекущаяСтрока.Задолженность <> 0 Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неоплачен документ выселения!", ,"Объект.ВыселенияИзГостиницы[" + Строка(ТекущаяСтрока.НомерСтроки - 1) + "].Документ",, Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПроверкаОтчетаОРозничныхПродажахПройдена()
	
	Результат = Истина;
	
	
	Если Объект.ДокументыПродаж.Итог("Сумма") <> Объект.ПроданныеТовары.Итог("Сумма") Тогда
		
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документы продажи заполнены неверно!",, "Объект.ДокументыПродаж");			
		
	КонецЕсли;
	
	Возврат Результат;
	
	
КонецФункции

&НаСервере
Функция ПроверкаЗакрытияКассовойСменыПройдена()	
	
	Результат = Истина;
	
	
	Если Объект.НеоплаченныеДокументыПроживания.Количество() > 0 Тогда
		
		Результат = Ложь;
		Для Каждого ТекущаяСтрока Из Объект.НеоплаченныеДокументыПроживания Цикл
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ необходимо продлить или закрыть!",, "Объект.НеоплаченныеДокументыПроживания[" + Строка(ТекущаяСтрока.НомерСтроки - 1) + "].Документ");
			
		КонецЦикла;			
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


