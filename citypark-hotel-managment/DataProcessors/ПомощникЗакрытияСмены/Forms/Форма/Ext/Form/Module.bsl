Процедура НезакрытыеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтрока = Объект.НезакрытыеДокументыГостиницы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ПараметрыОткрытия = Новый Структура("Ключ", ТекСтрока.Документ);
	
	Если ТипЗнч(ТекСтрока.Документ) = Тип("ДокументСсылка.Бронирование") Тогда
		
		ОткрытьФорму("Документ.Бронирование.ФормаОбъекта", ПараметрыОткрытия);
		
	ИначеЕсли ТипЗнч(ТекСтрока.Документ) = Тип("ДокументСсылка.Заселение") Тогда
		
		ОткрытьФорму("Документ.Заселение.ФормаОбъекта", ПараметрыОткрытия);
		
	КонецЕсли;
	
