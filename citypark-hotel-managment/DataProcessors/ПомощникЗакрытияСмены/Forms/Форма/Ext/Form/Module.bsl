&НаКлиенте
Процедура КомандаДалее(Команда)	
	
	Если Объект.ТекущаяОперация < СписокОпераций.Количество() - 1 И ПроверкаПройдена() Тогда
		
		Объект.ТекущаяОперация = Объект.ТекущаяОперация + 1;
		УстановитьВидимость();
		УстановитьДоступность();
		
	ИначеЕсли Объект.ТекущаяОперация = СписокОпераций.Количество() - 1 Тогда
		
		ДокументГостиницы = Неопределено;
		ДокументКассы = Неопределено;
		ДокументПродажи = Неопределено;
		
		ЗакончитьЗакрытиеСмен(ДокументГостиницы, ДокументКассы, ДокументПродажи);
		
		// Печать документов через подсистему чековых принтеров		
		
		Если ДокументГостиницы <> Неопределено и ДокументКассы <> Неопределено и ДокументПродажи <> Неопределено  Тогда
			
			//Гостиница
			ОповещениеОПечатиЧека = Новый  ОписаниеОповещения("ЧекРаспечатан", ЭтаФорма);
			ПараметрыПечати = Новый Структура;
			ПараметрыПечати.Вставить("Документ", ДокументГостиницы);						
			МенеджерОборудованияУправлениеГостиницейКлиент.НачатьПечатьЗакрытиеСменыГостиницы(ОповещениеОПечатиЧека, УникальныйИдентификатор, ПараметрыПечати);
			
			//Касса
			ОповещениеОПечатиЧека = Новый  ОписаниеОповещения("ЧекРаспечатан", ЭтаФорма);
			ПараметрыПечати = Новый Структура;
			ПараметрыПечати.Вставить("Документ", ДокументКассы);						
			МенеджерОборудованияУправлениеГостиницейКлиент.НачатьПечатьЗакрытиеСменыКассы(ОповещениеОПечатиЧека, УникальныйИдентификатор, ПараметрыПечати);
			
			//ОтчетОРозничныхПродажах
			ОповещениеОПечатиЧека = Новый  ОписаниеОповещения("ЧекРаспечатан", ЭтаФорма);
			ПараметрыПечати = Новый Структура;
			ПараметрыПечати.Вставить("Документ", ДокументПродажи);						
			МенеджерОборудованияУправлениеГостиницейКлиент.НачатьПечатьОтчетаОРозничныхПродажах(ОповещениеОПечатиЧека, УникальныйИдентификатор, ПараметрыПечати);
			
			ЭтаФорма.Закрыть();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

