&НаКлиенте
Процедура ОткрытьНовоеЗаселение(Дата, ВыбранныйНомер)
	
	Оповещение = Новый ОписаниеОповещения("ФормаДокументаЗакрыта", ЭтаФорма);
	ТекНомер = ВыбранныйНомер;
	ПараметрыЗаполнения = ПолучитьСтруктуруНовогоОбъекта(Дата, ТекНомер);
	ОткрытьФорму("Документ.Заселение.Форма.ФормаДокумента", ПараметрыЗаполнения,,,,, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНовоеБронирование(Дата, ВыбранныйНомер)
	
	ВтораяПоловинаДня = ?(Дата >= НачалоДня(Дата) + 12* 60*60, Истина, Ложь);
	
	Если ВтораяПоловинаДня Тогда
		Дата = НачалоДня(Дата) + 12 * 60 * 60;
	Иначе
		Дата = НачалоДня(Дата) - 12 * 60 * 60;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ФормаДокументаЗакрыта", ЭтаФорма);	
	ТекНомер = ВыбранныйНомер;
