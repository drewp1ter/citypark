&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначения.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Объект.НачалоПериода = НачалоДня(ТекущаяДата());
	Объект.КонецПериода = КонецДня(ТекущаяДата() + 86400*7);
	Объект.Корпус = ЗаполнениеДокументов.ПолучитьЗначениеПользователяПоУмолчанию("ОсновнойГостиничныйКорпус");
	Объект.Организация = ЗаполнениеДокументов.ПолучитьЗначениеПользователяПоУмолчанию("ОсновнаяОрганизация");
	
	ОбновитьДанныеИнтерфейса();
	
КонецПроцедуры


