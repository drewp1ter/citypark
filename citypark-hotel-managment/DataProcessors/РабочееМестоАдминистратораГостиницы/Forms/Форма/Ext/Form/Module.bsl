&НаКлиенте
Процедура РезультатДиаграммаВыбор(Элемент, Значения, СтандартнаяОбработка, Дата)
			
	// Выбрано пересечение точки с документом. Выбираем номер открываем документ
	Если ТипЗнч(Значения) = ТипЗнч(Новый Массив) Тогда
		
		ТекНомер = Значения[0].Точка.Значение;		 
		СтруктураДанных = ВыбратьДокументПоДаннымДиаграммыНаСервере(Дата, ТекНомер);		 		
		
		Оповещение = Новый ОписаниеОповещения("ФормаДокументаЗакрыта", ЭтаФорма);
		
		Если ТипЗнч(СтруктураДанных.Ключ) = Тип("ДокументСсылка.Выселение") Тогда			
			
			ОткрытьФорму("Документ.Выселение.ФормаОбъекта", СтруктураДанных,,,,, Оповещение);
			
		ИначеЕсли ТипЗнч(СтруктураДанных.Ключ) = Тип("ДокументСсылка.Бронирование") Тогда			
			
			ОткрытьФорму("Документ.Бронирование.ФормаОбъекта", СтруктураДанных,,,,, Оповещение);
			
		ИначеЕсли ТипЗнч(СтруктураДанных.Ключ) = Тип("ДокументСсылка.ОтменаБронирования") Тогда			
			
			ОткрытьФорму("Документ.ОтменаБронирования.ФормаОбъекта", СтруктураДанных,,,,, Оповещение);
			
		Иначе
			
		    ОткрытьФорму("Документ.Заселение.ФормаОбъекта", СтруктураДанных,,,,, Оповещение);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Выбрано пустое поле диаграммы. Выбираем номер и создаем документ
	Если ТипЗнч(Значения) = Тип("ЗначениеДиаграммыГанта") Тогда
		
		СерединаТекущегоДня = НачалоДня(ТекущаяДата()) + 12* 60*60;
		
		Если УправлениеЗаселением.РазностьДат(Дата, СерединаТекущегоДня) > 1 Тогда
			ОткрытьНовоеБронирование(Дата, Значения.Точка.Значение);
		Иначе
			ОткрытьНовоеЗаселение(Дата, Значения.Точка.Значение);
		КонецЕсли;
		
	КонецЕсли;
	
	// Пользователь кликнул по номеру. Выбираем номер и создаем документ
	Если ТипЗнч(Значения) = Тип("ТочкаДиаграммыГанта") Тогда
		                                                  		
		//ОткрытьНовоеЗаселение(Дата, Значения.Значение);
		ТекНомер = Значения.Значение;
		Если НЕ НомерУбран(ТекНомер) Тогда
			ПараметрыЗаполнения = ПолучитьСтруктуруНового(ТекНомер);	
			Оповещение = Новый ОписаниеОповещения("ФормаДокументаЗакрыта", ЭтаФорма);	
			ОткрытьФорму("Документ.УборкаНомера.Форма.ФормаДокумента", ПараметрыЗаполнения,,,,, Оповещение);
		КонецЕсли;
				
	КонецЕсли;
		
КонецПроцедуры


&НаСервере
Функция ПолучитьСтруктуруНового(ВыбранныйНомер)
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ГостиничныйНомер", ВыбранныйНомер);

		
	Структура = Новый Структура;
	Структура.Вставить("ЗначенияЗаполнения", ПараметрыЗаполнения);
		
	Возврат Структура;
	
КонецФункции


