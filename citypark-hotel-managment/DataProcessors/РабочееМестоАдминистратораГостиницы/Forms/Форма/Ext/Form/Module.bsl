&НаСервере
Процедура ЗаполнитьДиаграмму()

	Если Объект.СортировкаГрафикаЗаселений = 1 Тогда
		
		ЗаполнитьДиаграммуПоАлфавиту();
		
	ИначеЕсли Объект.СортировкаГрафикаЗаселений = 0 Тогда
		
		ЗаполнитьДиаграммуПоТипамНомеров();
		
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДиаграммуПоАлфавиту()
	
	Если Объект.КонецПериода > Объект.НачалоПериода Тогда
		
		РезультатДиаграмма.Очистить();
		РезультатДиаграмма.АвтоОпределениеПолногоИнтервала = Ложь;
		РезультатДиаграмма.УстановитьПолныйИнтервал(Объект.НачалоПериода, Объект.КонецПериода + 86400); 
		
		РезультатДиаграмма.ОтображатьЛегенду = Ложь;
		РезультатДиаграмма.ОтображатьЗаголовок = Ложь;
		РезультатДиаграмма.ОбластьПостроения.Право = 1;
		
		Серия = РезультатДиаграмма.Серии.Добавить();
		Серия.Текст = "Бронирование";
		
		РезультатДиаграмма.Обновление = Ложь; 		
		
		Запрос = Новый Запрос;
		Запрос.Параметры.Вставить("ДатаСреза", ТекущаяДата());
		Запрос.Параметры.Вставить("НачалоПериода", Объект.НачалоПериода - 86400);
		Запрос.Параметры.Вставить("КонецПериода", Объект.КонецПериода + 5184000);	
		Запрос.Параметры.Вставить("Организация", Объект.Организация);
		Запрос.Параметры.Вставить("ГостиничныйКорпус", Объект.Корпус);	
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ГостиничныеНомера.Ссылка КАК ГостиничныйНомер,
		               |	СостояниеНомеровСрезПоследних.ДатаЗаселения КАК ДатаЗаселения,
		               |	СостояниеНомеровСрезПоследних.Состояние КАК Состояние,
		               |	СостояниеНомеровСрезПоследних.ДатаВыселения
		               |ИЗ
		               |	Справочник.ГостиничныеНомера КАК ГостиничныеНомера
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеНомеров.СрезПоследних(
		               |				&ДатаСреза,
		               |				Организация = &Организация
		               |					И ГостиничныйНомер.Владелец = &ГостиничныйКорпус
		               |					И (ДатаЗаселения МЕЖДУ &НачалоПериода И &КонецПериода
		               |						ИЛИ ДатаВыселения МЕЖДУ &НачалоПериода И &КонецПериода)
		               |					И Состояние <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Свободен)) КАК СостояниеНомеровСрезПоследних
		               |		ПО ГостиничныеНомера.Ссылка = СостояниеНомеровСрезПоследних.ГостиничныйНомер
		               |ГДЕ
		               |	НЕ ГостиничныеНомера.ПометкаУдаления
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ГостиничныйНомер,
		               |	ДатаЗаселения
		               |ИТОГИ ПО
		               |	ГостиничныйНомер";
		
		ДеревоДанных = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Для Каждого ТекущийНомер Из ДеревоДанных.Строки Цикл
			
			Точка = РезультатДиаграмма.УстановитьТочку(ТекущийНомер.ГостиничныйНомер);
			
			Если Не НомерУбран(ТекущийНомер.ГостиничныйНомер) Тогда
				Точка.ЦветФона = Новый Цвет(211,165,255);
			КонецЕсли;
			
			Для Каждого ДанныеЗагрузкиНомера Из ТекущийНомер.Строки Цикл
				
				Если ДанныеЗагрузкиНомера.ДатаЗаселения <> Null Тогда
					
					Цвет = Новый Цвет(255,255,255);
					Если ДанныеЗагрузкиНомера.Состояние = Перечисления.ВидыСостоянийНомеров.Завершен Тогда  						
						Цвет = Элементы.ЦветЗавершен.ЦветФона;
					ИначеЕсли ДанныеЗагрузкиНомера.Состояние = Перечисления.ВидыСостоянийНомеров.Занят Тогда
						Цвет = Элементы.ЦветЗанят.ЦветФона;
					ИначеЕсли ДанныеЗагрузкиНомера.Состояние = Перечисления.ВидыСостоянийНомеров.Забронирован Тогда
						Цвет = Элементы.ЦветБронирования.ЦветФона; 
					КонецЕсли; 					
					
					ТекущееЗначение = РезультатДиаграмма.ПолучитьЗначение(Точка, Серия);	
					
					ТекущийИнтервал = ТекущееЗначение.Добавить();
					ТекущийИнтервал.Цвет = Цвет;
					ТекущийИнтервал.Начало = ДанныеЗагрузкиНомера.ДатаЗаселения;
					
					ТекущийИнтервал.Конец = ДанныеЗагрузкиНомера.ДатаВыселения;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;	
			
		РезультатДиаграмма.Обновление = Истина;	  	
		
	Иначе
		
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Окончание периода должно быть больше начала!";
		СообщениеПользователю.ПутьКДанным = "Объект.КонецПериода";
		СообщениеПользователю.Поле = "Объект.КонецПериода";
		СообщениеПользователю.УстановитьДанные(Элементы.КонецПериода);	
		СообщениеПользователю.Сообщить();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция НомерУбран(ГостиничныйНомер)
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	Запрос.УстановитьПараметр("ГостиничныйНомер",ГостиничныйНомер);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УборкаНомеровСрезПоследних.Убран
	               |ИЗ
	               |	РегистрСведений.УборкаНомеров.СрезПоследних(&ТекущаяДата, ГостиничныйНомер = &ГостиничныйНомер) КАК УборкаНомеровСрезПоследних";
				   
				  РезультатЗапроса = Запрос.Выполнить();
				  
				  Если Не РезультатЗапроса.Пустой() Тогда
					  
					 Выборка = РезультатЗапроса.Выбрать();
					 Выборка.Следующий();
					 Результат = Выборка.Убран;					  
				  КонецЕсли;
				  
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДиаграммуПоТипамНомеров()
	
	Если Объект.КонецПериода > Объект.НачалоПериода Тогда
		
		РезультатДиаграмма.Очистить();
		РезультатДиаграмма.АвтоОпределениеПолногоИнтервала = Ложь;	
		РезультатДиаграмма.УстановитьПолныйИнтервал(Объект.НачалоПериода, Объект.КонецПериода + 24*60*60); 
		
		РезультатДиаграмма.ОтображатьЛегенду = Ложь;
		РезультатДиаграмма.ОтображатьЗаголовок = Ложь;
		РезультатДиаграмма.ОбластьПостроения.Право = 1;
		
		Серия = РезультатДиаграмма.Серии.Добавить();
		Серия.Текст = "Бронирование";
		
		РезультатДиаграмма.Обновление = Ложь; 		
		
		Запрос = Новый Запрос;
		Запрос.Параметры.Вставить("ДатаСреза", ТекущаяДата());
		Запрос.Параметры.Вставить("НачалоПериода", Объект.НачалоПериода - 86400);
		Запрос.Параметры.Вставить("КонецПериода", Объект.КонецПериода + 5184000);	
		Запрос.Параметры.Вставить("Организация", Объект.Организация);
		Запрос.Параметры.Вставить("ГостиничныйКорпус", Объект.Корпус);	
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ГостиничныеНомера.ТипНомера КАК ТипНомера,
		               |	ГостиничныеНомера.Ссылка КАК ГостиничныйНомер,
		               |	СостояниеНомеровСрезПоследних.ДатаЗаселения,
		               |	СостояниеНомеровСрезПоследних.Состояние КАК Состояние,
		               |	СостояниеНомеровСрезПоследних.ДатаВыселения
		               |ИЗ
		               |	Справочник.ГостиничныеНомера КАК ГостиничныеНомера
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеНомеров.СрезПоследних(
		               |				&ДатаСреза,
		               |				Организация = &Организация
		               |					И ГостиничныйНомер.Владелец = &ГостиничныйКорпус
		               |					И (ДатаЗаселения МЕЖДУ &НачалоПериода И &КонецПериода
		               |						ИЛИ ДатаВыселения МЕЖДУ &НачалоПериода И &КонецПериода)
		               |					И Состояние <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Свободен)) КАК СостояниеНомеровСрезПоследних
		               |		ПО ГостиничныеНомера.Ссылка = СостояниеНомеровСрезПоследних.ГостиничныйНомер
		               |ГДЕ
		               |	НЕ ГостиничныеНомера.ПометкаУдаления
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ГостиничныйНомер,
		               |	СостояниеНомеровСрезПоследних.ДатаЗаселения
		               |ИТОГИ ПО
		               |	ТипНомера,
		               |	ГостиничныйНомер";
		
		ДеревоДанных = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Для Каждого ТекущийТипНомера Из ДеревоДанных.Строки Цикл
			
			ТочкаГруппа = РезультатДиаграмма.Точки.Добавить();
			ТочкаГруппа.Значение = ТекущийТипНомера.ТипНомера;
			ТочкаГруппа.Текст = ТекущийТипНомера.ТипНомера.Наименование;
			РезультатДиаграмма.РазвернутьТочку(ТочкаГруппа, Истина);
			
			ТочкаГруппа = РезультатДиаграмма.УстановитьТочку(ТекущийТипНомера.ТипНомера);
			
			Для Каждого ТекущийНомер Из ТекущийТипНомера.Строки Цикл
				
				Точка = ТочкаГруппа.Точки.Добавить();
				Точка.Значение = ТекущийНомер.ГостиничныйНомер;
				Точка.Текст = ТекущийНомер.ГостиничныйНомер.Наименование;
				
				Если Не НомерУбран(ТекущийНомер.ГостиничныйНомер) Тогда
					Точка.ЦветФона = Новый Цвет(211,165,255);
				КонецЕсли;

				Для Каждого ДанныеЗагрузкиНомера Из ТекущийНомер.Строки Цикл
					
					Если ДанныеЗагрузкиНомера.ДатаЗаселения <> Null Тогда
						
						Цвет = Новый Цвет(255,255,255);
						Если ДанныеЗагрузкиНомера.Состояние = Перечисления.ВидыСостоянийНомеров.Завершен Тогда  						
							Цвет = Элементы.ЦветЗавершен.ЦветФона;
						ИначеЕсли ДанныеЗагрузкиНомера.Состояние = Перечисления.ВидыСостоянийНомеров.Занят Тогда
							Цвет = Элементы.ЦветЗанят.ЦветФона;
						ИначеЕсли ДанныеЗагрузкиНомера.Состояние = Перечисления.ВидыСостоянийНомеров.Забронирован Тогда
							Цвет = Элементы.ЦветБронирования.ЦветФона; 
						КонецЕсли; 					
						
						ТекущееЗначение = РезультатДиаграмма.ПолучитьЗначение(Точка, Серия);	
						
						ТекущийИнтервал = ТекущееЗначение.Добавить();
						ТекущийИнтервал.Цвет = Цвет;
						ТекущийИнтервал.Начало = ДанныеЗагрузкиНомера.ДатаЗаселения;
						ТекущийИнтервал.Конец = ДанныеЗагрузкиНомера.ДатаВыселения;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
		РезультатДиаграмма.Обновление = Истина;	 
		
	Иначе
		
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Окончание периода должно быть больше начала!";
		СообщениеПользователю.ПутьКДанным = "Объект.КонецПериода";
		СообщениеПользователю.Поле = "Объект.КонецПериода";
		СообщениеПользователю.УстановитьДанные(Элементы.КонецПериода);	
		СообщениеПользователю.Сообщить();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеИнтерфейса()
	
	Элементы.КомандаОрганизация.Заголовок = Объект.Организация.Наименование;
	Элементы.КомандаКорпус.Заголовок = Объект.Корпус.Наименование;
	ЗаполнитьДиаграмму();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруНовогоОбъекта(Дата, ВыбранныйНомер)
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ДатаЗаселения", Дата);
	ПараметрыЗаполнения.Вставить("КоличествоДней", 1);
	ПараметрыЗаполнения.Вставить("ГостиничныйКорпус", ВыбранныйНомер.Владелец);
	ПараметрыЗаполнения.Вставить("ГостиничныйНомер", ВыбранныйНомер);
	ПараметрыЗаполнения.Вставить("Организация", Объект.Организация);
		
	Структура = Новый Структура;
	Структура.Вставить("ЗначенияЗаполнения", ПараметрыЗаполнения);
		
	Возврат Структура;
	
КонецФункции

&НаСервере
Функция ВыбратьДокументПоДаннымДиаграммыНаСервере(ВыбраннаяДата, ВыбранныйНомер)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостояниеНомеров.Регистратор
	|ИЗ
	|	РегистрСведений.СостояниеНомеров.СрезПоследних(
	|			&ДатаСреза,
	|			Организация = &Организация
	|				И ГостиничныйНомер = &ГостиничныйНомер
	|				И ДатаЗаселения <= &ВыбраннаяДата
	|				И ДатаВыселения >= &ВыбраннаяДата) КАК СостояниеНомеров
	|
	|СГРУППИРОВАТЬ ПО
	|	СостояниеНомеров.Регистратор";
	
	Запрос.Параметры.Вставить("ДатаСреза", ТекущаяДата());	
	Запрос.Параметры.Вставить("Организация", Объект.Организация);
	Запрос.Параметры.Вставить("ГостиничныйНомер", ВыбранныйНомер);
	Запрос.Параметры.Вставить("ВыбраннаяДата", ВыбраннаяДата);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		//документ есть	
		Документ = Результат.Выгрузить()[0][0];
		
	Иначе
		ТекНомер = ВыбранныйНомер;
		ПараметрыЗаполнения = ПолучитьСтруктуруНовогоОбъекта(ВыбраннаяДата, ТекНомер);
		
	КонецЕсли;
	
	Структура = Новый Структура("Ключ", Документ);
	
	Возврат Структура;
	
КонецФункции


