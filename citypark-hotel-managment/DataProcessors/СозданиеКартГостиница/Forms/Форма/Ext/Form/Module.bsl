&НаКлиенте
Перем мПроксимити;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(Объект, Параметры);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьКопиюКарты(Команда)
	
	Если мПроксимити.CheckINCopy(ПолучитьИмяНомераТеса(Объект.ГостиничныйНомер), Объект.ДатаВыселения) Тогда
		Сообщить("Карта создана");
	Иначе
		Сообщить("Не удалось создать карту" +мПроксимити.LastError);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьКарту(Команда)
	
	Если мПроксимити.CheckIN(ПолучитьИмяНомераТеса(Объект.ГостиничныйНомер), Объект.ДатаВыселения) Тогда
		//Если мПроксимити.CheckIN("Room1", ТекущаяДата()) Тогда

		Сообщить("Карта создана");
	Иначе
		Сообщить("Не удалось создать карту" + мПроксимити.LastError);
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяНомераТеса(ГостиничныйНомер)
	
	Возврат ГостиничныйНомер._УдалитьИмяВСистемеТеса;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастройкиПроксимити = Новый Структура;
	Если ЕстьНастройкиПроксимити(НастройкиПроксимити) Тогда
		Если ПодключитьВнешнююКомпоненту("AddIn.SorcTessaAbloyConnector") Тогда
			
			мПроксимити = Новый ("AddIn.SorcTessaAbloyConnector"); 		
			мПроксимити.IPServer = НастройкиПроксимити.АдресСервера;
			//мПроксимити.Port = НастройкиПроксимити.Порт;
			
		Иначе
			
			Сообщить("Компонента tesa не подключена");
			
		КонецЕсли;
	КонецЕсли; 	
	
КонецПроцедуры

&НаСервере
Функция ЕстьНастройкиПроксимити(Настройки) 
	
	Настройки = Новый Структура("АдресСервера, Порт", Константы._УдалитьСерверПроксимити.Получить(), Константы._УдалитьПортПроксимити.Получить());
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПриЗакрытии()
	
	мПроксимити = Неопределено;	
	
КонецПроцедуры

