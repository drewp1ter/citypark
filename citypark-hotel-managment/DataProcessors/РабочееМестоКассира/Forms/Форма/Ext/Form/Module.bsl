////////////////////////////////	 БИЗНЕС-ЛОГИКА НА СЕРВЕРЕ   ///////////////////////////////////////////


&НаСервереБезКонтекста
Функция ПолучитьПараметрыЗаполненияДокументаПоШаблону(ШаблонОперации)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ЭтоГруппа", ШаблонОперации.ЭтоГруппа);
	ПараметрыОткрытия.Вставить("ВидДокумента", ?(ШаблонОперации.ВидДокумента = 0, "Приход", "Расход"));	
	
	Если Не ШаблонОперации.ЭтоГруппа Тогда
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("ВидОперации", ШаблонОперации.ВидОперации);
		ЗначенияЗаполнения.Вставить("Контрагент", ШаблонОперации.Контрагент);
		ЗначенияЗаполнения.Вставить("СтатьяДвижения", ШаблонОперации.СтатьяДвижения);
		
		ПараметрыОткрытия.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
	КонецЕсли;	
	
	Возврат ПараметрыОткрытия;
	
КонецФункции


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ ФОРМЫ   		///////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнениеДокументов.ЗаполнитьШапку(Объект);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокДокументов, "Организация", Объект.Организация);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокДокументов, "Касса", Объект.Касса);
	
КонецПроцедуры


