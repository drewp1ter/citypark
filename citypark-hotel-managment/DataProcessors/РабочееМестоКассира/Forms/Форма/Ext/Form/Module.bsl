&НаКлиенте
Процедура СписокШаблоновВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбраннаяСтрока) <> Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		
		ПараметрыОткрытия = ПолучитьПараметрыЗаполненияДокументаПоШаблону(ВыбраннаяСтрока);
		Если Не ПараметрыОткрытия.ЭтоГруппа Тогда
			
			ОповещениеЗакрытия = Новый ОписаниеОповещения("ФормаКассовогоДокументаЗакрыта", ЭтаФорма);
			Если ПараметрыОткрытия.ВидДокумента = "Приход" Тогда
				ОткрытьФорму("Документ.ПриходныйКассовыйОрдер.ФормаОбъекта", ПараметрыОткрытия,,,,, ОповещениеЗакрытия);
			ИначеЕсли ПараметрыОткрытия.ВидДокумента = "Расход" Тогда
				ОткрытьФорму("Документ.РасходныйКассовыйОрдер.ФормаОбъекта", ПараметрыОткрытия,,,,, ОповещениеЗакрытия);				
			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	ОбновитьЗаголовкиИПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовПередНачаломИзменения(Элемент, Отказ)
	
	ОбновитьЗаголовкиИПоказатели();
	
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ ОПОВЕЩЕНИЙ   /////////////////////////////////////////////


&НаКлиенте
Процедура ВыборОрганизацииЗавершен(ВыбраннаяОрганизация, ДополнительныеПараметры) Экспорт
	
	Если ВыбраннаяОрганизация <> Неопределено Тогда
		Объект.Организация = ВыбраннаяОрганизация;
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокДокументов, "Организация", Объект.Организация);
		ОбновитьЗаголовкиИПоказатели();		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборКассыЗавершен(ВыбраннаяКасса, ДополнительныеПараметры) Экспорт
	
	Если ВыбраннаяКасса <> Неопределено Тогда
		Объект.Касса = ВыбраннаяКасса;
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокДокументов, "Касса", Объект.Касса);
		ОбновитьЗаголовкиИПоказатели();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаКассовогоДокументаЗакрыта(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьЗаголовкиИПоказатели();
	
КонецПроцедуры


