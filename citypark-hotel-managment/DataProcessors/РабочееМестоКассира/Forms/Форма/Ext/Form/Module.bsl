///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 БИЗНЕС-ЛОГИКА НА КЛИЕНТЕ   ///////////////////////////////////////////


&НаКлиенте
Процедура ОбновитьЗаголовкиИПоказатели()
	     	
	Элементы.КомандаОрганизация.Заголовок = Объект.Организация;
	Элементы.КомандаКасса.Заголовок = Объект.Касса;
	
	ПараметрыСмены = УправлениеКассами.ПолучитьПараметрыСмены(Объект.Организация, Объект.Касса);
	ДанныеКассы = УправлениеКассами.ПолучитьСтруктуруДанныхКассыЗаПериод(ПараметрыСмены.НачалоСмены, ПараметрыСмены.КонецСмены, Объект.Организация, Объект.Касса);
	
	ЗаполнитьЗначенияСвойств(Объект, ДанныеКассы);
	
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 КОМАНДЫ     //////////////////////////////////////////////////////////


&НаКлиенте
Процедура КомандаПриход(Команда)
	
	ОповещениеЗакрытия = Новый ОписаниеОповещения("ФормаКассовогоДокументаЗакрыта", ЭтаФорма); 	
	ОткрытьФорму("Документ.ПриходныйКассовыйОрдер.ФормаОбъекта",,,,,,ОповещениеЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРасход(Команда)
	
	ОповещениеЗакрытия = Новый ОписаниеОповещения("ФормаКассовогоДокументаЗакрыта", ЭтаФорма); 	
	ОткрытьФорму("Документ.РасходныйКассовыйОрдер.ФормаОбъекта",,,,,, ОповещениеЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВнесениеДС(Команда)
	
	ОповещениеЗакрытия = Новый ОписаниеОповещения("ФормаКассовогоДокументаЗакрыта", ЭтаФорма);			
	ПараметрыОткрытия = ПолучитьПараметрыЗаполненияДокументаПоШаблону(ПредопределенноеЗначение("Справочник.ШаблоныКассовыхОпераций.ВнесениеДенежныхСредств"));
	ОткрытьФорму("Документ.ПриходныйКассовыйОрдер.Форма.ФормаДокумента", ПараметрыОткрытия,,,,, ОповещениеЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаИзъятиеДС(Команда)
	
	ОповещениеЗакрытия = Новый ОписаниеОповещения("ФормаКассовогоДокументаЗакрыта", ЭтаФорма);			
	ПараметрыОткрытия = ПолучитьПараметрыЗаполненияДокументаПоШаблону(ПредопределенноеЗначение("Справочник.ШаблоныКассовыхОпераций.ИзъятиеДенежныхСредств"));
	ОткрытьФорму("Документ.РасходныйКассовыйОрдер.Форма.ФормаДокумента", ПараметрыОткрытия,,,,, ОповещениеЗакрытия);	

КонецПроцедуры

&НаКлиенте
Процедура КомандаОрганизация(Команда)
	
	ОповещениеЗакрытия = Новый ОписаниеОповещения("ВыборОрганизацииЗавершен", ЭтаФорма); 	
	ОткрытьФорму("Справочник.Организации.ФормаВыбора",,,,,,ОповещениеЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаХОтчет(Команда)
	
	ПараметрыСмены = УправлениеКассами.ПолучитьПараметрыСмены(Объект.Организация, Объект.Касса);		
	ОткрытьФорму("Отчет.ДвижениеДенежныхСредств.Форма", ПараметрыСмены);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаКасса(Команда)
	
	ОповещениеЗакрытия = Новый ОписаниеОповещения("ВыборКассыЗавершен", ЭтаФорма); 	
	ОткрытьФорму("Справочник.Кассы.ФормаВыбора",,,,,,ОповещениеЗакрытия);

КонецПроцедуры

&НаКлиенте
Процедура КомандаZОтчет(Команда)
	
	ПараметрыСмены = Новый Структура("Организация, Касса", Объект.Организация, Объект.Касса);	
	ОткрытьФорму("Документ.ЗакрытиеКассовойСмены.ФормаОбъекта", ПараметрыСмены);
	
КонецПроцедуры


