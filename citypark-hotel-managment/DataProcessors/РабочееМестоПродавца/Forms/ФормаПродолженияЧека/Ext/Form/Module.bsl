
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТаблицаЗначений = Параметры.ТаблицаЧеков.Выгрузить();
	ТаблицаЗначений.Свернуть("НомерЗаказа", "Сумма");
	
	СписокЧеков.Загрузить(ТаблицаЗначений);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЧековВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элементы.СписокЧеков.ТекущиеДанные <> Неопределено Тогда
		
		ЭтаФорма.Закрыть(Элементы.СписокЧеков.ТекущиеДанные.НомерЗаказа);
		
	КонецЕсли;
	
КонецПроцедуры
