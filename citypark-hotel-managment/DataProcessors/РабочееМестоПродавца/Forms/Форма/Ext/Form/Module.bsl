&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнениеДокументов.ЗаполнитьШапку(Объект);
	
	Если Объект.ТорговаяТочка.Ассортимент.Количество() > 0 Тогда
		
		МассивДанных = Объект.ТорговаяТочка.Ассортимент.ВыгрузитьКолонку("Номенклатура");
		СписокНоменклатуры.КомпоновщикНастроек.Настройки.Отбор.Элементы[0].ПравоеЗначение = МассивДанных;
		СписокНоменклатуры.КомпоновщикНастроек.Настройки.Отбор.Элементы[0].Использование = Истина;		
		СписокНоменклатуры.КомпоновщикНастроек.Настройки.Отбор.Элементы[1].ПравоеЗначение = Справочники.Номенклатура.ПустаяСсылка();
		СписокНоменклатуры.КомпоновщикНастроек.Настройки.Отбор.Элементы[1].Использование = Истина;
		
	КонецЕсли;
	
		
КонецПроцедуры


