&НаКлиенте
Процедура АктивироватьЧекиККМ()
	
	Если Элементы.ГруппаДокументов.ТекущаяСтраница <> Элементы.ГруппаЧекиККМ Тогда		
		Элементы.СписокЧековККМ.Обновить();
		Элементы.ГруппаДокументов.ТекущаяСтраница = Элементы.ГруппаЧекиККМ;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АктивироватьЗаказ()
	
	Если Элементы.ГруппаДокументов.ТекущаяСтраница <> Элементы.ГруппаЗаказ Тогда
		
		Элементы.ГруппаДокументов.ТекущаяСтраница = Элементы.ГруппаЗаказ;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписи()
	
	Элементы.КомандаОрганизация.Заголовок = Объект.Организация;
	Элементы.КомандаТорговаяТочка.Заголовок = Объект.ТорговаяТочка;
	
	Элементы.КомандаНоваяПродажа.КнопкаПоУмолчанию = ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.Продажа");
	Элементы.КомандаНовыйЗаказВНомер.КнопкаПоУмолчанию = ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.ЗаказВНомер");
	Элементы.КомандаПодарокЗаСчетЗаведения.КнопкаПоУмолчанию = ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.ПодарокЗаСчетЗаведения");
	Элементы.КомандаВключитьВСчетЗаНомер.КнопкаПоУмолчанию = ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.ВключитьВСчетЗаНомер");
	
	Элементы.КомандаОплатить.Заголовок = ?(ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.ПодарокЗаСчетЗаведения") 
								ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.ВключитьВСчетЗаНомер"), "Готово", "Оплатить");
	
	ЭтаФорма.Заголовок = "SORC: Торговая точка. " + ВидОперации + ?(ЗначениеЗаполнено(ГостиничныйНомер), ": " + ГостиничныйНомер, "");
	
	Элементы.ГруппаПодбора.Видимость = Элементы.ГруппаДокументов.ТекущаяСтраница = Элементы.ГруппаЗаказ;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСумму ()
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество;

КонецПроцедуры


