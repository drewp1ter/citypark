&НаКлиенте
Процедура ПользовательВыбралЕдиницуИзмерения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		АктивироватьЗаказ();
		СписокНоменклатурыВыборНаСервере(Результат);
		
		Для Каждого СтрокаТч Из Объект.Товары Цикл
			
			Если СтрокаТч.ЕдиницаИзмерения = Результат Тогда
				Элементы.Товары.ТекущаяСтрока = СтрокаТч.ПолучитьИдентификатор();
				Прервать;
			КонецЕсли;
			
		КонецЦикла; 		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПользовательСовершилОплату(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		Если ДокументыСозданыУспешно(Результат) Тогда
			МассивДок = Новый Массив;
			МассивДок.Добавить(Результат.Чек);
			
			Если ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.Продажа") Тогда
				
				// Печать документов через подсистему чековых принтеров
				ОповещениеОПечатиЧека = Новый  ОписаниеОповещения("ЧекРаспечатан", ЭтаФорма);
				ПараметрыПечати = Новый Структура;
				ПараметрыПечати.Вставить("ЧекККМ", Результат.Чек);						
				МенеджерОборудованияУправлениеГостиницейКлиент.НачатьПечатьЧека(ОповещениеОПечатиЧека, УникальныйИдентификатор, ПараметрыПечати);
				
			КонецЕсли;
			
			ОчиститьПоказателиПродажи();
			АктивироватьЧекиККМ();			
		КонецЕсли;
		ОбновитьНадписи();		
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПользовательВыбралЧекДляПродолжения(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Отбор = Новый Структура("НомерЗаказа", Результат);
		НайденныеПозиции = Объект.ОтложенныеЗаказы.НайтиСтроки(Отбор);
		
		Если Объект.Товары.Количество() > 0 Тогда
			ОтложитьЧекНаСервере();
		КонецЕсли;
		
		Для Каждого СтрокаЗаказа Из НайденныеПозиции Цикл
			
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаказа);
			Объект.ОтложенныеЗаказы.Удалить(СтрокаЗаказа);
			
		КонецЦикла;
		
		НайденныеВидыОпераций = Объект.ВидыОперацийОтложенныхЗаказов.НайтиСтроки(Отбор);
		
		Для Каждого СтрокаВидаОперации Из НайденныеВидыОпераций Цикл
			
			ВидОперации = СтрокаВидаОперации.ВидОперации;
			Объект.ВидыОперацийОтложенныхЗаказов.Удалить(СтрокаВидаОперации);
			
		КонецЦикла;	
		
		АктивироватьЗаказ();
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПользовательВыбралДокументЗаселения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ДокументРасчетов = Результат;
		ГостиничныйНомер = ПолучитьГостиничныйНомерИзДокументаРасчетов();
		АктивироватьЗаказ();
		ОбновитьНадписи();
		
	КонецЕсли;
	
КонецФункции

