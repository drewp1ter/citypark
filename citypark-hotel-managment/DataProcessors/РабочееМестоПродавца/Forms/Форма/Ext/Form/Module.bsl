&НаКлиенте
Процедура КомандаНоваяПродажа(Команда)
	
	ГостиничныйНомер = ПредопределенноеЗначение("Справочник.ГостиничныеНомера.ПустаяСсылка");
	Объект.Товары.Очистить();
	ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.Продажа");
	АктивироватьЗаказ();
	ОбновитьНадписи();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОплатить(Команда)
	
	Если Объект.Товары.Количество() > 0 Тогда
		
		Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.ПодарокЗаСчетЗаведения")
			ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.ВключитьВСчетЗаНомер") Тогда
			
			ДокументыСозданыУспешно(Новый Структура("Наличные, Безналичные", 0, 0));
			ОчиститьПоказателиПродажи();
			АктивироватьЧекиККМ();
			ОбновитьНадписи();
			
		Иначе
			
			КОплате = Объект.Товары.Итог("Сумма");
			
			Если КОплате > 0 Тогда
				
				ОповещениеОбОплате = Новый ОписаниеОповещения("ПользовательСовершилОплату", ЭтаФорма);
				
				ПараметрыОткрытия = Новый Структура;
				ПараметрыОткрытия.Вставить("КОплате", КОплате);
				ПараметрыОткрытия.Вставить("Товары", Объект.Товары);
				ПараметрыОткрытия.Вставить("РазрешенаЧастичнаяОплата", Ложь);
				
				ОткрытьФорму("ОбщаяФорма.ФормаОплаты", ПараметрыОткрытия,,,,, ОповещениеОбОплате);
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ОчиститьПоказателиПродажи();
		АктивироватьЧекиККМ();
		ОбновитьНадписи();
		
	КонецЕсли;
	   
КонецПроцедуры

&НаКлиенте
Процедура КомандаОткрытьКассу(Команда)
	
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтложитьЧек(Команда)
	
	ОтложитьЧекНаСервере();
	АктивироватьЧекиККМ();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПродолжитьЧек(Команда)
	
	ОповещениеОВыбореЧека = Новый ОписаниеОповещения("ПользовательВыбралЧекДляПродолжения", ЭтаФорма);
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ТаблицаЧеков", Объект.ОтложенныеЗаказы);
	ОткрытьФорму("Обработка.РабочееМестоПродавца.Форма.ФормаПродолженияЧека", ПараметрыОткрытия,,,,, ОповещениеОВыбореЧека);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаZОтчет(Команда)
		
	ПараметрыСмены = Новый Структура("Организация, ТорговаяТочка", Объект.Организация, Объект.ТорговаяТочка);	
	ОткрытьФорму("Документ.ОтчетОРозничныхПродажах.ФормаОбъекта", ПараметрыСмены);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаХОтчет(Команда)
	
	ПараметрыСмены = УправлениеПродажами.ПолучитьПараметрыСмены(Объект.Организация, Объект.ТорговаяТочка);	
	ОткрытьФорму("Отчет.Продажи.Форма", ПараметрыСмены);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтменить(Команда)
	
	Объект.Товары.Очистить();
	ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.ПустаяСсылка");
	ГостиничныйНомер = ПредопределенноеЗначение("Справочник.ГостиничныеНомера.ПустаяСсылка");
