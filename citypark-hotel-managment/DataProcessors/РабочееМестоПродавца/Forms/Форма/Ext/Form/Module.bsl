&НаСервере
Процедура СписокНоменклатурыВыборНаСервере(ЕдиницаИзмерения)
	
	ТаблицаЗаказа = Объект.Товары.Выгрузить();
	
	НоваяСтрока = ТаблицаЗаказа.Добавить();
	НоваяСтрока.Номенклатура = ЕдиницаИзмерения.Владелец;
	НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
	НоваяСтрока.Коэффициент = ЕдиницаИзмерения.Коэффициент;
	НоваяСтрока.Количество = 1;
	НоваяСтрока.Цена = Ценообразование.ПолучитьЦенуНоменклатуры(ТекущаяДата(), Объект.Организация, Объект.ТорговаяТочка.ТипЦен, НоваяСтрока.Номенклатура, ЕдиницаИзмерения);
	НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена; 	
	
	ТаблицаЗаказа.Свернуть("Номенклатура, ЕдиницаИзмерения, Коэффициент, Цена", "Количество, Сумма");
	
	Объект.Товары.Загрузить(ТаблицаЗаказа);
	
КонецПроцедуры

&НаСервере
Функция ДокументыСозданыУспешно(ПараметрыОплаты)
	
	Результат = Ложь;
	
	НачатьТранзакцию();
	
	Попытка		
		
		Чек = Документы.ЧекККМ.СоздатьДокумент();			
		ЗаполнениеДокументов.ЗаполнитьОбъект(Чек);
		Чек.ВидОперации = ВидОперации;
		Чек.ГостиничныйНомер = ГостиничныйНомер;
		Чек.Организация = Объект.Организация;
		Чек.ТорговаяТочка = Объект.ТорговаяТочка;
		Чек.ТипЦен = Объект.ТорговаяТочка.ТипЦен;
		Чек.СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;
		Чек.Товары.Загрузить(Объект.Товары.Выгрузить());
		Чек.Основание = ДокументРасчетов;
		Чек.Сумма = Чек.Товары.Итог("Сумма");
		
		Чек.Записать(РежимЗаписиДокумента.Проведение);
		ПараметрыОплаты.Вставить("Чек", Чек.Ссылка);
		
		Если ПараметрыОплаты.Наличные > 0 Тогда
			
			КассовыйЧек = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
			КассовыйЧек.СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;
			ЗаполнениеДокументов.ЗаполнитьОбъект(КассовыйЧек);
			КассовыйЧек.Организация = Объект.Организация;
			КассовыйЧек.ВидОперации = Перечисления.ВидыОперацийПКО.ОплатаЧека;
			КассовыйЧек.Основание = Чек.Ссылка;
			КассовыйЧек.Сумма = ПараметрыОплаты.Наличные;
			КассовыйЧек.Касса = Объект.ТорговаяТочка.Касса;
			КассовыйЧек.СтатьяДвижения = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаЧеков;
			КассовыйЧек.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЕсли;
		
		Если ПараметрыОплаты.Безналичные > 0 Тогда

			БезналичнаяОплата = Документы.БезналичнаяОплата.СоздатьДокумент();
			БезналичнаяОплата.ВидОперации = Перечисления.ВидыОперацийБезналичнойОплаты.ОплатаЧеков;
			ЗаполнениеДокументов.ЗаполнитьОбъект(БезналичнаяОплата);
			БезналичнаяОплата.Организация = Объект.Организация;
			БезналичнаяОплата.Основание = Чек.Ссылка;
			БезналичнаяОплата.Сумма = ПараметрыОплаты.Безналичные;
			БезналичнаяОплата.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
		Результат = Истина;
		
	Исключение
		
		ОтменитьТранзакцию();
		
	КонецПопытки; 	
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОтложитьЧекНаСервере()
	
	НомерОтложенногоДокумента = НомерОтложенногоДокумента + 1;
	
	Сообщить("Чек отложен под № " + НомерОтложенногоДокумента);
	
	Для Каждого СтрокаТч Из Объект.Товары Цикл
		НоваяСтрока = Объект.ОтложенныеЗаказы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТч);
		НоваяСтрока.НомерЗаказа = НомерОтложенногоДокумента;
	КонецЦикла;
	
	НоваяСтрока = Объект.ВидыОперацийОтложенныхЗаказов.Добавить();
	НоваяСтрока.НомерЗаказа = НомерОтложенногоДокумента;
	НоваяСтрока.ВидОперации = ВидОперации;
	
	Объект.Товары.Очистить();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыОткрытияДокументаРасчетов()
	
	Возврат Новый Структура("Организация, ГостиничныйКорпус", Объект.Организация, Объект.ТорговаяТочка.ГостиничныйКорпус);
	
КонецФункции 

&НаСервере
Функция ПолучитьГостиничныйНомерИзДокументаРасчетов()
	
	Возврат ДокументРасчетов.ГостиничныйНомер;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоГруппа(Элемент) 
	
	Возврат Элемент.ЭтоГруппа;
	
КонецФункции

