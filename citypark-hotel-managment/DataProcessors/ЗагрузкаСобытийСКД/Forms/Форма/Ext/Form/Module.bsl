// Функция "расщепляет" строку на подстроки, используя заданный 
//		разделитель. Разделитель может иметь любую длину. 
//		Если в качестве разделителя задан пробел, рядом стоящие пробелы 
//		считаются одним разделителем, а ведущие и хвостовые пробелы параметра Стр
//		игнорируются.
//		Например, 
//		РазложитьСтрокуВМассивПодстрок(",строка 1,,,строка 2", ",") возвратит массив значений из пяти элементов, 
//		три из которых - пустые строки, а 
//		РазложитьСтрокуВМассивПодстрок(" строка1   строка 2", " ") возвратит массив значений из двух элементов
//
//	Параметры: 
//		Стр - 			строка, которую необходимо разложить на подстроки. 
//						Параметр передается по значению.
//		Разделитель - 	строка-разделитель, по умолчанию - запятая.
//
//
//	Возвращаемое значение:
//		массив значений, элементы которого - подстроки
//
Функция РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",")
	
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если ЗначениеЗаполнено(Объект.ПериодНачало) И ЗначениеЗаполнено(Объект.ПериодКонец) И ЗначениеЗаполнено(Объект.ГостиничныйКорпус) Тогда
		
		Если ПодключитьВнешнююКомпоненту("AddIn.SorcLogTesaConnector") Тогда
			
			НастройкиСервера = ПолучитьПараметры();
			
			ЛогТеса = Новый ("AddIn.SorcLogTesaConnector");
			
			ЛогТеса.PathDB = НастройкиСервера.ПутьКБД;
			ЛогТеса.ServerAddress = НастройкиСервера.АдресСервера;
			ЛогТеса.UserDB = НастройкиСервера.Пользователь;
			ЛогТеса.PassDB = НастройкиСервера.Пароль;
			
			Строки = ЛогТеса.LogResult(Формат(Объект.ПериодНачало, "ДФ=dd.MM.yyyy"), Формат(Объект.ПериодКонец, "ДФ=dd.MM.yyyy"));
			СтрокиМассив = Новый Массив;
			Для Каждого ТекСтрока Из Строки Цикл
				
				СтрокиМассив.Добавить(ТекСтрока);	
				
			КонецЦикла;
			
			СформироватьНаСервере(СтрокиМассив);		
			
		Иначе
			
			Сообщить("Компонента log tesa не подключена");
			
		КонецЕсли;
		
	Иначе
		Сообщить("Не все поля заполнены");
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура СформироватьНаСервере(Строки)
	
	Результат.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("НачалоПериода", Объект.ПериодНачало);
	Запрос.Параметры.Вставить("КонецПериода", Объект.ПериодКонец);
	Запрос.Параметры.Вставить("ГостиничныйКорпус", Объект.ГостиничныйКорпус);
	Запрос.Текст = "ВЫБРАТЬ
	               |	СобытияСКД.Дата,
	               |	СобытияСКД.ГостиничныйКорпус,
	               |	СобытияСКД.ГостиничныйНомер,
	               |	СобытияСКД.Пользователь,
	               |	СобытияСКД.Событие
	               |ИЗ
	               |	РегистрСведений.СобытияСКД КАК СобытияСКД
	               |ГДЕ
	               |	СобытияСКД.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И СобытияСКД.ГостиничныйКорпус = &ГостиничныйКорпус";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Менеджер = РегистрыСведений.СобытияСКД.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Менеджер, Выборка);
		Менеджер.Прочитать();
		Менеджер.Удалить();
		
	КонецЦикла;
		
	ОбрОбъект = ДанныеФормыВЗначение(Объект, Тип("ОбработкаОбъект.ЗагрузкаСобытийСКД"));
	Макет = ОбрОбъект.ПолучитьМакет("Макет");
	ТабДок = Новый ТабличныйДокумент;
	
	Область = Макет.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(Область);
	
	Для Каждого ТекСтрока Из Строки Цикл
		Красный = Ложь;
		ТекМассив = РазложитьСтрокуВМассивПодстрок(ТекСтрока, ";;");
		
		Событие = РегистрыСведений.СобытияСКД.СоздатьМенеджерЗаписи();
		Событие.Дата = Дата(Сред(ТекМассив[1], 0, 10) + " " + ТекМассив[2]);
		Событие.ГостиничныйКорпус = Объект.ГостиничныйКорпус;
		Событие.ГостиничныйНомер = УправлениеОборудованием.НайтиДверьПоИмени(Объект.ГостиничныйКорпус, ТекМассив[0]);
		Если Лев(ТекМассив[3], 1) = "_" Тогда
			Длина = СтрДлина(ТекМассив[3]) - 1;
			ТекМассив[3] = "Гость " + УправлениеОборудованием.НайтиДверьПоИмени(Объект.ГостиничныйКорпус, Сред(ТекМассив[3], 2, Длина));
		Иначе
			Если  (ТекМассив[2]>= "00:00:00" и ТекМассив[2]<= "08:00:00") или (ТекМассив[2]>= "20:00:00" и ТекМассив[2]<= "23:59:59") Тогда
				Красный = Истина;				 		
			КонецЕсли;	
		КонецЕсли;
		
		Если Красный Тогда
			Область = Макет.ПолучитьОбласть("СтрокаКрасная");
		Иначе
			Область = Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Событие.Пользователь = ТекМассив[3];
		Событие.Событие = УправлениеОборудованием.ПолучитьСобытиеСКДТесаТекстом(Число(ТекМассив[4]));
		Событие.Записать();
		
		Область.Параметры.Заполнить(Событие);
		ТабДок.Вывести(Область);
		
	КонецЦикла;                   
	
	Результат = ТабДок;
	
КонецПроцедуры

&НаСервере
Функция ВывестиСобытиеТекстом(НомерСобытия)
	
	Событие = НомерСобытия;
	Если НомерСобытия = 76 Тогда
		Событие = "Обновление времени с программатора";	
	ИначеЕсли НомерСобытия = 71 Тогда
		Событие = "Дверь инициализирована";
	ИначеЕсли НомерСобытия = 33 Тогда
		Событие = "Отказ : пользователь не активен";
	ИначеЕсли НомерСобытия = 1 Тогда
		Событие = "Предоставлен доступ";
	ИначеЕсли НомерСобытия = 28 Тогда
		Событие = "Отказ : Ошибка формата карты";
	ИначеЕсли НомерСобытия = 30 Тогда
		Событие = "Отказ : истек срок действия карты";
	ИначеЕсли НомерСобытия = 35 Тогда
		Событие = "Отказ : карта отменена";
	ИначеЕсли НомерСобытия = 5 Тогда
		Событие = "Создана новая карта";		
	ИначеЕсли НомерСобытия = 67	Тогда
		Событие = "Данные двери обновлены с программатора";
	ИначеЕсли НомерСобытия = 4	Тогда
		Событие = "Предоставлен доступ : Новая карта";
	КонецЕсли;	 

	Возврат Событие;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметры()
	
	СтруктураПараметров = Новый Структура();
	
	СтруктураПараметров.Вставить("АдресСервера", Объект.ГостиничныйКорпус.АдресСервера);
	СтруктураПараметров.Вставить("Пользователь", Объект.ГостиничныйКорпус.Пользователь);
	СтруктураПараметров.Вставить("Пароль", Объект.ГостиничныйКорпус.Пароль);
	СтруктураПараметров.Вставить("ПутьКБД", Объект.ГостиничныйКорпус.ПутьКБазеДанных);
	
	Возврат СтруктураПараметров;
	
КонецФункции

&НаСервере
Процедура ОдинГостиничныйКорпус()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГостиничныеКорпуса.Ссылка
	|ИЗ
	|	Справочник.ГостиничныеКорпуса КАК ГостиничныеКорпуса";
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Объект.ГостиничныйКорпус = РезультатЗапроса.Выгрузить()[0][0];
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоКорпусов()
	
	РезультатФункции = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГостиничныеКорпуса.Ссылка
	|ИЗ
	|	Справочник.ГостиничныеКорпуса КАК ГостиничныеКорпуса";
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		
		РезультатФункции = РезультатЗапроса.Выгрузить().Количество();
		
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции


