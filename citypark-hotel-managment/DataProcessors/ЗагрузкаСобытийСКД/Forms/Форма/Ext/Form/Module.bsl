&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПриОткрытииНаСервере();
	
	Объект.ПериодНачало = НачалоМесяца(ТекущаяДата());
	Объект.ПериодКонец = КонецМесяца(ТекущаяДата());	
	
	КоличествоКорпусов = ПолучитьКоличествоКорпусов();
	
	Если КоличествоКорпусов = 1 Тогда
		ОдинГостиничныйКорпус();	
	ИначеЕсли КоличествоКорпусов = 0 Тогда
		Сообщить("Не заданы корпуса");
	КонецЕсли;
	
КонецПроцедуры

