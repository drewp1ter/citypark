	ВТ_Прибыль.Сумма,
	ВТ_Прибыль.Регистратор
ИЗ
	ВТ_Прибыль КАК ВТ_Прибыль

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_Расходы.ВидПоказателя,
	ВТ_Расходы.Детализация1,
	ВТ_Расходы.Сумма,
	ВТ_Расходы.Регистратор
ИЗ
