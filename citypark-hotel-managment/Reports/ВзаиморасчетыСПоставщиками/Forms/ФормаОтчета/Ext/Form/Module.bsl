
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0].Значение = НачалоМесяца(ТекущаяДата());
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0].Использование = Ложь;
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].Значение = КонецМесяца(ТекущаяДата());
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].Использование = Ложь;
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[2].Использование = Ложь;
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[3].Использование = Ложь;

КонецПроцедуры
