
Функция salesgetReport(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
	
	НачалоПериода = Запрос.ПараметрыЗапроса["StartPeriod"];
	КонецПериода = Запрос.ПараметрыЗапроса["EndPeriod"];
	
	Результат = Новый Массив();
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("НачалоПериода", Дата(НачалоПериода));
	Запрос.Параметры.Вставить("КонецПериода", Дата(КонецПериода));
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПродажиОбороты.Организация,
	               |	ПродажиОбороты.ТорговаяТочка,
	               |	ПродажиОбороты.Номенклатура,
	               |	ПродажиОбороты.КоличествоОборот КАК Количество,
	               |	ПродажиОбороты.СуммаОборот КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ПродажиОбороты";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Данные = Запрос.Выполнить().Выгрузить();
	
	Пока Выборка.Следующий() Цикл
		
		ТекСтрока = Новый Структура();
		ТекСтрока.Вставить("Organization", Выборка.Организация.Наименование);
		ТекСтрока.Вставить("TradePlace", Выборка.ТорговаяТочка.Наименование);
		ТекСтрока.Вставить("Product", Выборка.Номенклатура.Наименование);
		ТекСтрока.Вставить("Count", Выборка.Количество);
		ТекСтрока.Вставить("Sum", Выборка.Сумма);
		
		Результат.Добавить(ТекСтрока);
		
	КонецЦикла;

	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Результат);
	СтрокаДляОтвета = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета);
	Возврат Ответ;

КонецФункции

Функция room_salesgetReport(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
	
	StartPeriod = Запрос.ПараметрыЗапроса["StartPeriod"];
	EndPeriod = Запрос.ПараметрыЗапроса["EndPeriod"];
	
	НачалоПериода = Дата(StartPeriod);
	КонецПериода = Дата(EndPeriod);
	Время = Дата("20130724120000");

	ДатаНачало = Дата(Год(НачалоПериода),Месяц(НачалоПериода),День(НачалоПериода),Час(Время),Минута(Время),Секунда(Время));
	ДатаКонец = Дата(Год(КонецПериода),Месяц(КонецПериода),День(КонецПериода),Час(Время),Минута(Время),Секунда(Время));
	
	Результат = Новый Массив();
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("НачалоПериода", ДатаНачало);
	Запрос.Параметры.Вставить("КонецПериода", ДатаКонец);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВзаиморасчетыЗаПроживание.Регистратор.Организация КАК Организация,
	               |	ВзаиморасчетыЗаПроживание.ДокументРасчетов.ГостиничныйНомер КАК ГостиничныйНомер,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВзаиморасчетыЗаПроживание.Период) КАК КоличествоСуток,
	               |	СУММА(ВзаиморасчетыЗаПроживание.Сумма) КАК Сумма,
	               |	ВзаиморасчетыЗаПроживание.ДокументРасчетов.Дата
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыЗаПроживание КАК ВзаиморасчетыЗаПроживание
	               |ГДЕ
	               |	ВзаиморасчетыЗаПроживание.Период МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ВзаиморасчетыЗаПроживание.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВзаиморасчетыЗаПроживание.ДокументРасчетов.ГостиничныйНомер,
	               |	ВзаиморасчетыЗаПроживание.Регистратор.Организация,
	               |	ВзаиморасчетыЗаПроживание.ДокументРасчетов.Дата";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Данные = Запрос.Выполнить().Выгрузить();
	
	Пока Выборка.Следующий() Цикл
		
		ТекСтрока = Новый Структура();
		ТекСтрока.Вставить("Organization", Выборка.Организация.Наименование);
		ТекСтрока.Вставить("Room", Выборка.ГостиничныйНомер.Наименование);
		ТекСтрока.Вставить("Count", Выборка.КоличествоСуток);
		ТекСтрока.Вставить("Sum", Выборка.Сумма);
		
		Результат.Добавить(ТекСтрока);
		
	КонецЦикла;

	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Результат);
	СтрокаДляОтвета = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета);
	Возврат Ответ;
КонецФункции

