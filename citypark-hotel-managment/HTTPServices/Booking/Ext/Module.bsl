Функция availabilityPost(Запрос)
	Возврат Обработать(Запрос, "availability");
КонецФункции

Функция reservationsPost(Запрос)
	Возврат Обработать(Запрос, "create");
КонецФункции

Функция reservationGet(Запрос)
	Возврат Обработать(Запрос, "lookup");
КонецФункции

Функция cancellationGet(Запрос)
	Возврат Обработать(Запрос, "cancellationStatus");
КонецФункции

Функция cancellationPost(Запрос)
	Возврат Обработать(Запрос, "cancel");
КонецФункции

Функция Обработать(Запрос, Операция)
	Попытка
		ОнлайнБронирование.ПроверитьСервисногоПользователя();
		Если Операция = "lookup" Тогда
			Возврат ОтветJSON(200, ОнлайнБронирование.ПолучитьРезультат(Запрос.ПараметрыURL["idempotencyKey"]));
		КонецЕсли;
		Если Операция = "cancellationStatus" Или Операция = "cancel" Тогда
			Возврат ОтветJSON(200, ОнлайнБронирование.ОтменаГостем(
				Запрос.ПараметрыURL["idempotencyKey"], Операция = "cancel"));
		КонецЕсли;
		Тело = Запрос.ПолучитьТелоКакДвоичныеДанные();
		Если Тело = Неопределено Тогда
			ВызватьИсключение "INVALID_REQUEST";
		КонецЕсли;
		Если Тело.Размер() = 0 Или Тело.Размер() > 16384 Тогда
			ВызватьИсключение "INVALID_REQUEST";
		КонецЕсли;
		Попытка
			Данные = ОнлайнБронирование.ПрочитатьСтрокуJSON(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		Исключение
			ВызватьИсключение "INVALID_REQUEST";
		КонецПопытки;
		Если Операция = "availability" Тогда
			Возврат ОтветJSON(200, ОнлайнБронирование.ПроверитьДоступность(Данные));
		КонецЕсли;
		Результат = ОнлайнБронирование.СоздатьБронирование(Данные);
		Возврат ОтветJSON(Результат.Код, Результат.Данные);
	Исключение
		// Не передаём описание исключения: оно может содержать контакты или документы.
		Код = ИнформацияОбОшибке().Описание;
		Ошибки = Новый Соответствие;
		Ошибки.Вставить("INVALID_REQUEST", Новый Структура("Статус,Сообщение", 400, "Проверьте данные бронирования"));
		Ошибки.Вставить("FORBIDDEN", Новый Структура("Статус,Сообщение", 403, "Доступ запрещён"));
		Ошибки.Вставить("RESERVATION_NOT_FOUND", Новый Структура("Статус,Сообщение", 404, "Бронирование не найдено"));
		Ошибки.Вставить("ROOM_UNAVAILABLE", Новый Структура("Статус,Сообщение", 409, "На выбранные даты нет свободного номера"));
		Ошибки.Вставить("IDEMPOTENCY_CONFLICT", Новый Структура("Статус,Сообщение", 409, "Ключ бронирования уже использован с другими данными"));
		Ошибка = Ошибки.Получить(Код);
		Если Ошибка = Неопределено Тогда
			Код = "BOOKING_UNAVAILABLE";
			Ошибка = Новый Структура("Статус,Сообщение", 503, "Бронирование временно недоступно");
		КонецЕсли;
		Возврат ОтветJSON(Ошибка.Статус, Новый Структура("statusCode,code,message", Ошибка.Статус, Код, Ошибка.Сообщение));
	КонецПопытки;
КонецФункции

Функция ОтветJSON(Код, Данные)
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.УстановитьТелоИзСтроки(ОнлайнБронирование.ЗаписатьСтрокуJSON(Данные), КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции
