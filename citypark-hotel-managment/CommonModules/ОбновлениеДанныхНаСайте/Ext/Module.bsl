Процедура ОтметитьИзменениеНомеров() Экспорт
	Если Константы.АвтоматическоеОбновлениеСайта.Получить() Тогда
		Константы.ВерсияСостоянияНомеровДляСайта.Установить(Строка(Новый УникальныйИдентификатор));
	КонецЕсли;
КонецПроцедуры

Процедура ОбновлениеСайта() Экспорт
	Хранилище = Константы.СостояниеПубликацииНомеров.Получить();
	Состояние = Неопределено;
	Если Хранилище <> Неопределено Тогда
		Состояние = Хранилище.Получить();
	КонецЕсли;

	Если Не Константы.АвтоматическоеОбновлениеСайта.Получить() Тогда
		Если Состояние <> Неопределено Тогда
			Константы.СостояниеПубликацииНомеров.Установить(Новый ХранилищеЗначения(Неопределено));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Читаем версию до расчета. Более поздняя запись потребует следующей отправки.
	Версия = Константы.ВерсияСостоянияНомеровДляСайта.Получить();
	Момент = ТекущаяДатаСеанса();
	Если Состояние <> Неопределено Тогда
		Если Состояние.Версия = Версия И Момент >= Состояние.Момент
			И Момент - Состояние.Момент < 60 Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Попытка
		ОтправитьНомера(РассчитатьСвободныеНомера(Момент));
		Константы.СостояниеПубликацииНомеров.Установить(
			Новый ХранилищеЗначения(Новый Структура("Версия,Момент", Версия, Момент)));
	Исключение
		ЗаписьЖурналаРегистрации("Сайт.СвободныеНомера", УровеньЖурналаРегистрации.Ошибка,
			, , "Не удалось опубликовать свободные номера. Повтор при следующем запуске.");
	КонецПопытки;
КонецПроцедуры

Функция РассчитатьСвободныеНомера(Момент)
	Категории = Новый Структура("vip,singleBalcony,single,doubleTwin,doubleEuro",
		"vip", "single-balcony", "single", "double-twin", "double-euro");
	Номера = Новый Массив;
	ПоляНомеров = Новый Соответствие;
	Результат = Новый Структура;
	Для Каждого Категория Из Категории Цикл
		Результат.Вставить(Категория.Ключ, 0);
		Для Каждого Идентификатор Из ОнлайнБронирование.ДопустимыеНомера(Категория.Значение) Цикл
			Номер = Справочники.ГостиничныеНомера.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
			Номера.Добавить(Номер);
			ПоляНомеров.Вставить(Номер, Категория.Ключ);
		КонецЦикла;
	КонецЦикла;

	Организация = Справочники.Организации.НайтиПоКоду("000000001");
	Корпус = Справочники.ГостиничныеКорпуса.НайтиПоКоду("000000001");
	Если Не ЗначениеЗаполнено(Организация) Или Не ЗначениеЗаполнено(Корпус) Тогда
		ВызватьИсключение "Не найдены организация или корпус гостиницы.";
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Номера.Ссылка КАК Номер,
		|	ВЫБОР КОГДА Состояния.ГостиничныйНомер ЕСТЬ NULL ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Свободен
		|ИЗ
		|	Справочник.ГостиничныеНомера КАК Номера
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеНомеров.СрезПоследних(
		|		&Момент, Организация = &Организация И ГостиничныйНомер В (&Номера)
		|			И ДатаЗаселения <= &Момент) КАК Состояния
		|	ПО Номера.Ссылка = Состояния.ГостиничныйНомер
		|		И Состояния.ДатаВыселения >= &Момент
		|		И (Состояния.Состояние = ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Занят)
		|			ИЛИ Состояния.Состояние = ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Забронирован))
		|ГДЕ Номера.Ссылка В (&Номера)
		|	И Номера.Владелец = &Корпус
		|	И НЕ Номера.ПометкаУдаления");
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Корпус", Корпус);
	Запрос.УстановитьПараметр("Номера", Номера);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Свободен Тогда
			Поле = ПоляНомеров.Получить(Выборка.Номер);
			Результат[Поле] = Результат[Поле] + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ОтправитьНомера(Номера)
	Хост = СокрЛП(Константы.ХостПубликацииНомеров.Получить());
	Секрет = Константы.СекретПубликацииНомеров.Получить();
	Если ПустаяСтрока(Хост) Или ПустаяСтрока(Секрет) Тогда
		ЗаписьЖурналаРегистрации("Сайт.СвободныеНомера", УровеньЖурналаРегистрации.Ошибка,
			, , "Заполните хост и секрет публикации номеров.");
		ВызватьИсключение "Не заполнены настройки публикации номеров.";
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("X-Webhook-Secret", Секрет);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Новый Структура("rooms", Номера));
	Запрос = Новый HTTPЗапрос("/api/v1/hotel/rooms", Заголовки);
	Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);
	Соединение = Новый HTTPСоединение(Хост, 443, , , , 10, Новый ЗащищенноеСоединениеOpenSSL);
	Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ЗаписьЖурналаРегистрации("Сайт.СвободныеНомера", УровеньЖурналаРегистрации.Ошибка,
			, , "Ошибка HTTP " + Строка(Ответ.КодСостояния));
		ВызватьИсключение "Сайт отклонил публикацию номеров.";
	КонецЕсли;
КонецПроцедуры
