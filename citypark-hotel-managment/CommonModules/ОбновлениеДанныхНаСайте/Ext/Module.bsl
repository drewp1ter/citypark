Процедура ОбновлениеСайта() Экспорт
	
	Если Константы.АвтоматическоеОбновлениеСайта.Получить() Тогда
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("ДатаСреза", ТекущаяДата());
	Запрос.Параметры.Вставить("ТекущаяДата",ТекущаяДата());
	Запрос.Параметры.Вставить("Организация", Справочники.Организации.НайтиПоКоду("000000001"));
	Запрос.Параметры.Вставить("ГостиничныйКорпус", Справочники.ГостиничныеКорпуса.НайтиПоКоду("000000001"));	
	
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ГостиничныеНомера.ТипНомера КАК ТипНомера,
	               |	ГостиничныеНомера.Ссылка КАК ГостиничныйНомер,
	               |	СостояниеНомеровСрезПоследних.ДатаЗаселения,
	               |	СостояниеНомеровСрезПоследних.Состояние КАК Состояние,
	               |	СостояниеНомеровСрезПоследних.ДатаВыселения
	               |ИЗ
	               |	Справочник.ГостиничныеНомера КАК ГостиничныеНомера
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеНомеров.СрезПоследних(
	               |				&ДатаСреза,
	               |				Организация = &Организация
	               |					И ГостиничныйНомер.Владелец = &ГостиничныйКорпус
	               |					И ДатаЗаселения <= &ТекущаяДата
	               |					И &ТекущаяДата <= ДатаВыселения
	               |					И Состояние <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Свободен)) КАК СостояниеНомеровСрезПоследних
	               |		ПО ГостиничныеНомера.Ссылка = СостояниеНомеровСрезПоследних.ГостиничныйНомер
	               |ГДЕ
	               |	НЕ ГостиничныеНомера.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ГостиничныйНомер,
	               |	СостояниеНомеровСрезПоследних.ДатаЗаселения";
	
	ДеревоДанных = Запрос.Выполнить().Выгрузить();
	
	Одноместный = 2;
	Двухместный = 9;
	Вип = 1;
		
	Для каждого строки из ДеревоДанных Цикл
		
		Если строки.ТипНомера.Ссылка.Код = "000000001" Тогда
			Если строки.Состояние = Перечисления.ВидыСостоянийНомеров.Занят ИЛИ строки.Состояние = Перечисления.ВидыСостоянийНомеров.Забронирован  Тогда	
				Двухместный = Двухместный - 1;
			КонецЕсли;
		ИначеЕсли строки.ТипНомера.Ссылка.Код = "000000002" Тогда
			Если строки.Состояние = Перечисления.ВидыСостоянийНомеров.Занят ИЛИ строки.Состояние = Перечисления.ВидыСостоянийНомеров.Забронирован  Тогда
				Одноместный = Одноместный - 1;
			КонецЕсли;
		ИначеЕсли строки.ТипНомера.Ссылка.Код = "000000003" Тогда
			Если строки.Состояние = Перечисления.ВидыСостоянийНомеров.Занят ИЛИ строки.Состояние = Перечисления.ВидыСостоянийНомеров.Забронирован  Тогда				
				Вип = Вип - 1;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
		
	Логин = "op@cityparkvip.ru";
	Пароль = "1MNA1wmKBX";
	
	Соединение = Новый HTTPСоединение("cityparkvip.ru",443,,,,,
	Новый ЗащищенноеСоединениеOpenSSL());
	
	аЗаголовки = Новый Соответствие;    
	аЗаголовки.Вставить("Content-type", "application/json;charset=utf-8");

	
	аЗаписьJSON = Новый ЗаписьJSON;
	аПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, " ", Истина);  
	аЗаписьJSON.УстановитьСтроку(аПараметрыJSON);   
	   аИнфо         = Новый Структура;  
	аДанные = Новый Структура;
	аДанные.Вставить("email", Логин);
	аДанные.Вставить("password", Пароль);
	аИнфо.Вставить("user", аДанные);
	
	ЗаписатьJSON(аЗаписьJSON, аИнфо);
	strJSON = аЗаписьJSON.Закрыть();
	
	Запрос = Новый HTTPЗапрос("/api/v1/users/sign_in", аЗаголовки);
	Запрос.УстановитьТелоИзСтроки(strJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Результат = Соединение.ВызватьHTTPМетод("POST", Запрос);
	// В куках нам должны вернуть идентификатор сессии.
	Токен = Результат.Заголовки.Получить("Authorization");
	// Он идёт первым параметром и отделён от остальных
	// частей точкой с запятой.
	Токен = СтрЗаменить(Токен, ";", Символы.ПС);
	ИдентификаторСессии1 = СтрПолучитьСтроку(Токен, 1);    
	Заголовки = Новый Соответствие;    
	Заголовки.Вставить("Authorization", ИдентификаторСессии1);
	Заголовки.Вставить("Content-type", "application/json;charset=utf-8");
	
	тЗаписьJSON = Новый ЗаписьJSON;
	тПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, " ", Истина);  
	тЗаписьJSON.УстановитьСтроку(тПараметрыJSON);   
	   Инфо         = Новый Структура;  
	тДанные = Новый Структура;
	тДанные.Вставить("single_rooms", Одноместный);
	тДанные.Вставить("double_rooms", Двухместный);
	тДанные.Вставить("vip_room", Вип);
	Инфо.Вставить("rooms", тДанные);
	

	ЗаписатьJSON(тЗаписьJSON, Инфо);
	strJSON = тЗаписьJSON.Закрыть();
	
	
	Запрос = Новый HTTPЗапрос("/api/v1/hotels", Заголовки);

	Запрос.УстановитьТелоИзСтроки(strJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Ответ = Соединение.ВызватьHTTPМетод("PATCH", Запрос);
	
		
	КонецЕсли;
	
КонецПроцедуры
