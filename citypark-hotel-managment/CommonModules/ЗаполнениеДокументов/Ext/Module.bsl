
// Устарела
&НаСервере 
Процедура ЗаполнитьШапку(ДанныеФормы) Экспорт
	
	Если ДанныеФормы.Свойство("Дата") Тогда
		Если Не ЗначениеЗаполнено(ДанныеФормы.Дата) Тогда
			ДанныеФормы.Дата = ТекущаяДата();
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеФормы.Свойство("Организация") Тогда
		Если Не ЗначениеЗаполнено(ДанныеФормы.Организация) Тогда
			ДанныеФормы.Организация =  ПараметрыСеанса.ТекущийПользователь.ОсновнаяОрганизация;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеФормы.Свойство("Склад") Тогда
		Если Не ЗначениеЗаполнено(ДанныеФормы.Склад) Тогда
			ДанныеФормы.Склад =  ПараметрыСеанса.ТекущийПользователь.ОсновнойСклад;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеФормы.Свойство("Ответственный") Тогда
		Если Не ЗначениеЗаполнено(ДанныеФормы.Ответственный) Тогда
			ДанныеФормы.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
	КонецЕсли;	
			
	Если ДанныеФормы.Свойство("ГостиничныйКорпус") Тогда
		Если Не ЗначениеЗаполнено(ДанныеФормы.ГостиничныйКорпус) Тогда
			ДанныеФормы.ГостиничныйКорпус = ПараметрыСеанса.ТекущийПользователь.ОсновнойГостиничныйКорпус;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеФормы.Свойство("Касса") Тогда
		Если Не ЗначениеЗаполнено(ДанныеФормы.Касса) Тогда
			ДанныеФормы.Касса = ПараметрыСеанса.ТекущийПользователь.ОсновнаяКасса;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеФормы.Свойство("ТорговаяТочка") Тогда
		Если Не ЗначениеЗаполнено(ДанныеФормы.ТорговаяТочка) Тогда
			ДанныеФормы.ТорговаяТочка = ПараметрыСеанса.ТекущийПользователь.ОсновнаяТорговаяТочка;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеФормы.Свойство("СтатусДокумента") Тогда
		Если Не ЗначениеЗаполнено(ДанныеФормы.СтатусДокумента) Тогда
			ДанныеФормы.СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Устарела
&НаСервере
Процедура ЗаполнитьОбъект(ДокументОбъект) Экспорт
	
	ДокументОбъект.Дата = ТекущаяДата();
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("Организация") <> Неопределено Тогда
		ДокументОбъект.Организация = ПараметрыСеанса.ТекущийПользователь.ОсновнаяОрганизация;		
	КонецЕсли;
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("Склад") <> Неопределено Тогда
		ДокументОбъект.Склад = ПараметрыСеанса.ТекущийПользователь.ОсновнойСклад;		
	КонецЕсли;
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("Ответственный") <> Неопределено Тогда
		ДокументОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;		
	КонецЕсли;
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("ГостиничныйКорпус") <> Неопределено Тогда
		ДокументОбъект.ГостиничныйКорпус =  ПараметрыСеанса.ТекущийПользователь.ОсновнойГостиничныйКорпус;		
	КонецЕсли;
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("ТорговаяТочка") <> Неопределено Тогда
		ДокументОбъект.ТорговаяТочка =  ПараметрыСеанса.ТекущийПользователь.ОсновнаяТорговаяТочка;		
	КонецЕсли; 
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("Касса") <> Неопределено Тогда
		ДокументОбъект.Касса =  ПараметрыСеанса.ТекущийПользователь.ОсновнаяКасса;		
	КонецЕсли; 	
	
КонецПроцедуры

// Устарела
&НаСервере
Функция ПолучитьЗначениеПользователяПоУмолчанию(ИмяСвойства) Экспорт
	
	Если ПараметрыСеанса.ТекущийПользователь.Метаданные().Реквизиты.Найти(ИмяСвойства) <> Неопределено Тогда
		Возврат ПараметрыСеанса.ТекущийПользователь[ИмяСвойства];
	КонецЕсли;
	
КонецФункции
