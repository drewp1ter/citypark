&НаСервере
Функция ЕстьНастройкиСчитывателяМагнитныхКартДляЭтогоКомпьютера(Настройки) Экспорт
	
	Настройки = Новый Структура("НомерПорта, Скорость, Четность, БитДанных, СтопБит");
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("РабочаяСтанция", ПараметрыСеанса.РабочаяСтанция);
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкиМагнитныхКартРидеров.РабочаяСтанция,
	               |	НастройкиМагнитныхКартРидеров.НомерПорта,
	               |	НастройкиМагнитныхКартРидеров.Скорость,
	               |	НастройкиМагнитныхКартРидеров.БитДанных,
	               |	НастройкиМагнитныхКартРидеров.Четность,
	               |	НастройкиМагнитныхКартРидеров.СтопБит
	               |ИЗ
	               |	РегистрСведений.НастройкиМагнитныхКартРидеров КАК НастройкиМагнитныхКартРидеров
	               |ГДЕ
	               |	НастройкиМагнитныхКартРидеров.РабочаяСтанция = &РабочаяСтанция";
				   
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(Настройки, Выборка);
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции



&НаСервере
Функция ПолучитьСобытиеСКДТесаТекстом(НомерСобытия)  Экспорт
	
	Событие = НомерСобытия;
	Если НомерСобытия = 76 Тогда
		Событие = "Обновление времени с программатора";	
	ИначеЕсли НомерСобытия = 71 Тогда
		Событие = "Дверь инициализирована";
	ИначеЕсли НомерСобытия = 33 Тогда
		Событие = "Отказ : пользователю запрещен вход";
	ИначеЕсли НомерСобытия = 1 Тогда
		Событие = "Предоставлен доступ";
	ИначеЕсли НомерСобытия = 28 Тогда
		Событие = "Отказ : Ошибка формата карты";
	ИначеЕсли НомерСобытия = 30 Тогда
		Событие = "Отказ : истек срок действия карты";
	ИначеЕсли НомерСобытия = 35 Тогда
		Событие = "Отказ : карта отменена";
	ИначеЕсли НомерСобытия = 5 Тогда
		Событие = "Создана новая карта";		
	ИначеЕсли НомерСобытия = 67	Тогда
		Событие = "Данные двери обновлены с программатора";
	ИначеЕсли НомерСобытия = 4	Тогда
		Событие = "Предоставлен доступ : Использована впервые";
		
	ИначеЕсли НомерСобытия = 8 Тогда
		Событие = "Дверь открыта с программатора";

	ИначеЕсли НомерСобытия = 37 Тогда
		Событие = "Отказ : Попытка входа в запрещенное время";

	ИначеЕсли НомерСобытия = 38 Тогда
		Событие = "Отказ : не настроен режим приватности";

	ИначеЕсли НомерСобытия = 72 Тогда
		Событие = "Power ON Reset";

	ИначеЕсли НомерСобытия = 127 Тогда
		Событие = "Warning : Wandering intruder";

	ИначеЕсли НомерСобытия = 128 Тогда
		Событие = "Warning : Standing intruder";

	КонецЕсли;	 

	Возврат Событие;
	
КонецФункции

&НаСервере
Функция ПолучитьДатуПоследнейЗагрузкиДанныхПоДверям(Дата, Корпус) Экспорт
	
	Результат = ДобавитьМесяц(Дата, -120);
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("Период", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДатаПоследнейЗагрузкиЛогФайлаСрезПоследних.Дата
	               |ИЗ
	               |	РегистрСведений.ДатаПоследнейЗагрузкиЛогФайла.СрезПоследних(&Период, Корпус = &Корпус) КАК ДатаПоследнейЗагрузкиЛогФайлаСрезПоследних";
				   
				   РезультатЗапроса = Запрос.Выполнить();
				   Если Не РезультатЗапроса.Пустой() Тогда
					   Выборка = РезультатЗапроса.Выбрать();
					   Выборка.Следующий();
					   
					   Результат = Выборка.Дата + 1;
					   
				   КонецЕсли;
				   
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НайтиДверьПоИмени(Корпус, ИмяВСКД) Экспорт
	
	Результат = Справочники.ГостиничныеНомера.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("Корпус", Корпус);
	Запрос.Параметры.Вставить("ИмяВСКД", ИмяВСКД);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ГостиничныеНомера.Ссылка
	               |ИЗ
	               |	Справочник.ГостиничныеНомера КАК ГостиничныеНомера
	               |ГДЕ
	               |	ГостиничныеНомера.ИмяВСистемеТеса = &ИмяВСКД
	               |	И ГостиничныеНомера.Владелец = &Корпус";
				   
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

