
Функция ПолучитьПараметрыСмены(Организация, ТорговаяТочка) Экспорт

	Результат = Новый Структура("Организация, ТорговаяТочка, НачалоСмены, КонецСмены", Организация, ТорговаяТочка, ТекущаяДата() - 1, ТекущаяДата());

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТорговаяТочка", ТорговаяТочка);
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЧекККМ.Дата,
	              |	ЧекККМ.Организация,
	              |	ЧекККМ.ТорговаяТочка
	              |ПОМЕСТИТЬ ВТ_ДатыОткрытыхДокументов
	              |ИЗ
	              |	Документ.ЧекККМ КАК ЧекККМ
	              |ГДЕ
	              |	ЧекККМ.СтатусДокумента = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Открыт)
	              |	И НЕ ЧекККМ.ПометкаУдаления
	              |	И ЧекККМ.Организация = &Организация
	              |	И ЧекККМ.ТорговаяТочка = &ТорговаяТочка
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	ВТ_ДатыОткрытыхДокументов.Организация,
	              |	ВТ_ДатыОткрытыхДокументов.ТорговаяТочка,
	              |	МИНИМУМ(ВТ_ДатыОткрытыхДокументов.Дата) КАК НачалоСмены,
	              |	МАКСИМУМ(ВТ_ДатыОткрытыхДокументов.Дата) КАК КонецСмены
	              |ИЗ
	              |	ВТ_ДатыОткрытыхДокументов КАК ВТ_ДатыОткрытыхДокументов
	              |
	              |СГРУППИРОВАТЬ ПО
	              |	ВТ_ДатыОткрытыхДокументов.ТорговаяТочка,
	              |	ВТ_ДатыОткрытыхДокументов.Организация" ;

	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда

		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(Результат, Выборка);

	КонецЕсли;

	Возврат Результат;

КонецФункции