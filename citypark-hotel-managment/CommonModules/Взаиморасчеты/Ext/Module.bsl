
Функция ИспользоватьЭквайринг() Экспорт
	
	Возврат Константы.ИспользоватьЭквайринг.Получить();
	
КонецФункции

Функция ПолучитьДолгЗаПроживание(Регистратор, ДокументРасчетов, СуммаДокумента) Экспорт
	
	Результат = СуммаДокумента;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("ДокументРасчетов", ДокументРасчетов);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ВзаиморасчетыЗаПроживаниеОбороты.СуммаОборот) КАК Сумма,
	               |	ВзаиморасчетыЗаПроживаниеОбороты.Регистратор
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыЗаПроживание.Обороты(, , Регистратор, ДокументРасчетов = &ДокументРасчетов) КАК ВзаиморасчетыЗаПроживаниеОбороты
	               |ГДЕ
	               |	ВзаиморасчетыЗаПроживаниеОбороты.Регистратор <> &Регистратор
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВзаиморасчетыЗаПроживаниеОбороты.Регистратор";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() И СуммаДокумента <> 0 Тогда
		
		ТаблицаОплат = РезультатЗапроса.Выгрузить();
		Результат = ТаблицаОплат.Итог("Сумма") + ?(ЗначениеЗаполнено(Регистратор), СуммаДокумента, 0);
				
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСуммуОплатыЗаПроживание(ДокументРасчетов) Экспорт
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументРасчетов", ДокументРасчетов);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ВзаиморасчетыЗаПроживаниеОбороты.СуммаОборот) КАК Сумма,
	               |	ВзаиморасчетыЗаПроживаниеОбороты.Регистратор
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыЗаПроживание.Обороты(, , Регистратор, ДокументРасчетов = &ДокументРасчетов) КАК ВзаиморасчетыЗаПроживаниеОбороты
	               |ГДЕ
	               |	НЕ ВзаиморасчетыЗаПроживаниеОбороты.Регистратор ССЫЛКА Документ.Заселение
	               |	И НЕ ВзаиморасчетыЗаПроживаниеОбороты.Регистратор ССЫЛКА Документ.Выселение
				   |	И НЕ ВзаиморасчетыЗаПроживаниеОбороты.Регистратор ССЫЛКА Документ.ОтчетОРозничныхПродажах
	               |	И НЕ ВзаиморасчетыЗаПроживаниеОбороты.Регистратор ССЫЛКА Документ.ЧекККМ 	               
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВзаиморасчетыЗаПроживаниеОбороты.Регистратор";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		
		ТаблицаОплат = РезультатЗапроса.Выгрузить();
		Результат = ТаблицаОплат.Итог("Сумма") * (-1);
				
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции