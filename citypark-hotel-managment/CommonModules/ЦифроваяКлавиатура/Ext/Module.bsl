
Функция ПолучитьСтруктуруВводаЧисла() Экспорт
	
	СтруктураВвода = Новый Структура;
	СтруктураВвода.Вставить("НовыйВвод", Истина);
	СтруктураВвода.Вставить("ДробнаяЧасть", Ложь);
	СтруктураВвода.Вставить("ПорядокДроби", 1);
	
	Возврат СтруктураВвода;
	
КонецФункции

// Процедура обработки нажатия цифровой клавиатуры
Процедура ОбработатьНажатиеКнопки(Число, Цифра, СтруктураВвода) Экспорт
	
	Если Цифра = "," Тогда
		
		СтруктураВвода.ДробнаяЧасть = Истина;
		СтруктураВвода.ПорядокДроби = СтруктураВвода.ПорядокДроби * 0.1;
		
	ИначеЕсли Цифра = "<" Тогда
		
		Если СтруктураВвода.ДробнаяЧасть Тогда
			Цч = Цел(Число);
			Дч = Число - Цч;
			Дч = Дч / ?(СтруктураВвода.ПорядокДроби <> 0, СтруктураВвода.ПорядокДроби, 1) / 10 ;
			Дч = Цел(Дч / 10);
			Дч = Дч * СтруктураВвода.ПорядокДроби * 100;
			Число = Цч + Дч;
			СтруктураВвода.ПорядокДроби = СтруктураВвода.ПорядокДроби * 10;
			
			Если СтруктураВвода.ПорядокДроби = 1 Тогда
				СтруктураВвода.ДробнаяЧасть = Ложь;
			КонецЕсли;
			
		Иначе
			Число = Цел(Число / 10);
		КонецЕсли; 
		
	ИначеЕсли Цифра = "Х" Тогда
		
		Число = 0;
		СтруктураВвода.НовыйВвод = Истина;
		СтруктураВвода.ДробнаяЧасть = Ложь;
		СтруктураВвода.ПорядокДроби = 1;
		
	ИначеЕсли Цифра = 0 Тогда
		
		Если Не СтруктураВвода.ДробнаяЧасть Тогда
			Число = Число * 10;
		КонецЕсли; 
		
	ИначеЕсли Цифра = 100 Тогда
		
		Если Не СтруктураВвода.ДробнаяЧасть Тогда
			Число = Число * 100;
		КонецЕсли; 
		
	Иначе
		
		Если СтруктураВвода.НовыйВвод Тогда
			
			Число = ?(СтруктураВвода.ДробнаяЧасть, Цифра * СтруктураВвода.ПорядокДроби, Цифра);
			СтруктураВвода.ПорядокДроби = ?(СтруктураВвода.ДробнаяЧасть, СтруктураВвода.ПорядокДроби * 0.1, СтруктураВвода.ПорядокДроби);
			СтруктураВвода.НовыйВвод = Ложь;
			
		Иначе
			
			Если СтруктураВвода.ДробнаяЧасть Тогда
				Число = Число +  СтруктураВвода.ПорядокДроби * Цифра;
				СтруктураВвода.ПорядокДроби = СтруктураВвода.ПорядокДроби * 0.1;
			Иначе
				Число = 10 * Число + Цифра;
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

// Открывает окно ввода числа
Процедура НачатьВводЧисла(СледующееОповещение) Экспорт
	
	ОткрытьФорму("ОбщаяФорма.ФормаВводаЧисла",,,,,, СледующееОповещение);
	
КонецПроцедуры