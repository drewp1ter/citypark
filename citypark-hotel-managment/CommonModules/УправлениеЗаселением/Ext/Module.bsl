
Функция ИспользоватьСезонныеТарифы() Экспорт
	
	Возврат Константы.ИспользоватьСезонныеТарифы.Получить();
	
КонецФункции

Функция ИспользоватьТарифыПроживания() Экспорт
	
	Возврат Константы.ИспользоватьТарифыПроживания.Получить();
	
КонецФункции

Функция РассчитатьДатуПоТарифу(Дата, Тариф, КоличествоЕдиницПоТарифу) Экспорт
	
	РазмерностьТарифа = 3600 * Тариф.Часов; 	
	
	ДатаВыселения = Дата + КоличествоЕдиницПоТарифу * РазмерностьТарифа;
	
	Если Тариф = Справочники.ТарифыПроживания.Сутки Тогда
		
		ВремяВыселения = Константы.ВремяВыселения.Получить();
		Возврат НачалоДня(ДатаВыселения) + Час(ВремяВыселения) * 3600 + Минута(ВремяВыселения) * 60 + Секунда(ВремяВыселения);
		
	КонецЕсли;
	
	Возврат ДатаВыселения;
	
КонецФункции

Функция РазностьДат(Уменьшаемое, Вычитаемое) Экспорт
	
	Возврат (Уменьшаемое - Вычитаемое)/86400;
	
КонецФункции

Функция РассчитатьКоличествоЕдиницТарифаПоДатам(ДатаЗаселения, ДатаВыселения, Тариф) Экспорт
	
	РазмерностьТарифа = 3600 * Тариф.Часов;
	
	Результат = Окр((ДатаВыселения - ДатаЗаселения) / ?(РазмерностьТарифа <> 0, РазмерностьТарифа, 1));
	
	Если Результат < 0 Тогда
		Результат = 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьИзменениеДатыЗаселения(ВведеннаяДата, СтараяДата) Экспорт
	
	РучнойВвод = ВведеннаяДата - НачалоДня(ВведеннаяДата) <> 0;
	
	Если Не РучнойВвод Тогда
		
		РазностьДат = ВведеннаяДата - СтараяДата;
		РазностьДат = ?(РазностьДат > 0, РазностьДат, РазностьДат * (-1));
		
		// Если больше суток тогда назначаем время по времени заселения
		Если РазностьДат >= 86400 Тогда
			ВведеннаяДата = РассчитатьВремяЗаселения(ВведеннаяДата);
		КонецЕсли;
		
	КонецЕсли;
	
	СтараяДата = ВведеннаяДата;
	
КонецПроцедуры

Функция РассчитатьВремяЗаселения(Дата) Экспорт
	
	ВремяЗаселения = Константы.ВремяЗаселения.Получить();
	
	Возврат НачалоДня(Дата) + Час(ВремяЗаселения) * 3600 + Минута(ВремяЗаселения) * 60 + Секунда(ВремяЗаселения);
		
КонецФункции

Функция ПолучитьДатуИВремяВыселения(Дата, Тариф = Неопределено) Экспорт
	
	ВремяВыселения = Константы.ВремяВыселения.Получить();
	
	Если Не ЗначениеЗаполнено(Тариф) ИЛИ Тариф = Справочники.ТарифыПроживания.Сутки Тогда
		
		Возврат НачалоДня(Дата) + Час(ВремяВыселения) * 3600 + Минута(ВремяВыселения) * 60 + Секунда(ВремяВыселения);
		
	КонецЕсли;
	
	Возврат Дата + Тариф.Часов * 3600;

КонецФункции

Функция НомерСвободенВДанномПериоде(ДатаСреза, ДатаЗаселения, ДатаВыселения, Организация, ГостиничныйНомер, ДокументОснование = Неопределено) Экспорт
	
	Результат = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("ДатаСреза", ДатаСреза);
	Запрос.Параметры.Вставить("ДатаЗаселения", ДатаЗаселения);
	Запрос.Параметры.Вставить("ДатаВыселения", ДатаВыселения - 1);
	Запрос.Параметры.Вставить("Организация", Организация);
	Запрос.Параметры.Вставить("ГостиничныйНомер", ГостиничныйНомер);
	Запрос.Параметры.Вставить("ДокументОснование", ДокументОснование);
	
	Запрос.Текст = "ВЫБРАТЬ
		|	СостояниеНомеровСрезПоследних.Состояние,
		|	СостояниеНомеровСрезПоследних.Регистратор,
		|	СостояниеНомеровСрезПоследних.ДатаЗаселения КАК ДатаЗаселения,
		|	СостояниеНомеровСрезПоследних.ДатаВыселения
		|ИЗ
		|	РегистрСведений.СостояниеНомеров.СрезПоследних(
		|			&ДатаСреза,
		|			Организация = &Организация
		|				И ГостиничныйНомер = &ГостиничныйНомер
		|				И Состояние <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Свободен) %УсловиеОснования%) КАК СостояниеНомеровСрезПоследних
		|ГДЕ
		|	(&ДатаЗаселения МЕЖДУ СостояниеНомеровСрезПоследних.ДатаЗаселения И СостояниеНомеровСрезПоследних.ДатаВыселения
		|			ИЛИ &ДатаВыселения МЕЖДУ СостояниеНомеровСрезПоследних.ДатаЗаселения И СостояниеНомеровСрезПоследних.ДатаВыселения
		|			ИЛИ СостояниеНомеровСрезПоследних.ДатаЗаселения МЕЖДУ &ДатаЗаселения И &ДатаВыселения
		|			ИЛИ СостояниеНомеровСрезПоследних.ДатаВыселения МЕЖДУ &ДатаЗаселения И &ДатаВыселения)
		|
		|СГРУППИРОВАТЬ ПО
		|	СостояниеНомеровСрезПоследних.Состояние,
		|	СостояниеНомеровСрезПоследних.ДатаЗаселения,
		|	СостояниеНомеровСрезПоследних.Регистратор,
		|	СостояниеНомеровСрезПоследних.ДатаВыселения
		|
		|УПОРЯДОЧИТЬ ПО
		|	СостояниеНомеровСрезПоследних.ДатаЗаселения";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%УсловиеОснования%", ?(ЗначениеЗаполнено(ДокументОснование), "И Регистратор <> &ДокументОснование", ""));				   
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Сообщить("Номер " + Выборка.Состояние + " с " + Выборка.ДатаЗаселения + " по " + Выборка.ДатаВыселения + ". Документ: " + Выборка.Регистратор);
		КонецЦикла;
		
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции