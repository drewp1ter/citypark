// Контракт: docs/BOOKING_CONTRACT.md. Без привилегированного режима.

Функция ПроверитьДоступность(Данные) Экспорт
	ПроверитьСервисногоПользователя();
	Параметры = НормализоватьПроживание(Данные);
	ПроверитьДатуЗаезда(Параметры);
	Настройки = ПолучитьНастройки(Параметры.roomTypeId);
	УстановитьВремяПроживания(Параметры);
	Номера = ПолучитьНомера(Настройки);
	Результат = ПараметрыОтвета(Параметры);
	Результат.Вставить("available", ЗначениеЗаполнено(НайтиСвободныйНомер(Параметры, Настройки, Номера)));
	Возврат Результат;
КонецФункции

Функция СоздатьБронирование(Данные) Экспорт
	ПроверитьСервисногоПользователя();
	ПроверитьПоля(Данные, "idempotencyKey,roomTypeId,checkIn,checkOut,guests,guest,price");
	Ключ = ПроверитьКлюч(Данные.idempotencyKey);
	Параметры = НормализоватьПроживание(Данные, Истина);
	Гость = НормализоватьГостя(Данные.guest);
	Цена = ПроверитьЦену(Данные.price, Параметры);
	КаноническийЗапрос = Новый Структура("idempotencyKey", Ключ);
	Для Каждого Поле Из ПараметрыОтвета(Параметры) Цикл
		КаноническийЗапрос.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	КаноническийЗапрос.Вставить("guest", Гость);
	КаноническийЗапрос.Вставить("price", Цена);
	ЗапросJSON = ЗаписатьСтрокуJSON(КаноническийЗапрос);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.КлючиОнлайнБронирования");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Ключ", Ключ);
		Блокировка.Заблокировать();
		Запись = РегистрыСведений.КлючиОнлайнБронирования.СоздатьМенеджерЗаписи();
		Запись.Ключ = Ключ;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Если Запись.ЗапросJSON <> ЗапросJSON Тогда
				ВызватьИсключение "IDEMPOTENCY_CONFLICT";
			КонецЕсли;
			Результат = Новый Структура("Код,Данные", 200, ПрочитатьСтрокуJSON(Запись.РезультатJSON));
		Иначе
			// Повтор принятого запроса допускается после даты заезда и отключения типа.
			ПроверитьДатуЗаезда(Параметры);
			Настройки = ПолучитьНастройки(Параметры.roomTypeId);
			УстановитьВремяПроживания(Параметры);
			Номера = ПолучитьНомера(Настройки);
			ЗаблокироватьНомера(Номера);
			Номер = НайтиСвободныйНомер(Параметры, Настройки, Номера);
			Если Не ЗначениеЗаполнено(Номер) Тогда
				ВызватьИсключение "ROOM_UNAVAILABLE";
			КонецЕсли;
			Документ = СоздатьДокументБронирования(Параметры, Гость, Цена, Настройки, Номер);
			ДанныеОтвета = Новый Структура("reservationId,reservationNumber,status",
				Строка(Документ.Ссылка.УникальныйИдентификатор()), СокрЛП(Документ.Номер), "confirmed");
			Для Каждого Поле Из ПараметрыОтвета(Параметры) Цикл
				ДанныеОтвета.Вставить(Поле.Ключ, Поле.Значение);
			КонецЦикла;
			ДанныеОтвета.Вставить("price", Цена);
			// Пишем отфильтрованный набор явно: менеджер записи может вызвать обработчик
			// для прежнего отбора после чтения отсутствующего ключа.
			НаборКлючей = РегистрыСведений.КлючиОнлайнБронирования.СоздатьНаборЗаписей();
			НаборКлючей.Отбор.Ключ.Установить(Ключ);
			Запись = НаборКлючей.Добавить();
			Запись.Ключ = Ключ;
			Запись.ЗапросJSON = ЗапросJSON;
			Запись.Документ = Документ.Ссылка;
			Запись.РезультатJSON = ЗаписатьСтрокуJSON(ДанныеОтвета);
			Запись.Имя = Гость.name;
			Запись.Email = Гость.email;
			Запись.Телефон = Гость.phone;
			НаборКлючей.Записать();
			Результат = Новый Структура("Код,Данные", 201, ДанныеОтвета);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция ПолучитьРезультат(Знач Ключ) Экспорт
	ПроверитьСервисногоПользователя();
	Ключ = ПроверитьКлюч(Ключ);
	Запись = РегистрыСведений.КлючиОнлайнБронирования.СоздатьМенеджерЗаписи();
	Запись.Ключ = Ключ;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		ВызватьИсключение "RESERVATION_NOT_FOUND";
	КонецЕсли;
	Возврат ПрочитатьСтрокуJSON(Запись.РезультатJSON);
КонецФункции

Функция ОтменаГостем(Знач Ключ, Подтвердить) Экспорт
	ПроверитьСервисногоПользователя();
	Запись = РегистрыСведений.КлючиОнлайнБронирования.СоздатьМенеджерЗаписи();
	Запись.Ключ = ПроверитьКлюч(Ключ);
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		ВызватьИсключение "RESERVATION_NOT_FOUND";
	КонецЕсли;
	Ссылка = Запись.Документ;
	НачатьТранзакцию();
	Попытка
		Снимок = Ссылка.ПолучитьОбъект();
		ЗаблокироватьДокумент(Снимок);
		Бронь = Ссылка.ПолучитьОбъект();
		Если Бронь.ГостиничныйНомер <> Снимок.ГостиничныйНомер Тогда
			ВызватьИсключение "BOOKING_UNAVAILABLE";
		КонецЕсли;
		Если ЕстьПроведенныйДокумент("ОтменаБронирования", Ссылка) Тогда
			Статус = "canceled";
		ИначеЕсли Не Бронь.Проведен Или Бронь.ПометкаУдаления
			Или Бронь.СтатусДокумента <> Перечисления.СтатусыДокументов.Открыт
			Или ТекущаяУниверсальнаяДата() + 10800 >= Бронь.ДатаЗаселения
			Или ЕстьПроведенныйДокумент("Заселение", Ссылка) Тогда
			Статус = "closed";
		ИначеЕсли Подтвердить Тогда
			Отмена = Документы.ОтменаБронирования.СоздатьДокумент();
			Отмена.Заполнить(Ссылка);
			Отмена.Дата = ТекущаяДата();
			Отмена.ПричинаОтмены = "Отменено гостем через сайт";
			Отмена.Записать(РежимЗаписиДокумента.Проведение);
			Статус = "canceled";
		Иначе
			Статус = "eligible";
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Новый Структура("status", Статус);
КонецФункции

Функция ОнлайнБронированиеОтменено(Основание) Экспорт
	Возврат ЭтоОнлайнБронирование(Основание)
		И ЕстьПроведенныйДокумент("ОтменаБронирования", Основание);
КонецФункции

Функция ЕстьПроведенныйДокумент(Имя, Основание)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ." + Имя
		+ " ГДЕ Основание = &Основание И Проведен");
	Запрос.УстановитьПараметр("Основание", Основание);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Процедура ПроверитьСервисногоПользователя() Экспорт
	Если Не РольДоступна("ОнлайнБронированиеСервис") Тогда
		ВызватьИсключение "FORBIDDEN";
	КонецЕсли;
КонецПроцедуры

Процедура ЗаблокироватьНомера(Номера) Экспорт
	// Один порядок для HTTP, старого/нового номера и документов-оснований.
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("UUID");
	Таблица.Колонки.Добавить("Номер");
	Для Каждого Номер Из Номера Цикл
		Если ЗначениеЗаполнено(Номер) И Таблица.Найти(Номер, "Номер") = Неопределено Тогда
			СтрокаТаблицы = Таблица.Добавить();
			СтрокаТаблицы.UUID = Строка(Номер.УникальныйИдентификатор());
			СтрокаТаблицы.Номер = Номер;
		КонецЕсли;
	КонецЦикла;
	Таблица.Сортировать("UUID");
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.БлокировкиНомеровБронирования");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("ГостиничныйНомер", СтрокаТаблицы.Номер);
		Блокировка.Заблокировать();
	КонецЦикла;
КонецПроцедуры

Процедура ЗаблокироватьДокумент(Документ) Экспорт
	// Вызывается в транзакции записи/проведения платформы.
	Номера = Новый Массив;
	Номера.Добавить(Документ.ГостиничныйНомер);
	Снимки = Новый Соответствие;
	ДобавитьСнимокДокумента(Документ.Ссылка, Снимки, Номера);
	Если Документ.Метаданные().Реквизиты.Найти("Основание") <> Неопределено Тогда
		ДобавитьСнимокДокумента(Документ.Основание, Снимки, Номера);
	КонецЕсли;
	ЗаблокироватьНомера(Номера);
	Для Каждого Снимок Из Снимки Цикл
		Текущее = ПрочитатьПоляДокумента(Снимок.Ключ);
		Если Текущее = Неопределено Тогда
			ВызватьИсключение "Документ изменён другим пользователем. Откройте его заново.";
		КонецЕсли;
		Если Текущее.ГостиничныйНомер <> Снимок.Значение.ГостиничныйНомер
			Или Текущее.Основание <> Снимок.Значение.Основание Тогда
			// Не добираем новую блокировку вне порядка UUID.
			ВызватьИсключение "Документ изменён другим пользователем. Откройте его заново.";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьСнимокДокумента(Ссылка, Снимки, Номера)
	Если Не ЗначениеЗаполнено(Ссылка) Или Снимки.Получить(Ссылка) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Поля = ПрочитатьПоляДокумента(Ссылка);
	Если Поля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Снимки.Вставить(Ссылка, Поля);
	Номера.Добавить(Поля.ГостиничныйНомер);
	ДобавитьСнимокДокумента(Поля.Основание, Снимки, Номера);
КонецПроцедуры

Функция ПрочитатьПоляДокумента(Ссылка)
	Имя = Ссылка.Метаданные().Имя;
	Если Имя <> "Бронирование" И Имя <> "Заселение" И Имя <> "ОтменаБронирования" И Имя <> "Выселение" Тогда
		ВызватьИсключение "BOOKING_UNAVAILABLE";
	КонецЕсли;
	ПолеОснования = ?(Имя = "Бронирование", "NULL", "Основание");
	Запрос = Новый Запрос("ВЫБРАТЬ ГостиничныйНомер, " + ПолеОснования + " КАК Основание ИЗ Документ." + Имя + " ГДЕ Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("ГостиничныйНомер,Основание", Выборка.ГостиничныйНомер,
		?(ТипЗнч(Выборка.Основание) = Тип("Null"), Неопределено, Выборка.Основание));
КонецФункции

Функция ЭтоОнлайнБронирование(Знач Ссылка) Экспорт
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.Заселение") Тогда
		Ссылка = Ссылка.Основание;
	КонецЕсли;
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.Бронирование") Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ключ ИЗ РегистрСведений.КлючиОнлайнБронирования ГДЕ Документ = &Документ");
	Запрос.УстановитьПараметр("Документ", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Функция ПолучитьНастройки(ТипНомера)
	Запись = РегистрыСведений.НастройкиОнлайнБронирования.СоздатьМенеджерЗаписи();
	Запись.ТипНомераСайта = ТипНомера;
	Запись.Прочитать();
	Если Не Запись.Выбран() Или Не Запись.Включено Тогда
		ВызватьИсключение "BOOKING_UNAVAILABLE";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Запись.Организация) Или Запись.Организация.ПометкаУдаления
		Или Не ЗначениеЗаполнено(Запись.Ответственный) Или Запись.Ответственный.ПометкаУдаления
		Или Не ЗначениеЗаполнено(Запись.ТипНомера) Или Запись.ТипНомера.ПометкаУдаления Тогда
		ВызватьИсключение "BOOKING_UNAVAILABLE";
	КонецЕсли;
	Если Пользователи.ТекущийПользователь() <> Запись.Ответственный Тогда
		ВызватьИсключение "FORBIDDEN";
	КонецЕсли;
	Возврат Запись;
КонецФункции

// Даты сайта не содержат времени. Используем те же константы, что и рабочее место администратора.
Процедура УстановитьВремяПроживания(Параметры)
	Параметры.Заезд = УправлениеЗаселением.РассчитатьВремяЗаселения(Параметры.Заезд);
	Параметры.Выезд = УправлениеЗаселением.ПолучитьДатуИВремяВыселения(Параметры.Выезд);
КонецПроцедуры

Функция ПолучитьНомера(Настройки)
	Идентификаторы = ПрочитатьСтрокуJSON(Настройки.НомераJSON);
	Если ТипЗнч(Идентификаторы) <> Тип("Массив") Тогда
		ВызватьИсключение "BOOKING_UNAVAILABLE";
	КонецЕсли;
	Если Идентификаторы.Количество() = 0 Тогда
		ВызватьИсключение "BOOKING_UNAVAILABLE";
	КонецЕсли;
	Допустимые = ДопустимыеНомера(Настройки.ТипНомераСайта);
	Если Идентификаторы.Количество() <> Допустимые.Количество() Тогда
		ВызватьИсключение "BOOKING_UNAVAILABLE";
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого UUID Из Идентификаторы Цикл
		Если Допустимые.Найти(UUID) = Неопределено Тогда
			ВызватьИсключение "BOOKING_UNAVAILABLE";
		КонецЕсли;
		Номер = Справочники.ГостиничныеНомера.ПолучитьСсылку(Новый УникальныйИдентификатор(ПроверитьКлюч(UUID)));
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.ГостиничныеНомера ГДЕ Ссылка = &Номер И НЕ ПометкаУдаления И ТипНомера = &Тип И НЕ ТипНомера.ПометкаУдаления И НЕ Владелец.ПометкаУдаления И НЕ Владелец.Владелец.ПометкаУдаления");
		Запрос.УстановитьПараметр("Номер", Номер);
		Запрос.УстановитьПараметр("Тип", Настройки.ТипНомера);
		Если Запрос.Выполнить().Пустой() Или Результат.Найти(Номер) <> Неопределено Тогда
			ВызватьИсключение "BOOKING_UNAVAILABLE";
		КонецЕсли;
		Результат.Добавить(Номер);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Проверенные наборы из контракта. Одинаковый тип 1С не означает одинаковый тип сайта.
Функция ДопустимыеНомера(ТипНомера) Экспорт
	Если ТипНомера = "vip" Тогда
		Суффиксы = "a";
	ИначеЕсли ТипНомера = "single-balcony" Тогда
		Суффиксы = "4";
	ИначеЕсли ТипНомера = "single" Тогда
		Суффиксы = "7,d";
	ИначеЕсли ТипНомера = "double-twin" Тогда
		Суффиксы = "6,9,b,c";
	ИначеЕсли ТипНомера = "double-euro" Тогда
		Суффиксы = "5,8,e,f";
	Иначе
		ВызватьИсключение "BOOKING_UNAVAILABLE";
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Суффикс Из СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Суффиксы, ",", Ложь) Цикл
		Результат.Добавить("fb170ab" + Суффикс + "-5e75-11e4-80cd-b8a38697f1fc");
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиСвободныйНомер(Параметры, Настройки, Номера)
	Для Каждого Номер Из Номера Цикл
		Если УправлениеЗаселением.НомерСвободенВДанномПериоде(ТекущаяДата(),
			Параметры.Заезд, Параметры.Выезд, Настройки.Организация, Номер, Неопределено, Ложь) Тогда
			Возврат Номер;
		КонецЕсли;
	КонецЦикла;
	Возврат Справочники.ГостиничныеНомера.ПустаяСсылка();
КонецФункции

Функция СоздатьДокументБронирования(Параметры, Гость, Цена, Настройки, Номер)
	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Контрагент.Наименование = Гость.name;
	Контрагент.ПолноеНаименование = Гость.name;
	Контрагент.ТипКонтрагента = Перечисления.ТипыКонтрагентов.ФизЛицо;
	ВидыКонтактов = Справочники.ВидыКонтактнойИнформации;
	ТипыКонтактов = Перечисления.ТипыКонтактнойИнформации;
	ПоляТелефона = Новый СписокЗначений;
	ПоляТелефона.Добавить(Сред(Гость.phone, 2), "НомерТелефона");
	Телефон = КонтактнаяИнформацияСлужебный.ДесериализацияТелефона(
		ПоляТелефона, Гость.phone, ТипыКонтактов.Телефон);
	УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(Контрагент,
		КонтактнаяИнформацияСлужебный.СериализацияКонтактнойИнформации(Телефон),
		ВидыКонтактов.ТелефонКонтрагента, ТипыКонтактов.Телефон);
	Если Гость.email <> "" Тогда
		EmailXML = КонтактнаяИнформацияСлужебный.ПарсингКонтактнойИнформацииXML(
			Гость.email, ТипыКонтактов.АдресЭлектроннойПочты);
		УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(Контрагент,
			EmailXML, ВидыКонтактов.EmailКонтрагента, ТипыКонтактов.АдресЭлектроннойПочты);
	КонецЕсли;
	Контрагент.Записать();
	Документ = Документы.Бронирование.СоздатьДокумент();
	Заполнение = Новый Структура("Организация,ГостиничныйКорпус,ГостиничныйНомер,ДатаЗаселения,Контрагент",
		Настройки.Организация, Номер.Владелец, Номер, Параметры.Заезд, Контрагент.Ссылка);
	Документ.Заполнить(Заполнение);
	Документ.Дата = ТекущаяДата();
	Документ.Ответственный = Настройки.Ответственный;
	Документ.КоличествоГостей = Параметры.guests;
	Документ.ДатаЗаселения = Параметры.Заезд;
	Документ.ДатаВыселения = Параметры.Выезд;
	Документ.Проживание.Очистить();
	СтрокаПроживания = Документ.Проживание.Добавить();
	СтрокаПроживания.НачалоПериода = Параметры.Заезд;
	СтрокаПроживания.КонецПериода = Параметры.Выезд;
	СтрокаПроживания.Тариф = Справочники.ТарифыПроживания.Сутки;
	СтрокаПроживания.Количество = Цена.nights;
	Документ.Стоимость.Очистить();
	СтрокаСтоимости = Документ.Стоимость.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаСтоимости, СтрокаПроживания);
	СтрокаСтоимости.Цена = Цена.nightlyPriceKopecks / 100;
	СтрокаСтоимости.Сумма = Цена.totalKopecks / 100;
	Документ.Сумма = СтрокаСтоимости.Сумма;
	Если Не Документ.ПроверитьЗаполнение() Тогда
		ВызватьИсключение "BOOKING_UNAVAILABLE";
	КонецЕсли;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Документ;
КонецФункции

// Ручное изменение цены — только в форме открытого онлайн-документа сотрудником.
// Не изменяет сохранённый запрос/результат API и не записывает документ автоматически.
Функция МожноИзменитьЦенуВручную(Документ) Экспорт
	Если РольДоступна("ОнлайнБронированиеСервис") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.КлючиОнлайнБронирования) Тогда
		Возврат Ложь;
	КонецЕсли;
	МетаданныеДокумента = Документ.Метаданные();
	Если Не ПравоДоступа("Изменение", МетаданныеДокумента) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Документ.ПометкаУдаления
		Или Документ.СтатусДокумента <> Перечисления.СтатусыДокументов.Открыт Тогда
		Возврат Ложь;
	КонецЕсли;
	Если МетаданныеДокумента.Имя = "Бронирование" Тогда
		Возврат ЭтоОнлайнБронирование(Документ.Ссылка);
	ИначеЕсли МетаданныеДокумента.Имя = "Заселение" Тогда
		Возврат ЭтоОнлайнБронирование(Документ.Основание);
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Процедура ИзменитьЦенуВручную(Документ, НомерСтроки, НоваяЦена) Экспорт
	Если Не МожноИзменитьЦенуВручную(Документ) Тогда
		ВызватьИсключение "Изменение цены недоступно для этого документа.";
	КонецЕсли;
	Если ТипЗнч(НомерСтроки) <> Тип("Число") Тогда
		ВызватьИсключение "Выберите строку стоимости.";
	КонецЕсли;
	Если НомерСтроки <> Цел(НомерСтроки) Или НомерСтроки < 1
		Или НомерСтроки > Документ.Стоимость.Количество() Тогда
		ВызватьИсключение "Строка стоимости изменилась. Выберите её заново.";
	КонецЕсли;
	Если ТипЗнч(НоваяЦена) <> Тип("Число") Тогда
		ВызватьИсключение "Введите цену числом.";
	КонецЕсли;
	Если НоваяЦена < 0 Или НоваяЦена > 9999999999999.99 Или НоваяЦена <> Окр(НоваяЦена, 2) Тогда
		ВызватьИсключение "Введите неотрицательную цену с точностью до копейки.";
	КонецЕсли;
	СтрокаСтоимости = Документ.Стоимость[НомерСтроки - 1];
	Если СтрокаСтоимости.Количество <= 0 Тогда
		ВызватьИсключение "Количество в строке стоимости должно быть больше нуля.";
	КонецЕсли;
	НоваяСуммаСтроки = Окр(СтрокаСтоимости.Количество * НоваяЦена, 2);
	НоваяСуммаДокумента = Документ.Стоимость.Итог("Сумма") - СтрокаСтоимости.Сумма + НоваяСуммаСтроки;
	Если НоваяСуммаСтроки > 9999999999999.99
		Или НоваяСуммаДокумента < 0 Или НоваяСуммаДокумента > 9999999999999.99 Тогда
		ВызватьИсключение "Сумма превышает допустимое значение.";
	КонецЕсли;
	СтрокаСтоимости.Цена = НоваяЦена;
	СтрокаСтоимости.Сумма = НоваяСуммаСтроки;
	Документ.Сумма = НоваяСуммаДокумента;
КонецПроцедуры

Функция НормализоватьПроживание(Данные, Создание = Ложь)
	Если Не Создание Тогда
		ПроверитьПоля(Данные, "roomTypeId,checkIn,checkOut,guests");
	КонецЕсли;
	Вместимость = Новый Соответствие;
	Вместимость.Вставить("single", 1);
	Вместимость.Вставить("single-balcony", 1);
	Вместимость.Вставить("double-twin", 2);
	Вместимость.Вставить("double-euro", 2);
	Вместимость.Вставить("vip", 4);
	Если ТипЗнч(Данные.roomTypeId) <> Тип("Строка") Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Предел = Вместимость.Получить(Данные.roomTypeId);
	Если Предел = Неопределено Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	ПроверитьЦелое(Данные.guests, 1, Предел);
	Заезд = ПрочитатьДату(Данные.checkIn);
	Выезд = ПрочитатьДату(Данные.checkOut);
	Если Выезд <= Заезд Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Возврат Новый Структура("roomTypeId,checkIn,checkOut,guests,Заезд,Выезд",
		Данные.roomTypeId, Данные.checkIn, Данные.checkOut, Цел(Данные.guests), Заезд, Выезд);
КонецФункции

Процедура ПроверитьДатуЗаезда(Параметры)
	// Москва UTC+3. Не зависит от часового пояса сеанса/ОС.
	Если НачалоДня(Параметры.Заезд) < НачалоДня(ТекущаяУниверсальнаяДата() + 10800) Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
КонецПроцедуры

Функция ПрочитатьДату(Значение)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Если СтрДлина(Значение) <> 10 Или Сред(Значение, 5, 1) <> "-" Или Сред(Значение, 8, 1) <> "-" Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Цифры = СтрЗаменить(Значение, "-", "");
	Если СтрДлина(Цифры) <> 8 Или Не ТолькоСимволы(Цифры, "0123456789") Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	// Значение Дата допускает годы до 9999, но хранение в базе — только до 3999.
	ГодДаты = Число(Лев(Значение, 4));
	Если ГодДаты < 1 Или ГодДаты > 3999 Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Попытка
		Результат = Дата(ГодДаты, Число(Сред(Значение, 6, 2)), Число(Прав(Значение, 2)), 0, 0, 0);
	Исключение
		ВызватьИсключение "INVALID_REQUEST";
	КонецПопытки;
	Если Формат(Результат, "ДФ=yyyy-MM-dd") <> Значение Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПроверитьЦену(Данные, Параметры)
	ПроверитьПоля(Данные, "currency,nights,nightlyPriceKopecks,totalKopecks");
	Если Данные.currency <> "RUB" Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	ПроверитьЦелое(Данные.nights, 1, 4000000);
	// Ограничение существующих полей Стоимость.Сумма/Цена: Число(15,2).
	ПроверитьЦелое(Данные.nightlyPriceKopecks, 1, 999999999999999);
	ПроверитьЦелое(Данные.totalKopecks, 1, 999999999999999);
	Если Данные.nights <> (НачалоДня(Параметры.Выезд) - НачалоДня(Параметры.Заезд)) / 86400
		Или Данные.nightlyPriceKopecks * Данные.nights <> Данные.totalKopecks Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Возврат Новый Структура("currency,nights,nightlyPriceKopecks,totalKopecks", "RUB", Цел(Данные.nights), Цел(Данные.nightlyPriceKopecks), Цел(Данные.totalKopecks));
КонецФункции

Функция НормализоватьГостя(Гость)
	ПроверитьПоля(Гость, "name,email,phone");
	Имя = ПроверитьСтроку(Гость.name, 150);
	Email = ПроверитьСтроку(Гость.email, 254, Истина);
	Телефон = ПроверитьСтроку(Гость.phone, 80);
	Если Email <> "" Тогда
		Части = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Email, "@", Ложь);
		Если Части.Количество() <> 2 Или Части[0] = "" Или Части[1] = "" Или Найти(Email, " ") > 0 Тогда
			ВызватьИсключение "INVALID_REQUEST";
		КонецЕсли;
		Домен = НРег(Части[1]);
		Если Не ТолькоСимволы(Домен, "abcdefghijklmnopqrstuvwxyz0123456789-.")
			Или Лев(Домен, 1) = "." Или Прав(Домен, 1) = "." Или Найти(Домен, "..") > 0 Тогда
			ВызватьИсключение "INVALID_REQUEST";
		КонецЕсли;
		Для Каждого Метка Из СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Домен, ".", Ложь) Цикл
			Если СтрДлина(Метка) > 63 Или Лев(Метка, 1) = "-" Или Прав(Метка, 1) = "-" Тогда
				ВызватьИсключение "INVALID_REQUEST";
			КонецЕсли;
		КонецЦикла;
		Если Не ТолькоСимволы(Части[0], "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.!#$%&'*+-/=?^_`{|}~")
			Или Лев(Части[0], 1) = "." Или Прав(Части[0], 1) = "." Или Найти(Части[0], "..") > 0 Тогда
			ВызватьИсключение "INVALID_REQUEST";
		КонецЕсли;
		Email = Части[0] + "@" + Домен;
		Если ПолучитьДвоичныеДанныеИзСтроки(Email, КодировкаТекста.UTF8).Размер() > 254 Тогда
			ВызватьИсключение "INVALID_REQUEST";
		КонецЕсли;
	КонецЕсли;
	Телефон = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Телефон, " ", ""), "(", ""), ")", ""), "-", "");
	Если Лев(Телефон, 1) = "+" Тогда
		Телефон = Сред(Телефон, 2);
	ИначеЕсли СтрДлина(Телефон) = 11 И Лев(Телефон, 1) = "8" Тогда
		Телефон = "7" + Сред(Телефон, 2);
	КонецЕсли;
	Если СтрДлина(Телефон) < 8 Или СтрДлина(Телефон) > 15 Или Не ТолькоСимволы(Телефон, "0123456789") Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Возврат Новый Структура("name,email,phone", Имя, Email, "+" + Телефон);
КонецФункции

Функция ПроверитьСтроку(Значение, Максимум, РазрешитьПустую = Ложь)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Индекс);
		Если Код < 32 Или (Код >= 127 И Код <= 159) Тогда
			ВызватьИсключение "INVALID_REQUEST";
		КонецЕсли;
	КонецЦикла;
	Значение = СокрЛП(Значение);
	Если (Не РазрешитьПустую И СтрДлина(Значение) = 0) Или СтрДлина(Значение) > Максимум Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Возврат Значение;
КонецФункции

Процедура ПроверитьЦелое(Значение, Минимум, Максимум)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Если Значение <> Цел(Значение) Или Значение < Минимум Или Значение > Максимум Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
КонецПроцедуры

Функция ПроверитьКлюч(Ключ) Экспорт
	Если ТипЗнч(Ключ) <> Тип("Строка") Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Если СтрДлина(Ключ) <> 36 Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Попытка
		UUID = Новый УникальныйИдентификатор(Ключ);
	Исключение
		ВызватьИсключение "INVALID_REQUEST";
	КонецПопытки;
	Если Строка(UUID) <> Ключ Или Ключ = "00000000-0000-0000-0000-000000000000" Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Возврат Ключ;
КонецФункции

Функция ТолькоСимволы(Строка, Допустимые)
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Если Найти(Допустимые, Сред(Строка, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура ПроверитьПоля(Данные, Имена)
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Поля = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Имена, ",", Ложь);
	Если Данные.Количество() <> Поля.Количество() Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Для Каждого Поле Из Данные Цикл
		Если Найти("," + Имена + ",", "," + Поле.Ключ + ",") = 0 Тогда
			ВызватьИсключение "INVALID_REQUEST";
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из Поля Цикл
		Если Не Данные.Свойство(Имя) Тогда
			ВызватьИсключение "INVALID_REQUEST";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПараметрыОтвета(Параметры)
	Возврат Новый Структура("roomTypeId,checkIn,checkOut,guests", Параметры.roomTypeId, Параметры.checkIn, Параметры.checkOut, Параметры.guests);
КонецФункции

Функция ЗаписатьСтрокуJSON(Данные) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция ПрочитатьСтрокуJSON(СтрокаJSON) Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(Чтение);
	Если Чтение.Прочитать() Тогда
		ВызватьИсключение "INVALID_REQUEST";
	КонецЕсли;
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции
