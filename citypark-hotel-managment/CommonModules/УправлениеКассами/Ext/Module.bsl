
Функция ПолучитьСтруктуруДанныхКассыЗаПериод(НачалоПериода, КонецПериода, Организация, Касса) Экспорт
	
	СтруктураДанных = Новый Структура("НаНачало, Приход, Расход, НаКонец", 0,0,0,0);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Касса", Касса);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДенежныеСредстваОстаткиИОбороты.СуммаНачальныйОстаток КАК НаНачало,
	               |	ДенежныеСредстваОстаткиИОбороты.СуммаПриход КАК Приход,
	               |	ДенежныеСредстваОстаткиИОбороты.СуммаРасход КАК Расход,
	               |	ДенежныеСредстваОстаткиИОбороты.СуммаКонечныйОстаток КАК НаКонец
	               |ИЗ
	               |	РегистрНакопления.ДенежныеСредства.ОстаткиИОбороты(
	               |			&НачалоПериода,
	               |			&КонецПериода,
	               |			,
	               |			,
	               |			Организация = &Организация
	               |				И Касса = &Касса) КАК ДенежныеСредстваОстаткиИОбороты";
				   
				   РезультатЗапроса = Запрос.Выполнить();
				   Если Не РезультатЗапроса.Пустой() Тогда
					   
					   Выборка = РезультатЗапроса.Выбрать();
					   Выборка.Следующий();
					   
					   ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
					   
				   КонецЕсли;
				   
	Возврат СтруктураДанных;
				   
КонецФункции

Функция ПолучитьПараметрыСмены(Организация, Касса) Экспорт

	Результат = Новый Структура("Организация, Касса, НачалоСмены, КонецСмены", Организация, Касса, ТекущаяДата() - 1, ТекущаяДата());

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Касса", Касса);
	Запрос.Текст ="ВЫБРАТЬ
	              |	ПриходныйКассовыйОрдер.Дата,
	              |	ПриходныйКассовыйОрдер.Касса,
	              |	ПриходныйКассовыйОрдер.Организация
	              |ПОМЕСТИТЬ ВТ_ДатыОткрытыхДокументов
	              |ИЗ
	              |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	              |ГДЕ
	              |	ПриходныйКассовыйОрдер.СтатусДокумента = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Открыт)
	              |	И НЕ ПриходныйКассовыйОрдер.ПометкаУдаления
	              |	И ПриходныйКассовыйОрдер.Организация = &Организация
	              |	И ПриходныйКассовыйОрдер.Касса = &Касса
	              |
	              |ОБЪЕДИНИТЬ ВСЕ
	              |
	              |ВЫБРАТЬ
	              |	РасходныйКассовыйОрдер.Дата,
	              |	РасходныйКассовыйОрдер.Касса,
	              |	РасходныйКассовыйОрдер.Организация
	              |ИЗ
	              |	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	              |ГДЕ
	              |	РасходныйКассовыйОрдер.СтатусДокумента = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Открыт)
	              |	И НЕ РасходныйКассовыйОрдер.ПометкаУдаления
	              |	И РасходныйКассовыйОрдер.Организация = &Организация
	              |	И РасходныйКассовыйОрдер.Касса = &Касса
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	ВТ_ДатыОткрытыхДокументов.Организация,
	              |	ВТ_ДатыОткрытыхДокументов.Касса,
	              |	МИНИМУМ(ВТ_ДатыОткрытыхДокументов.Дата) КАК НачалоСмены,
	              |	МАКСИМУМ(ВТ_ДатыОткрытыхДокументов.Дата) КАК КонецСмены
	              |ИЗ
	              |	ВТ_ДатыОткрытыхДокументов КАК ВТ_ДатыОткрытыхДокументов
	              |
	              |СГРУППИРОВАТЬ ПО
	              |	ВТ_ДатыОткрытыхДокументов.Касса,
	              |	ВТ_ДатыОткрытыхДокументов.Организация" ;

	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда

		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(Результат, Выборка);

	КонецЕсли;

	Возврат Результат;

КонецФункции
