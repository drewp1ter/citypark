

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//                                            ЦЕНЫ НОМЕНКЛАТУРЫ
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция ПолучитьЦенуНоменклатуры(Дата, Организация, ТипЦен, Номенклатура, ЕдиницаИзмерения) Экспорт
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",Дата);
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("ТипЦен",ТипЦен);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",ЕдиницаИзмерения);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ТипЦен = &ТипЦен
	|				И Номенклатура = &Номенклатура
	|				И ЕдиницаИзмерения = &ЕдиницаИзмерения) КАК ЦеныНоменклатурыСрезПоследних";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Результат = Выборка.Цена;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//                                            ЦЕНЫ ПРОЖИВАНИЯ
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция ПолучитьЦенуПроживания(Дата, Организация, ТипЦен, ТипНомера, Тариф = Неопределено) Экспорт
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	Запрос.УстановитьПараметр("ТипНомера", ТипНомера);
	Запрос.УстановитьПараметр("Тариф", Тариф);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЦеныПроживанияСрезПоследних.Цена
	               |ИЗ
	               |	РегистрСведений.ЦеныПроживания.СрезПоследних(
	               |			&Период,
	               |			Организация = &Организация
	               |				И ТипЦен = &ТипЦен
	               |				И ТипНомера = &ТипНомера
	               |				%УсловиеТарифа%) КАК ЦеныПроживанияСрезПоследних";
				   
				   Запрос.Текст = СтрЗаменить(Запрос.Текст, "%УсловиеТарифа%", ?(УправлениеЗаселением.ИспользоватьТарифыПроживания(), "И Тариф = &Тариф", ""));
					
				   РезультатЗапроса = Запрос.Выполнить();
				   
				   Если Не РезультатЗапроса.Пустой() Тогда
					   
					   Выборка = РезультатЗапроса.Выбрать();
					   Выборка.Следующий();
					   
					   Результат = Выборка.Цена;
					   
				   КонецЕсли;
				   
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьМассивЦенПроживания(НачалоПериода, КонецПериода, Организация, ТипЦен, ТипНомера, Тариф = Неопределено) Экспорт
	
	МассивЦен = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	Запрос.УстановитьПараметр("ТипНомера", ТипНомера);
	Запрос.УстановитьПараметр("Тариф", Тариф);
	
	Запрос.Текст ="ВЫБРАТЬ
	              |	ЦеныПроживания.Период КАК Дата,
	              |	ЦеныПроживания.Цена
	              |ИЗ
	              |	РегистрСведений.ЦеныПроживания КАК ЦеныПроживания
	              |ГДЕ
	              |	ЦеныПроживания.Период МЕЖДУ &НачалоПериода И &КонецПериода
	              |	И ЦеныПроживания.Организация = &Организация
	              |	И ЦеныПроживания.ТипЦен = &ТипЦен
	              |	И ЦеныПроживания.ТипНомера = &ТипНомера
	              |	%УсловиеТарифа%
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	Период" ;
				   
				   Запрос.Текст = СтрЗаменить(Запрос.Текст, "%УсловиеТарифа%", ?(УправлениеЗаселением.ИспользоватьТарифыПроживания(), "И ЦеныПроживания.Тариф = &Тариф", ""));
					
				   РезультатЗапроса = Запрос.Выполнить();
				   
				   Если Не РезультатЗапроса.Пустой() Тогда
					   					   
					   Выборка = РезультатЗапроса.Выбрать();
					   Выборка.Следующий();
					   
					   НоваяСтрока = Новый Структура("Дата, Цена", Выборка.Дата, Выборка.Цена);
					   МассивЦен.Добавить(НоваяСтрока);
					   
				   КонецЕсли;
				   
	Возврат МассивЦен;

КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуСтоимостиПроживания(Организация, ТипЦен, ТипНомера, ТаблицаПроживания, ТаблицаСтоимости) Экспорт
	
	ТаблицаСтоимости.Очистить();
	
	Для Каждого СтрокаПроживания Из ТаблицаПроживания Цикл
		
		НоваяСтрока = ТаблицаСтоимости.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПроживания);
		НоваяСтрока.Цена = Ценообразование.ПолучитьЦенуПроживания(НоваяСтрока.НачалоПериода, Организация, ТипЦен, ТипНомера, НоваяСтрока.Тариф);
		НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
		
		МассивЦен = Ценообразование.ПолучитьМассивЦенПроживания(НоваяСтрока.НачалоПериода, НоваяСтрока.КонецПериода, Организация, ТипЦен, ТипНомера, НоваяСтрока.Тариф);
		
		Если МассивЦен.Количество() > 0 Тогда
			
			Для Каждого СтрокаИзмененияЦены из МассивЦен Цикл
				
				КонецПериода = УправлениеЗаселением.ПолучитьДатуИВремяВыселения(СтрокаИзмененияЦены.Дата, НоваяСтрока.Тариф);
				
				Если КонецПериода <= СтрокаПроживания.КонецПериода Тогда
					
					НоваяСтрока.КонецПериода = КонецПериода;
					НоваяСтрока.Количество = УправлениеЗаселением.РассчитатьКоличествоЕдиницТарифаПоДатам(НоваяСтрока.НачалоПериода, НоваяСтрока.КонецПериода, НоваяСтрока.Тариф);
					НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
					
					Количество = УправлениеЗаселением.РассчитатьКоличествоЕдиницТарифаПоДатам(КонецПериода, СтрокаПроживания.КонецПериода, НоваяСтрока.Тариф);
					
					Если Количество > 0 Тогда   
						
						НоваяСтрока = ТаблицаСтоимости.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПроживания);
						НоваяСтрока.НачалоПериода = КонецПериода;
						НоваяСтрока.КонецПериода = СтрокаПроживания.КонецПериода;
						НоваяСтрока.Цена = Ценообразование.ПолучитьЦенуПроживания(НоваяСтрока.НачалоПериода, Организация, ТипЦен, ТипНомера, НоваяСтрока.Тариф);
						НоваяСтрока.Количество = Количество;
						НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;			
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры