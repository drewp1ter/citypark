//
Процедура НастройкаИнтерфейса(НастройкиРаботыИнтерфейса) Экспорт
	
	
	
КонецПроцедуры

// Содержит описание таблиц и полей объектов для проверки запретов изменения данных.
//   Вызывается из процедуры ИзменениеЗапрещено общего модуля ДатыЗапретаИзменения, используемой в подписке
// на событие ПередЗаписью объекта для проверки наличия запретов и отказа от изменений запрещенного объекта.
//
// Параметры:
//  ИсточникиДанных - ТаблицаЗначений - с колонками:
//   * Таблица     - Строка - полное имя объекта метаданных, например, "Документ.ПриходнаяНакладная".
//   * ПолеДаты    - Строка - имя реквизита объекта или табличной части, например "Дата", "Товары.ДатаОтгрузки".
//   * Раздел      - Строка - имя предопределенного элемента "ПланВидовХарактеристикСсылка.РазделыДатЗапрета".
//   * ПолеОбъекта - Строка - имя реквизита объекта или реквизита табличной части, например "Организация", "Товары.Склад".
//
//  Для добавления строки имеется процедура ДобавитьСтроку в общем модуле ДатыЗапретаИзменения.
//
Процедура ЗаполнитьИсточникиДанныхДляПроверкиЗапретаИзменения(ИсточникиДанных) Экспорт
	
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.УстановкаЦенПроживания", "Дата", "ПоОрганизациям", "Организация");
	
	///////////////////////////////////////////////////////////////////////
	//				Документы гостиницы
	///////////////////////////////////////////////////////////////////////
	
	// Заселение
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.Заселение", "ДатаЗаселения");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.Заселение", "ДатаЗаселения", "ПоОрганизациям", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.Заселение", "ДатаЗаселения", "ПоГостиничнымКорпусам", "ГостиничныйКорпус");
	
	// Выселение
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.Выселение", "ДатаЗаселения");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.Выселение", "ДатаЗаселения", "ПоОрганизациям", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.Выселение", "ДатаЗаселения", "ПоГостиничнымКорпусам", "ГостиничныйКорпус");
	
	// Бронирование
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.Бронирование", "ДатаЗаселения");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.Бронирование", "ДатаЗаселения", "ПоОрганизациям", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.Бронирование", "ДатаЗаселения", "ПоГостиничнымКорпусам", "ГостиничныйКорпус");
	
	// Отмена бронирования
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ОтменаБронирования", "Дата");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ОтменаБронирования", "Дата", "ПоОрганизациям", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ОтменаБронирования", "Дата", "ПоГостиничнымКорпусам", "ГостиничныйКорпус");
	
	///////////////////////////////////////////////////////////////////////
	//				Документы Кассы
	///////////////////////////////////////////////////////////////////////
	
	// ПКО
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ПриходныйКассовыйОрдер", "Дата");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ПриходныйКассовыйОрдер", "Дата", "ПоОрганизациям", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ПриходныйКассовыйОрдер", "Дата", "ПоКассам", "Касса");
	
	// РКО
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.РасходныйКассовыйОрдер", "Дата");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.РасходныйКассовыйОрдер", "Дата", "ПоОрганизациям", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.РасходныйКассовыйОрдер", "Дата", "ПоКассам", "Касса");
	
	// Закрытие смены
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ЗакрытиеКассовойСмены", "Дата");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ЗакрытиеКассовойСмены", "Дата", "ПоОрганизациям", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ЗакрытиеКассовойСмены", "Дата", "ПоКассам", "Касса");

	///////////////////////////////////////////////////////////////////////
	//				Документы Продаж
	///////////////////////////////////////////////////////////////////////

	// Чек ККМ	
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ЧекККМ", "Дата");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ЧекККМ", "Дата", "ПоОрганизациям", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ЧекККМ", "Дата", "ПоТорговымТочкам", "ТорговаяТочка");
	
	// Отчет о розничных продажах
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ОтчетОРозничныхПродажах", "Дата");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ОтчетОРозничныхПродажах", "Дата", "ПоОрганизациям", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ.ОтчетОРозничныхПродажах", "Дата", "ПоТорговымТочкам", "ТорговаяТочка");
	
	///////////////////////////////////////////////////////////////////////
	//				Документы Склада
	///////////////////////////////////////////////////////////////////////

КонецПроцедуры

// Позволяет переопределить выполнение проверок запретов по произвольному условию.
//
// Параметры:
//  Объект       - СправочникОбъект,
//                 ДокументОбъект,
//                 ПланВидовХарактеристикОбъект,
//                 ПланСчетовОбъект,
//                 ПланВидовРасчетаОбъект,
//                 БизнесПроцессОбъект,
//                 ЗадачаОбъект,
//                 ПланОбменаОбъект - объект данных (ПередЗаписью или ПриЧтенииНаСервере).
//               - РегистрСведенийНаборЗаписей,
//                 РегистрНакопленияНаборЗаписей,
//                 РегистрБухгалтерииНаборЗаписей,
//                 РегистрРасчетаНаборЗаписей - набор записей (ПередЗаписью или ПриЧтенииНаСервере).
//  
//  ПроверкаЗапретаИзменения - Булево - если установить Ложь проверка запрета
//                             изменения выполняться не будет.
//
//  УзелПроверкиЗапретаЗагрузки - Неопределено, ПланыОбменаСсылка -
//                 когда Неопределено проверка запрета загрузки не выполняется.
//
//  СообщитьОЗапрете - Булево - начальное значение Истина. Если установить Ложь,
//                 тогда сообщение об ошибке не будет отправлено пользователю.
//                 Например, при интерактивной записи будет виден лишь отказ записи.
//                 В журнал регистрации сообщение будет записано в любом случае.
//
Процедура ПередПроверкойЗапретаИзменения(Объект,
                                         ПроверкаЗапретаИзменения,
                                         УзелПроверкиЗапретаЗагрузки,
                                         СообщитьОЗапрете) Экспорт
	
	
	
КонецПроцедуры

#КонецОбласти
