
Процедура ЗаполнитьОбъектФормы(ОбъектФормы) Экспорт
	
	Если ОбъектФормы.Свойство("Дата") Тогда
		Если Не ЗначениеЗаполнено(ОбъектФормы.Дата) Тогда
			ОбъектФормы.Дата = ТекущаяДата();
		КонецЕсли;
	КонецЕсли;
	
	Если ОбъектФормы.Свойство("Организация") Тогда
		Если Не ЗначениеЗаполнено(ОбъектФормы.Организация) Тогда
			ОбъектФормы.Организация =  ПараметрыСеанса.ТекущийПользователь.ОсновнаяОрганизация;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбъектФормы.Свойство("Склад") Тогда
		Если Не ЗначениеЗаполнено(ОбъектФормы.Склад) Тогда
			ОбъектФормы.Склад =  ПараметрыСеанса.ТекущийПользователь.ОсновнойСклад;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбъектФормы.Свойство("Ответственный") Тогда
		Если Не ЗначениеЗаполнено(ОбъектФормы.Ответственный) Тогда
			ОбъектФормы.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
	КонецЕсли;	
			
	Если ОбъектФормы.Свойство("ГостиничныйКорпус") Тогда
		Если Не ЗначениеЗаполнено(ОбъектФормы.ГостиничныйКорпус) Тогда
			ОбъектФормы.ГостиничныйКорпус = ПараметрыСеанса.ТекущийПользователь.ОсновнойГостиничныйКорпус;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбъектФормы.Свойство("Касса") Тогда
		Если Не ЗначениеЗаполнено(ОбъектФормы.Касса) Тогда
			ОбъектФормы.Касса = ПараметрыСеанса.ТекущийПользователь.ОсновнаяКасса;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбъектФормы.Свойство("ТорговаяТочка") Тогда
		Если Не ЗначениеЗаполнено(ОбъектФормы.ТорговаяТочка) Тогда
			ОбъектФормы.ТорговаяТочка = ПараметрыСеанса.ТекущийПользователь.ОсновнаяТорговаяТочка;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьОбъект(ДокументОбъект) Экспорт
	
	ДокументОбъект.Дата = ТекущаяДата();
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("Организация") <> Неопределено Тогда
		ДокументОбъект.Организация = ПараметрыСеанса.ТекущийПользователь.ОсновнаяОрганизация;		
	КонецЕсли;
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("Склад") <> Неопределено Тогда
		ДокументОбъект.Склад = ПараметрыСеанса.ТекущийПользователь.ОсновнойСклад;		
	КонецЕсли;
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("Ответственный") <> Неопределено Тогда
		ДокументОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;		
	КонецЕсли;
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("ГостиничныйКорпус") <> Неопределено Тогда
		ДокументОбъект.ГостиничныйКорпус =  ПараметрыСеанса.ТекущийПользователь.ОсновнойГостиничныйКорпус;		
	КонецЕсли;
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("ТорговаяТочка") <> Неопределено Тогда
		ДокументОбъект.ТорговаяТочка =  ПараметрыСеанса.ТекущийПользователь.ОсновнаяТорговаяТочка;		
	КонецЕсли; 
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("Касса") <> Неопределено Тогда
		ДокументОбъект.Касса =  ПараметрыСеанса.ТекущийПользователь.ОсновнаяКасса;		
	КонецЕсли; 	
	
КонецПроцедуры

Функция ПолучитьТекущегоПользователя() Экспорт
	
	Возврат ПараметрыСеанса.АвторизованныйПользователь;
	
КонецФункции

Функция ПолучитьЗначениеПользователяПоУмолчанию(ИмяСвойства) Экспорт
	
	Если ПараметрыСеанса.ТекущийПользователь.Метаданные().Реквизиты.Найти(ИмяСвойства) <> Неопределено Тогда
		Возврат ПараметрыСеанса.ТекущийПользователь[ИмяСвойства];
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДатуПрошлогоЗакрытияСменыГостиницы(Организация, ГостиничныйКорпус) Экспорт
	
	Результат = ТекущаяДата();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ГостиничныйКорпус", ГостиничныйКорпус);
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ЗакрытиеСменыАдминистратораГостиницы.Дата) КАК Дата
	               |ИЗ
	               |	Документ.ЗакрытиеСменыАдминистратораГостиницы КАК ЗакрытиеСменыАдминистратораГостиницы
	               |ГДЕ
	               |	ЗакрытиеСменыАдминистратораГостиницы.Организация = &Организация
	               |	И ЗакрытиеСменыАдминистратораГостиницы.ГостиничныйКорпус = &ГостиничныйКорпус
	               |	И ЗакрытиеСменыАдминистратораГостиницы.Проведен";
				   
				   РезультатЗапроса = Запрос.Выполнить();
				   Если Не РезультатЗапроса.Пустой() Тогда
					   
					   Выборка = РезультатЗапроса.Выбрать();
					   Выборка.Следующий();
					   
					   Результат = Выборка.Дата;
					   
				   КонецЕсли;
				   
	Возврат Результат;
	
КонецФункции