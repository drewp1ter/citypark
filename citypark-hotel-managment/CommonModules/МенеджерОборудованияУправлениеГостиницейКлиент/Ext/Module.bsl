// Печать чека

Процедура НачатьПечатьЧека(ОповещениеПриПечатиЧека, УникальныйИдентификатор, ПараметрыПечати) Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("СледующееОповещение"     , ОповещениеПриПечатиЧека);
	Контекст.Вставить("УникальныйИдентификатор" , УникальныйИдентификатор);
	// Изменил ПараметрыПечати."Документ" На "ЧекККМ"
	Контекст.Вставить("Документ"  				, ПараметрыПечати.ЧекККМ);
		
	ОписаниеОповещения = Новый ОписаниеОповещения("НачатьПечатьЧекаЗавершение", ЭтотОбъект, Контекст);
	МенеджерОборудованияКлиент.ПредложитьВыбратьУстройство(ОписаниеОповещения, "ЧековыйПринтер",
		НСтр("ru='Выберите чековый принтер'"), НСтр("ru='Чековый принтер не подключен.'"));
	
КонецПроцедуры

Процедура НачатьПечатьЧекаЗавершение(ИдентификаторУстройства, Параметры) Экспорт
	
	ОписаниеОшибки = "";
	// Подключаем чековый принтер
	Результат = МенеджерОборудованияКлиент.ПодключитьОборудованиеПоИдентификатору(Параметры.УникальныйИдентификатор, ИдентификаторУстройства, ОписаниеОшибки);
	
	Если Результат Тогда
		
		МассивДок = Новый Массив;
		МассивДок.Добавить(Параметры.Документ);
		
		ВыходныеПараметры = Новый Массив;
		Результат = МенеджерОборудованияКлиент.ВыполнитьКоманду(ИдентификаторУстройства, "ПолучитьСоответствиеТермопринтеров",,ВыходныеПараметры);
		
		Если Результат Тогда
			
			ПараметрыПечати = Новый Структура;
			ПараметрыПечати.Вставить("СоответствиеПринтеров", ВыходныеПараметры[0]);
			
			Если ВыходныеПараметры[1] Тогда // Печать сразу на принтеры
				
				УправлениеПечатьюКлиент.ВыполнитьКомандуПечатиНаПринтер("Документ.ЧекККМ", "ЗаявкиНаПриготовление", МассивДок, ПараметрыПечати);
				
			Иначе
				
				УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Документ.ЧекККМ", "ЗаявкиНаПриготовление", МассивДок, Параметры.УникальныйИдентификатор, ПараметрыПечати);
				
			КонецЕсли;
						
			МенеджерОборудованияКлиент.ОтключитьОборудованиеПоИдентификатору(Параметры.УникальныйИдентификатор, ИдентификаторУстройства);
			
		КонецЕсли;
	
		
	Иначе
		ТекстСообщения = НСтр("ru='При подключении устройства произошла ошибка.
								  |%ОписаниеОшибки%
								  |Карта не создана.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;

КонецПроцедуры

