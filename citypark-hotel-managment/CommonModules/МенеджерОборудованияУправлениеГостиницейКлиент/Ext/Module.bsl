//		Функции работы с электронными замками гостиницы

// Начать создание карты электронного замка
// УникальныйИдентификатор - идентификатор формы
// ОповещениеПриВыгрузкуДанные - оповещение при завершении выгрузки данных
//
Процедура НачатьСозданиеКарты(ОповещениеПриСозданииКарты, УникальныйИдентификатор, ПараметрыСозданияКарты) Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("СледующееОповещение"     , ОповещениеПриСозданииКарты);
	Контекст.Вставить("УникальныйИдентификатор" , УникальныйИдентификатор);
	Контекст.Вставить("ГостиничныйНомер"  		, ПараметрыСозданияКарты.ГостиничныйНомер);
	Контекст.Вставить("ДатаВыселения"			, ПараметрыСозданияКарты.ДатаВыселения);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("НачатьСозданиеКартыЗавершение", ЭтотОбъект, Контекст);
	МенеджерОборудованияКлиент.ПредложитьВыбратьУстройство(ОписаниеОповещения, "ЭлектронныйЗамок",
		НСтр("ru='Выберите электронный замок'"), НСтр("ru='Электронный замок не подключен.'"));
	
	КонецПроцедуры
	
	//НачатьСозданиеКопии карты
Процедура НачатьСозданиеКопииКарты(ОповещениеПриСозданииКарты, УникальныйИдентификатор, ПараметрыСозданияКарты) Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("СледующееОповещение"     , ОповещениеПриСозданииКарты);
	Контекст.Вставить("УникальныйИдентификатор" , УникальныйИдентификатор);
	Контекст.Вставить("ГостиничныйНомер"  		, ПараметрыСозданияКарты.ГостиничныйНомер);
	Контекст.Вставить("ДатаВыселения"			, ПараметрыСозданияКарты.ДатаВыселения);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("НачатьСозданиеКопииКартыЗавершение", ЭтотОбъект, Контекст);
	МенеджерОборудованияКлиент.ПредложитьВыбратьУстройство(ОписаниеОповещения, "ЭлектронныйЗамок",
		НСтр("ru='Выберите электронный замок'"), НСтр("ru='Электронный замок не подключен.'"));
	
КонецПроцедуры


Процедура НачатьСозданиеКартыЗавершение(ИдентификаторУстройства, Параметры) Экспорт
	
	ОписаниеОшибки = "";
	// Подключаем электронный замок
	Результат = МенеджерОборудованияКлиент.ПодключитьОборудованиеПоИдентификатору(Параметры.УникальныйИдентификатор, ИдентификаторУстройства, ОписаниеОшибки);
	
	Если Результат Тогда
		
		ИдентификаторВСКД = ОбщегоНазначенияУправлениеГостинцейВызовСервера.ЗначениеРеквизитаОбъекта(Параметры.ГостиничныйНомер, "ИдентификаторВСКД");
		
		Если ЗначениеЗаполнено(ИдентификаторВСКД) И ЗначениеЗаполнено(Параметры.ДатаВыселения) Тогда
			
			ВходныеПараметры  = Новый Массив();
			ВходныеПараметры.Добавить(ИдентификаторВСКД);
			ВходныеПараметры.Добавить(Параметры.ДатаВыселения);
			
			ВыходныеПараметры = Неопределено;
			
			Результат = МенеджерОборудованияКлиент.ВыполнитьКоманду(ИдентификаторУстройства, "СоздатьКарту", ВходныеПараметры, ВыходныеПараметры);
			Если НЕ Результат Тогда
				ТекстСообщения = НСтр("ru='При содании карты электронного замка произошла ошибка.
				|%ОписаниеОшибки%
				|Карта не создана.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ВыходныеПараметры[1]);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Иначе
				Если Параметры.СледующееОповещение <> Неопределено Тогда
					ВыполнитьОбработкуОповещения(Параметры.СледующееОповещение, Истина);
				КонецЕсли;
			КонецЕсли;
			
			МенеджерОборудованияКлиент.ОтключитьОборудованиеПоИдентификатору(Параметры.УникальныйИдентификатор, ИдентификаторУстройства);
			
		КонецЕсли;
	
	Иначе
		ТекстСообщения = НСтр("ru='При подключении устройства произошла ошибка.
								  |%ОписаниеОшибки%
								  |Карта не создана.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
		
КонецПроцедуры


