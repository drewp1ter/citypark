Процедура ПередЗаписью(Отказ, Замещение)
	// Записи восстановления неизменяемы и не удаляются в течение жизни брони.
	Если Не Отбор.Ключ.Использование Тогда
		ВызватьИсключение "Необходимо указать ключ онлайн-бронирования.";
	КонецЕсли;
	Ключ = ОнлайнБронирование.ПроверитьКлюч(Отбор.Ключ.Значение);
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.КлючиОнлайнБронирования");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ключ", Ключ);
	Блокировка.Заблокировать();
	Запрос = Новый Запрос("ВЫБРАТЬ Ключ ИЗ РегистрСведений.КлючиОнлайнБронирования ГДЕ Ключ = &Ключ");
	Запрос.УстановитьПараметр("Ключ", Ключ);
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Запись онлайн-бронирования уже существует и не может быть изменена.";
	КонецЕсли;
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Запись.Ключ <> Ключ Или Не ЗначениеЗаполнено(Запись.Документ)
			Или ПустаяСтрока(Запись.ЗапросJSON) Или ПустаяСтрока(Запись.РезультатJSON) Тогда
			ВызватьИсключение "Некорректная запись онлайн-бронирования.";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
