// Выполнить на сервере в консоли кода 1С или во временной внешней обработке.
// Только чтение справочников. РезультатJSON содержит результат для копирования.
// Полный список номеров сохраняется: номер на печать может отличаться от кода.

РезультатЭкспорта = Новый Структура;
РезультатЭкспорта.Вставить("schemaVersion", 1);
Номера = Новый Массив;

ЗапросНомеров = Новый Запрос;
ЗапросНомеров.Текст = "ВЫБРАТЬ
|	Номера.Ссылка КАК Номер,
|	Номера.Код КАК Код,
|	Номера.Наименование КАК Наименование,
|	Номера.НомерНаПечать КАК НомерНаПечать,
|	Номера.ПометкаУдаления КАК ПометкаУдаления,
|	Номера.ТипНомера КАК ТипНомера,
|	Номера.ТипНомера.Наименование КАК НаименованиеТипа,
|	Номера.ТипНомера.ПометкаУдаления КАК ТипПомеченНаУдаление
|ИЗ
|	Справочник.ГостиничныеНомера КАК Номера
|УПОРЯДОЧИТЬ ПО
|	Номера.Код, Номера.Наименование";

ВыборкаНомеров = ЗапросНомеров.Выполнить().Выбрать();
Пока ВыборкаНомеров.Следующий() Цикл

	Номер = Новый Структура;
	Номер.Вставить("roomId", Строка(ВыборкаНомеров.Номер.УникальныйИдентификатор()));
	Номер.Вставить("code", СокрЛП(ВыборкаНомеров.Код));
	Номер.Вставить("name", ВыборкаНомеров.Наименование);
	Номер.Вставить("printedNumber", ВыборкаНомеров.НомерНаПечать);
	Номер.Вставить("deletionMark", ВыборкаНомеров.ПометкаУдаления);

	Номер.Вставить("roomTypeId", "");
	Номер.Вставить("roomTypeName", "");
	Номер.Вставить("roomTypeDeletionMark", Ложь);
	Если ЗначениеЗаполнено(ВыборкаНомеров.ТипНомера) Тогда
		Номер.Вставить("roomTypeId", Строка(ВыборкаНомеров.ТипНомера.УникальныйИдентификатор()));
		Номер.Вставить("roomTypeName", ВыборкаНомеров.НаименованиеТипа);
		Номер.Вставить("roomTypeDeletionMark", ВыборкаНомеров.ТипПомеченНаУдаление);
	КонецЕсли;

	Номера.Добавить(Номер);

КонецЦикла;

РезультатЭкспорта.Вставить("rooms", Номера);
ЗаписьJSON = Новый ЗаписьJSON;
ЗаписьJSON.УстановитьСтроку();
ЗаписатьJSON(ЗаписьJSON, РезультатЭкспорта);
РезультатJSON = ЗаписьJSON.Закрыть();
Сообщить(РезультатJSON);
