
Функция ПолучитьОрганизацию()
	
	Возврат Справочники.Организации.НайтиПоКоду("000000001");	
	
КонецФункции

Функция ОтчетПоПродажам(ПериодНачало, ПериодКонец) 
	
	Отчет = Отчеты.Продажи.Создать();
	Отчет.НачалоСмены = ПериодНачало;
	Отчет.КонецСмены = ПериодКонец;
	
	ТабДок = Отчет.СформироватьОтчет();
		
	Возврат СериализаторXDTO.ЗаписатьXDTO(ТабДок);
	
КонецФункции  

