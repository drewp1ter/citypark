
Функция Sales(DateStart, DateEnd)
	
	ReportType = ФабрикаXDTO.Тип("http://www.sorc.ru/hotel/reports", "Report");
	ReportRowType = ФабрикаXDTO.Тип("http://www.sorc.ru/hotel/reports", "ReportRow");
	
	Report = ФабрикаXDTO.Создать(ReportType);
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("НачалоПериода", DateStart);
	Запрос.Параметры.Вставить("КонецПериода", DateEnd);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПродажиОбороты.Организация,
	               |	ПродажиОбороты.ТорговаяТочка,
	               |	ПродажиОбороты.Номенклатура,
	               |	ПродажиОбороты.КоличествоОборот КАК Количество,
	               |	ПродажиОбороты.СуммаОборот КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ПродажиОбороты";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ReportRowType = ФабрикаXDTO.Тип("http://www.sorc.ru/hotel/reports", "ReportRow");
		ReportRow = ФабрикаXDTO.Создать(ReportRowType);
		
		ReportRow.Group1 = Выборка.Организация.Наименование;
		ReportRow.Group2 = Выборка.ТорговаяТочка.Наименование;
		ReportRow.Group3 = Выборка.Номенклатура.Наименование;
		ReportRow.Count = Выборка.Количество;
		ReportRow.Sum = Выборка.Сумма;
		
		Report.Rows.Добавить(ReportRow);
		
	КонецЦикла;
	
	Возврат Report;

КонецФункции

Функция RoomSales(DateStart, DateEnd)
	
	ReportType = ФабрикаXDTO.Тип("http://www.sorc.ru/hotel/reports", "Report");
	ReportRowType = ФабрикаXDTO.Тип("http://www.sorc.ru/hotel/reports", "ReportRow");
	
	Report = ФабрикаXDTO.Создать(ReportType);
	Время = Дата("20130724120000");

	ДатаНачало = Дата(Год(DateStart),Месяц(DateStart),День(DateStart),Час(Время),Минута(Время),Секунда(Время));
	ДатаКонец = Дата(Год(DateEnd),Месяц(DateEnd),День(DateEnd),Час(Время),Минута(Время),Секунда(Время));

	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("НачалоПериода", ДатаНачало);
	Запрос.Параметры.Вставить("КонецПериода", ДатаКонец);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВзаиморасчетыЗаПроживание.Регистратор.Организация КАК Организация,
	               |	ВзаиморасчетыЗаПроживание.ДокументРасчетов.ГостиничныйНомер КАК ГостиничныйНомер,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВзаиморасчетыЗаПроживание.Период) КАК КоличествоСуток,
	               |	СУММА(ВзаиморасчетыЗаПроживание.Сумма) КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыЗаПроживание КАК ВзаиморасчетыЗаПроживание
	               |ГДЕ
	               |	ВзаиморасчетыЗаПроживание.Период МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ВзаиморасчетыЗаПроживание.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВзаиморасчетыЗаПроживание.ДокументРасчетов.ГостиничныйНомер,
	               |	ВзаиморасчетыЗаПроживание.Регистратор.Организация";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ReportRowType = ФабрикаXDTO.Тип("http://www.sorc.ru/hotel/reports", "ReportRow");
		ReportRow = ФабрикаXDTO.Создать(ReportRowType);
		
		ReportRow.Group1 = Выборка.Организация.Наименование;
		Если ЗначениеЗаполнено(Выборка.ГостиничныйНомер) Тогда
			ReportRow.Group2 = Выборка.ГостиничныйНомер.Наименование;
		Иначе
			ReportRow.Group2 = Строка(Выборка.ГостиничныйНомер);
		КонецЕсли;
		ReportRow.Group3 = "";
		ReportRow.Group4 = "";
		ReportRow.Group5 = "";
		ReportRow.Group6 = "";
		ReportRow.Count = Выборка.КоличествоСуток;
		ReportRow.Sum = Выборка.Сумма;
		
		Report.Rows.Добавить(ReportRow);
		
	КонецЦикла;
	
	Возврат Report;

КонецФункции

Функция MonthSales(DateStart, DateEnd)
	
	ReportType = ФабрикаXDTO.Тип("http://www.sorc.ru/hotel/reports", "Report");
	ReportRowType = ФабрикаXDTO.Тип("http://www.sorc.ru/hotel/reports", "ReportRow");
	
	Report = ФабрикаXDTO.Создать(ReportType);
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("НачалоПериода", DateStart);
	Запрос.Параметры.Вставить("КонецПериода", DateEnd);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	НАЧАЛОПЕРИОДА(ВзаиморасчетыЗаПроживание.Период, ДЕНЬ) КАК Дата,
	               |	ВзаиморасчетыЗаПроживание.Регистратор.Организация КАК Организация,
	               |	ВзаиморасчетыЗаПроживание.ДокументРасчетов.ГостиничныйНомер КАК ГостиничныйНомер,
	               |	СУММА(ВзаиморасчетыЗаПроживание.Сумма) КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыЗаПроживание КАК ВзаиморасчетыЗаПроживание
	               |ГДЕ
	               |	ВзаиморасчетыЗаПроживание.Период МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ВзаиморасчетыЗаПроживание.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВзаиморасчетыЗаПроживание.ДокументРасчетов.ГостиничныйНомер,
	               |	ВзаиморасчетыЗаПроживание.Регистратор.Организация,
	               |	НАЧАЛОПЕРИОДА(ВзаиморасчетыЗаПроживание.Период, ДЕНЬ)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ReportRowType = ФабрикаXDTO.Тип("http://www.sorc.ru/hotel/reports", "ReportRow");
		ReportRow = ФабрикаXDTO.Создать(ReportRowType);
		
		ReportRow.Group1 = Формат(Выборка.Дата, "ДФ=dd.MM.yyyy");
		ReportRow.Group2 = Выборка.Организация.Наименование;
		Если ЗначениеЗаполнено(Выборка.ГостиничныйНомер) Тогда
			ReportRow.Group3 = Выборка.ГостиничныйНомер.Наименование;
		Иначе
			ReportRow.Group3 = Строка(Выборка.ГостиничныйНомер);
		КонецЕсли;
		ReportRow.Group4 = "";
		ReportRow.Group5 = "";
		ReportRow.Group6 = "";
		ReportRow.Count = 0;
		ReportRow.Sum = Выборка.Сумма;
		
		Report.Rows.Добавить(ReportRow);
		
	КонецЦикла;
	
	ReportRow = ФабрикаXDTO.Создать(ReportRowType);
	
	ReportRow.Group1 = Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy");
	ReportRow.Group2 = "";
	ReportRow.Group3 = "";
	ReportRow.Group4 = "";
	ReportRow.Group5 = "";
	ReportRow.Group6 = "";
	ReportRow.Count = 0;
	ReportRow.Sum = 0;
	
	Report.Rows.Добавить(ReportRow);

	Возврат Report;

КонецФункции



