
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если ЗначениеЗаполнено(Параметры.Владелец) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Параметры.Вставить("Владелец", Параметры.Владелец);		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЕдиницыИзмерения.Ссылка КАК ЕдиницаИзмерения
		               |ИЗ
		               |	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		               |ГДЕ
		               |	ЕдиницыИзмерения.Владелец = &Владелец
		               |	И НЕ ЕдиницыИзмерения.ПометкаУдаления";
		
		ТаблицаЕдиниц.Загрузить(Запрос.Выполнить().Выгрузить());
		
		Если ТаблицаЕдиниц.Количество() > 1 Тогда
			
			Для Счетчик = 0 По ТаблицаЕдиниц.Количество() - 1 Цикл
				
				Команда = Команды.Добавить("ВыбратьЕдиницу" + Счетчик);
				Команда.Действие = "КомандаВыбратьЕдиницу";
				Команда.Заголовок = ТаблицаЕдиниц[Счетчик].ЕдиницаИзмерения.Наименование;
				
				Элемент = Элементы.Добавить("КнопкаВыбратьЕдиницу" + Счетчик, Тип("КнопкаФормы"));
  				Элемент.ИмяКоманды = "ВыбратьЕдиницу" + Счетчик;
				Элемент.Ширина = 30; Элемент.Высота = 1;
				Элемент.Шрифт = Новый Шрифт("MS Shell Dlg", 14, Истина);
  
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбратьЕдиницу(Команда)
	
	Индекс = Число(СтрЗаменить(Команда.Имя, "ВыбратьЕдиницу", "")); 
	ВыбранаЕдиница(Индекс);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранаЕдиница(ИндексЕдиницы) 

	ЭтаФорма.Закрыть(ТаблицаЕдиниц[ИндексЕдиницы].ЕдиницаИзмерения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ТаблицаЕдиниц.Количество() = 1 Тогда
		ВыбранаЕдиница(0);
	КонецЕсли;
	
КонецПроцедуры
