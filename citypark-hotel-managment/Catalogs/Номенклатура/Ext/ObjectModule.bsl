
Процедура ПроверитьНеобходимостьСозданияЕдиниц()
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("Владелец", Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕдиницыИзмерения.Ссылка
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|ГДЕ
	|	ЕдиницыИзмерения.Владелец = &Владелец";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		
		НоваяЕдиница = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
		НоваяЕдиница.Владелец = Ссылка;
		НоваяЕдиница.Наименование = БазоваяЕдиницаИзмерения.Наименование;
		НоваяЕдиница.Коэффициент = 1;
		НоваяЕдиница.Записать();
		
		ОсновнаяЕдиницаИзмерения = НоваяЕдиница.Ссылка;
		Записать();
		
	КонецЕсли;
				   
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если Не Отказ Тогда
		
		Если Не ЭтоГруппа И Не Загружена Тогда
			
			ПроверитьНеобходимостьСозданияЕдиниц();
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры
