
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.КаталогУслуг) Тогда
		
		КаталогУслуг = Параметры.КаталогУслуг;
		
		Список.КомпоновщикНастроек.Настройки.Отбор.Элементы[0].ПравоеЗначение = КаталогУслуг;
		Список.КомпоновщикНастроек.Настройки.Отбор.Элементы[0].Использование = Истина;
		
		//Список.Параметры.Элементы[0].Значение = Параметры.КаталогУслуг;
		//Список.Параметры.Элементы[0].Использование = Истина;
		
	Иначе 
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры
