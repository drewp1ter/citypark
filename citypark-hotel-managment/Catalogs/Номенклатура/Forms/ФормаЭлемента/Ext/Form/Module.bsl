
&НаКлиенте
Процедура КомандаУстановитьОсновной(Команда)
	
	Если Элементы.ПодчиненныеЕдиницы.ТекущиеДанные <> Неопределено Тогда
		КомандаУстановитьОсновнойНаСервере(Элементы.ПодчиненныеЕдиницы.ТекущиеДанные.Ссылка);
	КонецЕсли;
	ОтобразитьИзменениеДанных(Объект, ВидИзмененияДанных.Изменение);	
	
КонецПроцедуры

&НаСервере
Процедура КомандаУстановитьОсновнойНаСервере(ОсновнаяЕдиницаИзмерения)
	
	НоменклатураОбъект = Объект.Ссылка.ПолучитьОбъект();
	НоменклатураОбъект.ОсновнаяЕдиницаИзмерения = ОсновнаяЕдиницаИзмерения;
	НоменклатураОбъект.Записать();
	ЗначениеВДанныеФормы(НоменклатураОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.БазоваяЕдиницаИзмерения) Тогда
		Объект.БазоваяЕдиницаИзмерения = ЗаполнениеДокументовВызовСервера.ПолучитьЗначениеПользователяПоУмолчанию("ОсновнаяЕдиницаИзмерения");
	КонецЕсли;
	
	ДатаЦен = ТекущаяДата();
	ОбновитьОтборЦен();
	
	ПодчиненныеЕдиницы.Параметры.Элементы[0].Значение = Объект.Ссылка;
	ПодчиненныеЕдиницы.Параметры.Элементы[0].Использование = Истина;

КонецПроцедуры

&НаСервере
Процедура ОбновитьОтборЦен()
	
	РозничныеЦены.Параметры.Элементы[0].Значение = Объект.Ссылка;
	РозничныеЦены.Параметры.Элементы[0].Использование = Истина;
	
	//Калькуляции.Параметры.Элементы[0].Значение = Объект.Ссылка;
	//Калькуляции.Параметры.Элементы[0].Использование = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	
	Объект.НаименованиеПолное = Объект.Наименование;

КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьЕдиницуИзмерения(Команда)
	
	ПараметрыОткрытия = Новый Структура("Владелец", Объект.Ссылка);
	ОткрытьФорму("Справочник.ЕдиницыИзмерения.Форма.ФормаЭлемента", ПараметрыОткрытия);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ПодчиненныеЕдиницы.Параметры.Элементы[0].Значение = Объект.Ссылка;
	ПодчиненныеЕдиницы.Параметры.Элементы[0].Использование = ЗначениеЗаполнено(Объект.Ссылка);
	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступность()
	
	Элементы.ПодчиненныеЕдиницыКомандаСоздатьЕдиницуИзмерения.Доступность = ЗначениеЗаполнено(Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	УстановитьДоступность();
	
КонецПроцедуры
	
	
