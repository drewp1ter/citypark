
&НаКлиенте
Процедура КомандаВыбратьЦвет(Команда)
	
	Диалог = Новый ДиалогВыбораЦвета;
	Если Диалог.Выбрать() Тогда		
		Элементы.ДекорацияЦвета.ЦветФона = Диалог.Цвет;
	КонецЕсли;  	

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбъектДанные = ДанныеФормыВЗначение(Объект,Тип("СправочникОбъект.Склады"));
    ЗначениеИзХранилища = ОбъектДанные.Цвет.Получить();
	Если ЗначениеИзХранилища <> Неопределено Тогда
		Элементы.ДекорацияЦвета.ЦветФона = ЗначениеИзХранилища;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.Цвет = Новый ХранилищеЗначения(Элементы.ДекорацияЦвета.ЦветФона);
	
КонецПроцедуры
