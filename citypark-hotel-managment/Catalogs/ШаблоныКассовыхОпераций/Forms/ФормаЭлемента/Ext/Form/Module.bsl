

&НаСервере
Процедура УстановитьВидОперации()
	
	Если Объект.ВидДокумента = 0 Тогда
		
		Элементы.ВидыОперацийПКО.Видимость = Истина;
		Элементы.ВидыОперацийРКО.Видимость = Ложь;
		ВидыОперацийПКО = Объект.ВидОперации;     
		
	КонецЕсли;
	
	Если Объект.ВидДокумента = 1 Тогда
		
		Элементы.ВидыОперацийПКО.Видимость = Ложь;
		Элементы.ВидыОперацийРКО.Видимость = Истина;
		ВидыОперацийРКО = Объект.ВидОперации;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)
	
	УстановитьВидОперации();
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьВидОперации();
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидыОперацийПКОПриИзменении(Элемент)
	
	Объект.ВидОперации = ВидыОперацийПКО;
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидыОперацийРКОПриИзменении(Элемент)
	
	Объект.ВидОперации = ВидыОперацийРКО;
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	
	Элементы.Контрагент.Видимость = Объект.ВидОперации = Перечисления.ВидыОперацийПКО.ВозвратОтПодотчетника 
					ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПКО.ВозвратОтПоставщика
					ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийРКО.ВыдачаПодотчетнику
					ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийРКО.ОплатаПоставщику;
					
	Элементы.КассаПолучатель.Видимость = Объект.ВидОперации = Перечисления.ВидыОперацийРКО.ПеремещениеМеждуКассами;
	
КонецПроцедуры