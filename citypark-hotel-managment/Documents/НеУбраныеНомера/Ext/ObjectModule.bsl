Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Уборка Номера
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ГостиничныеНомера.Ссылка
	|ИЗ
	|	Справочник.ГостиничныеНомера КАК ГостиничныеНомера";
	Результат = Запрос.Выполнить().Выгрузить();   
	
	Для каждого Строки из Результат Цикл 
		
		Движения.УборкаНомеров.Записывать = Истина;
		Движение = Движения.УборкаНомеров.Добавить();
		Движение.Период = Дата;
		Движение.Убран = Ложь;
		Движение.ГостиничныйНомер = Строки.Ссылка;
		
	КонецЦикла;  

	
	
КонецПроцедуры
