
// Заполняет список команд печати.
//
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Прайс-лист
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.УстановкаЦенПроживания";
	КомандаПечати.Идентификатор = "ПрайсЛист";
	КомандаПечати.Представление = НСтр("ru = 'Прайс-лист'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	//ОтчетОРозничныхПродажах
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ОтчетОРозничныхПродажах";
	КомандаПечати.Идентификатор = "ОтчетОРозничныхПродажах";
	КомандаПечати.Представление = НСтр("ru = 'Продажи'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПрайсЛист");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПрайсЛист",
		НСтр("ru = 'Прайс-лист'"),
		ПечатьПрайсЛиста(МассивОбъектов, ОбъектыПечати),
		,
		"Документ.УстановкаЦенПроживания.ПФ_MXL_ПрайсЛист");
	КонецЕсли;
	
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ОтчетОРозничныхПродажах");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ОтчетОРозничныхПродажах",
		НСтр("ru = 'Продажи'"),
		ПечатьОтчетаОРозничныхПродажах(МассивОбъектов, ОбъектыПечати, ПараметрыПечати),
		,
		"Документ.ОтчетОРозничныхПродажах.ПФ_MXL_ОтчетОРозничныхПродажах");
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПечатьПрайсЛиста(МассивОбъектов, ОбъектыПечати)
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = УправлениеПечатью.ПолучитьМакет("Документ.УстановкаЦенПроживания.ПФ_MXL_ПрайсЛист");
	ТабДок.Вывести(Макет.ПолучитьОбласть("Шапка"));
	Возврат ТабДок;
	
КонецФункции

Функция ПечатьОтчетаОРозничныхПродажах(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = УправлениеПечатью.ПолучитьМакет("Документ.ОтчетОРозничныхПродажах.ПФ_MXL_ОтчетОРозничныхПродажах");
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ОтчетОРозничныхПродажах_ПФ_MXL_ОтчетОРозничныхПродажах";
	ЗаполнитьЗначенияСвойств(ТабличныйДокумент, ПараметрыПечати);	

	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =  "ВЫБРАТЬ
	|	ОтчетОРозничныхПродажах.Ссылка,
	|	ОтчетОРозничныхПродажах.Организация,
	|	ОтчетОРозничныхПродажах.Ответственный,
	|	ОтчетОРозничныхПродажах.Продавец,
	|	ОтчетОРозничныхПродажах.ТорговаяТочка,
	|	ОтчетОРозничныхПродажах.Сумма
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах
	|ГДЕ
	|	ОтчетОРозничныхПродажах.Ссылка В (&МассивОбъектов)";
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаЗапроса.Следующий() Цикл
		
		//ЛОГОТИП
		ОбластьЛоготип = Макет.ПолучитьОбласть("Логотип");
		ОбластьЛоготип.Параметры.Организация = ВыборкаЗапроса.Организация;
		ОбластьЛоготип.Параметры.ТорговаяТочка = ВыборкаЗапроса.ТорговаяТочка;
		ОбластьЛоготип.Параметры.ВремяПечати = ТекущаяДата();
		
		ТабличныйДокумент.Вывести(ОбластьЛоготип);
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
		Запрос.Текст ="ВЫБРАТЬ
		|	ОтчетОРозничныхПродажахТовары.Ссылка,
		|	ОтчетОРозничныхПродажахТовары.Номенклатура,
		|	ОтчетОРозничныхПродажахТовары.Сумма
		|ИЗ
		|	Документ.ОтчетОРозничныхПродажах.Товары КАК ОтчетОРозничныхПродажахТовары
		|ГДЕ
		|	ОтчетОРозничныхПродажахТовары.Ссылка В (&МассивОбъектов)";
		
		ВыгрузкаЗапроса = Запрос.Выполнить().Выгрузить();
		
		//ВЫРУЧКА  		
		ОбластьВыручка = Макет.ПолучитьОбласть("Товар");
				
		//ТаблицаНоменклатуры
		ОбластьТаблицаНоменклатуры = Макет.ПолучитьОбласть("СтрокаЗаголовка");
		
		Сумма = 0;
		Для каждого СтрокаВыгрузки из ВыгрузкаЗапроса Цикл
			
			Сумма = СтрокаВыгрузки.Сумма + Сумма;
			
		КонецЦикла;
		ОбластьВыручка.Параметры.Сумма = Сумма;
		ТабличныйДокумент.Вывести(ОбластьВыручка);
				
		Для каждого СтрокаВыгрузки из ВыгрузкаЗапроса Цикл
			
			ОбластьТаблицаНоменклатуры.Параметры.Номенклатура = СтрокаВыгрузки.Номенклатура;
			ОбластьТаблицаНоменклатуры.Параметры.СуммаНоменклатуры = СтрокаВыгрузки.Сумма;
			ТабличныйДокумент.Вывести(ОбластьТаблицаНоменклатуры);
			
		КонецЦикла;
				
		//Продавец
		ОбластьПродавец = Макет.ПолучитьОБласть("Продавец");
		ОбластьПродавец.Параметры.Продавец = ФизическиеЛицаКлиентСервер.ФамилияИнициалыФизЛица(ВыборкаЗапроса.Продавец.Наименование);
		
		ТабличныйДокумент.Вывести(ОбластьПродавец);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
КонецФункции