Процедура ОбработкаУдаленияПроведения(Отказ)
	
	НачатьТранзакцию();
	
	Движения.Продажи.Записывать = Истина;
	Движения.Продажи.Очистить();
	
	Движения.ОстаткиТМЦ.Записывать = Истина;
	Движения.ОстаткиТМЦ.Очистить();
	
	Движения.ВзаиморасчетыЗаПроживание.Записывать = Истина;
	Движения.ВзаиморасчетыЗаПроживание.Очистить();
	
	Попытка 
		
		Для Каждого ТекСтрока Из Документы Цикл
			
			Если ТекСтрока.Документ.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт Тогда
				
				ДокОбъект = ТекСтрока.Документ.ПолучитьОбъект();
				ДокОбъект.СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				
			КонецЕсли;
			
		КонецЦикла; 
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
	КонецПопытки;

КонецПроцедуры
