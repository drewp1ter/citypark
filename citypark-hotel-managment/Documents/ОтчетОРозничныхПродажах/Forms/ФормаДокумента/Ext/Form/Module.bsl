#Область НаСервере

///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 БИЗНЕС-ЛОГИКА НА СЕРВЕРЕ   ///////////////////////////////////////////


&НаСервере
Процедура ЗаполнитьДокументНаСервере()
	
	Если Объект.Проведен Тогда
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения);
		ПараметрыЗаписи.Вставить("РежимПроведения", РежимПроведенияДокумента.Неоперативный);
		Записать(ПараметрыЗаписи);
	КонецЕсли;
	
	Объект.Документы.Очистить();
	Объект.Товары.Очистить();
	Объект.Материалы.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоСмены);
	Запрос.УстановитьПараметр("КонецПериода", Объект.КонецСмены);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ТорговаяТочка", Объект.ТорговаяТочка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЧекККМ.Ссылка КАК Документ,
	               |	ЧекККМ.Сумма
	               |ИЗ
	               |	Документ.ЧекККМ КАК ЧекККМ
	               |ГДЕ
	               |	ЧекККМ.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ЧекККМ.ТорговаяТочка = &ТорговаяТочка
	               |	И ЧекККМ.Организация = &Организация
	               |	И ЧекККМ.СтатусДокумента = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Открыт)
	               |	И НЕ ЧекККМ.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЧекККМ.Дата";
				   
	Объект.Документы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Для Каждого ТекущийДокумент Из Объект.Документы Цикл
		
		Для Каждого СтрокаТовара Из ТекущийДокумент.Документ.Товары Цикл
			
			НоваяСтрокаТовара = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТовара, СтрокаТовара);
			НоваяСтрокаТовара.ЧекККМ = ТекущийДокумент.Документ;
			
			НоваяСтрокаМатериала = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаМатериала, СтрокаТовара);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Объект.Сумма = Объект.Документы.Итог("Сумма");
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступность()
	
	ЭтаФорма.ТолькоПросмотр = Объект.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт И Не РольДоступна("АдминистраторСистемы");
	
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ ФОРМЫ   		///////////////////////////////////////////


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

	// СтандартныеПодсистемы.Печать
	УправлениеПечатью.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Печать
	
	ЗаполнениеДокументов.ЗаполнитьШапку(Объект);
	
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		Объект.Организация = Параметры.Организация;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ТорговаяТочка) Тогда
		Объект.ТорговаяТочка = Параметры.ТорговаяТочка;		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.СтатусДокумента) Тогда
		Объект.СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;
	КонецЕсли;
	
	Если Объект.СтатусДокумента = Перечисления.СтатусыДокументов.Открыт И Не Объект.Проведен Тогда
		
		ПараметрыСмены = УправлениеПродажами.ПолучитьПараметрыСмены(Объект.Организация, Объект.ТорговаяТочка);
		Объект.НачалоСмены = ПараметрыСмены.НачалоСмены;
		Объект.КонецСмены = ПараметрыСмены.КонецСмены;		
		Объект.Продавец = ЗаполнениеДокументов.ПолучитьЗначениеПользователяПоУмолчанию("ФизическоеЛицо");
		Объект.ВидОперации = Перечисления.ВидыОперацийЗакрытиеСмены.ЗакрытиеСмены;
		ЗаполнитьДокументНаСервере();
		
	КонецЕсли; 	
		
КонецПроцедуры


