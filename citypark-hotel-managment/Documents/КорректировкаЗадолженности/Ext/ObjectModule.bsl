Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ВзаиморасчетыСПодотчетниками.Записывать = Истина;
	Движения.ВзаиморасчетыСПокупателями.Записывать = Истина;
	Движения.ВзаиморасчетыСПоставщиками.Записывать = Истина;
	Движения.ВзаиморасчетыСПерсоналом.Записывать = Истина;
	
	ВзаиморасчетыСПодотчетниками();
	
	ВзаиморасчетыСПоставщиками();
	
	//ВзаиморасчетыСПокупателями();
	
	//ВзаиморасчетыССотрудниками();
	
КонецПроцедуры

Процедура ВзаиморасчетыСПодотчетниками()
	
	Для Каждого СтрокаТч Из Подотчетники Цикл
		
		Запрос = Новый Запрос;
		Запрос.Параметры.Вставить("Период", Дата);
		Запрос.Параметры.Вставить("Организация", Организация);
		Запрос.Параметры.Вставить("Контрагент", СтрокаТч.Контрагент);
		
		СуммаКорректировки = СтрокаТч.Сумма;
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВзаиморасчетыСПодотчетникамиОстатки.СуммаОстаток
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчетыСПодотчетниками.Остатки(
		               |			&Период,
		               |			Организация = &Организация
		               |				И Контрагент = &Контрагент) КАК ВзаиморасчетыСПодотчетникамиОстатки";
					   
					   РезультатЗапроса = Запрос.Выполнить();
					   Если НЕ РезультатЗапроса.Пустой() Тогда
						   
						   Выборка = РезультатЗапроса.Выбрать();
						   Выборка.Следующий();
						   
						   СуммаКорректировки = СтрокаТч.Сумма - Выборка.СуммаОстаток;
						   
					   КонецЕсли;
					   
		Движение = Движения.ВзаиморасчетыСПодотчетниками.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Контрагент = СтрокаТч.Контрагент;
		Движение.Сумма = СуммаКорректировки;
		
	КонецЦикла;

КонецПроцедуры

Процедура ВзаиморасчетыСПоставщиками()
	
