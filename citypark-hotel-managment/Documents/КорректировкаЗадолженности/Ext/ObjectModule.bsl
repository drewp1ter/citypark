		Запрос.Текст = "ВЫБРАТЬ
		               |	ВзаиморасчетыСПоставщикамиОстатки.СуммаОстаток
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчетыСПоставщиками.Остатки(
		               |			&Период,
		               |			Организация = &Организация
		               |				И Контрагент = &Контрагент) КАК ВзаиморасчетыСПоставщикамиОстатки";
					   
					   РезультатЗапроса = Запрос.Выполнить();
					   Если НЕ РезультатЗапроса.Пустой() Тогда
						   
						   Выборка = РезультатЗапроса.Выбрать();
						   Выборка.Следующий();
						   
						   СуммаКорректировки = СтрокаТч.Сумма - Выборка.СуммаОстаток;
						   
					   КонецЕсли;
					   
		Движение = Движения.ВзаиморасчетыСПоставщиками.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Контрагент = СтрокаТч.Контрагент;
		Движение.Сумма = СуммаКорректировки;

	КонецЦикла;

КонецПроцедуры
