
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ЦеныНоменклатурыПоставщиков.Записывать = Истина;
	
	// регистр ОстаткиТМЦ Приход
	Движения.ОстаткиТМЦ.Записывать = Истина;
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Движение = Движения.ОстаткиТМЦ.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Партия = Ссылка;
		Движение.Организация = Организация;
		Движение.Склад = Склад;
		Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
		Движение.Количество = ТекСтрокаТовары.Количество;
		Движение.Сумма = ТекСтрокаТовары.Сумма;
	КонецЦикла;
	
	
	
	//регистр Взаиморасчеты с подоотчетниками
	Движения.ВзаиморасчетыСПодотчетниками.Записывать = Истина;
	Движение = Движения.ВзаиморасчетыСПодотчетниками.ДобавитьРасход();
	Движение.Период = Дата;		
	Движение.Организация = Организация; 
	Движение.Контрагент = Контрагент;
	Движение.Сумма = Сумма;
		
		// //регистр ВзаиморасчетыСПоставщиками
	//Движения.ВзаиморасчетыСПоставщиками.Записывать = Истина;
	//  Для каждого ТекСтрокаТовары из Товары Цикл
	//	
	//	Движение = Движения.ВзаиморасчетыСПоставщиками.ДобавитьРасход();
	//	Движение.Период = Дата;
	//	Движение.Организация = Организация; 
	//	Движение.Контрагент = Контрагент;
	//	Движение.Сумма = Сумма;
	//	
	//КонецЦикла;
	
	// Регистрация цен поставщика
	КопияТоваров = Товары.Выгрузить();
	КопияТоваров.Свернуть("Номенклатура");
	
	Для Каждого ТекСтрокаТовары Из КопияТоваров Цикл
		
		Отбор = Новый Структура("Номенклатура", ТекСтрокаТовары.Номенклатура);
		НайденныеСтроки = Товары.НайтиСтроки(Отбор);
		
		Движение = Движения.ЦеныНоменклатурыПоставщиков.Добавить();
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Контрагент = Контрагент;
		ЗаполнитьЗначенияСвойств(Движение, ТекСтрокаТовары);
		
		Если НайденныеСтроки.Количество() > 1 Тогда // Рассчитаем среднюю цену закупки, если позиций несколько
			СуммаСтрок = 0;
			КоличествоПоСтрокам = 0;
			Для Сч = 0 По НайденныеСтроки.Количество() - 1 Цикл
				СуммаСтрок = СуммаСтрок + НайденныеСтроки[Сч].Сумма;
				КоличествоПоСтрокам = КоличествоПоСтрокам + НайденныеСтроки[Сч].Количество * НайденныеСтроки[Сч].ЕдиницаИзмерения.Коэффициент;
			КонецЦикла;
			Движение.Цена = СуммаСтрок / ?(КоличествоПоСтрокам <> 0, КоличествоПоСтрокам, 1);
		ИначеЕсли НайденныеСтроки.Количество() > 0 Тогда
			Коэффициент = НайденныеСтроки[0].ЕдиницаИзмерения.Коэффициент;
			Движение.Цена = НайденныеСтроки[0].Цена / ?(Коэффициент <> 0, Коэффициент, 1);
		КонецЕсли;
		
	КонецЦикла;

	
КонецПроцедуры
