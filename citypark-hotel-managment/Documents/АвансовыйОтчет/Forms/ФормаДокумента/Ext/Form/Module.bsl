
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнениеДокументов.ЗаполнитьШапку(Объект);
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммуДокумента()
	
	Объект.Сумма = Объект.Товары.Итог("Сумма") + Объект.ОплатыПоставщикам.Итог("Сумма") + Объект.Прочее.Итог("Сумма");
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммуСтрокиТоваров(ИндексСтроки)
	
	ТекСтрока = Объект.Товары[ИндексСтроки];
	ТекСтрока.Сумма = ТекСтрока.Количество * ТекСтрока.Цена;
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	Если Элементы.Товары.ТекущиеДанные <> Неопределено Тогда
		ТоварыНоменклатураПриИзмененииНаСервере(Элементы.Товары.ТекущиеДанные.НомерСтроки - 1);
		ПересчитатьСуммуСтрокиТоваров(Элементы.Товары.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ТоварыНоменклатураПриИзмененииНаСервере(ИндексСтроки)
	
	ТекСтрока = Объект.Товары[ИндексСтроки];
	ТекСтрока.ЕдиницаИзмерения = ТекСтрока.Номенклатура.ОсновнаяЕдиницаИзмерения;
	
	Если Не ЗначениеЗаполнено(ТекСтрока.Склад) Тогда
		ТекСтрока.Склад = Объект.Склад;
	КонецЕсли;
	
	Если ТекСтрока.Цена = 0 Тогда
		ТекСтрока.Цена = Ценообразование.ПолучитьЦенуНоменклатуры(Объект.Дата, Объект.Организация, Объект.Контрагент,
																ТекСтрока.Номенклатура, ТекСтрока.ЕдиницаИзмерения);
	КонецЕсли;	
															
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияПриИзменении(Элемент)
	
	Если Элементы.Товары.ТекущиеДанные <> Неопределено Тогда
		ТоварыЕдиницаИзмеренияПриИзмененииНаСервере(Элементы.Товары.ТекущиеДанные.НомерСтроки - 1);
		ПересчитатьСуммуСтрокиТоваров(Элементы.Товары.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ТоварыЕдиницаИзмеренияПриИзмененииНаСервере(ИндексСтроки)
	
	ТекСтрока = Объект.Товары[ИндексСтроки];
	ТекСтрока.Цена = ЗаполнениеДокументов.ПолучитьЦенуЕдиницыНоменклатурыОтПоставщика(Объект.Дата, Объект.Организация, Объект.Контрагент,
																ТекСтрока.Номенклатура, ТекСтрока.ЕдиницаИзмерения);
		
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	Если Элементы.Товары.ТекущиеДанные <> Неопределено Тогда
		ПересчитатьСуммуСтрокиТоваров(Элементы.Товары.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	Если Элементы.Товары.ТекущиеДанные <> Неопределено Тогда
		ПересчитатьСуммуСтрокиТоваров(Элементы.Товары.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСуммаПриИзменении(Элемент)
	
	Если Элементы.Товары.ТекущиеДанные <> Неопределено Тогда
		ТоварыСуммаПриИзмененииНаСервере(Элементы.Товары.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ТоварыСуммаПриИзмененииНаСервере(ИндексСтроки)
	
	ТекСтрока = Объект.Товары[ИндексСтроки];
	ТекСтрока.Цена = ТекСтрока.Сумма / ?(ТекСтрока.Количество <> 0, ТекСтрока.Количество, 1); 
	//ТекСтрока.Сумма = ТекСтрока.Цена * ТекСтрока.Количество;
	ПересчитатьСуммуДокумента();
	

	КонецПроцедуры

&НаКлиенте
Процедура ОплатыПоставщикамСуммаПриИзменении(Элемент)
	
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочееСуммаПриИзменении(Элемент)
	
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ПересчитатьСуммуДокумента();
КонецПроцедуры
