
Процедура ОбработкаПроведения(Отказ, Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Если ВидОперации = Перечисления.ВидыОперацийРКО.ОплатаПоставщику Тогда
		Движения.ВзаиморасчетыСПоставщиками.Записывать = Истина;	
		Движение = Движения.ВзаиморасчетыСПоставщиками.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Организация = Организация; 
		Движение.Контрагент = Контрагент;		
		Движение.Сумма = Сумма ;		
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОперацийРКО.ВыдачаПодотчетнику Тогда
		Движения.ВзаиморасчетыСПодотчетниками.Записывать = Истина;
		Движение = Движения.ВзаиморасчетыСПодотчетниками.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Контрагент = Контрагент;
		ДВижение.Организация = Организация;
		Движение.Сумма = Сумма;
	КонецЕсли;

	// регистр ДенежныеСредства Расход
	Движения.ДенежныеСредства.Записывать = Истина;
	Движение = Движения.ДенежныеСредства.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период = Дата;
	Движение.Организация = Организация;
	Движение.Касса = Касса;
	Движение.Сумма = Сумма;
	Движение.СтатьяДвижения = СтатьяДвижения;
	
	Если ВидОперации = Перечисления.ВидыОперацийРКО.ВозвратПоНомеру Тогда
		Движения.ВзаиморасчетыЗаПроживание.Записывать = Истина;
		Движения.ВзаиморасчетыЗаПроживание.ДобавитьЗадолженность(Дата, Основание.Основание, Сумма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;	
	Ответственный = ЗаполнениеДокументовВызовСервера.ПолучитьТекущегоПользователя();
	
	Если ДанныеЗаполнения = Неопределено Тогда // Ввод нового объекта, заполняем по умолчанию
		
		ВидОперации = Перечисления.ВидыОперацийРКО.ПрочийРасход;
		ЗаполнениеДокументов.ЗаполнитьОбъект(ЭтотОбъект);
		
	Иначе // Заполняем переданными значениями
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры
