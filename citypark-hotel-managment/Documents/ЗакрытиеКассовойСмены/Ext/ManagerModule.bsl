
// Заполняет список команд печати.
//
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Прайс-лист
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.УстановкаЦенПроживания";
	КомандаПечати.Идентификатор = "ПрайсЛист";
	КомандаПечати.Представление = НСтр("ru = 'Прайс-лист'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	// ЗакрытиеСмены
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ЗакрытиеКассовойСмены";
	КомандаПечати.Идентификатор = "ПФ_MXL_ЗакрытиеСменыКассы";
	КомандаПечати.Представление = НСтр("ru = 'Закрытие смены'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;

	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПрайсЛист");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПрайсЛист",
		НСтр("ru = 'Прайс-лист'"),
		ПечатьПрайсЛиста(МассивОбъектов, ОбъектыПечати),
		,
		"Документ.УстановкаЦенПроживания.ПФ_MXL_ПрайсЛист");
	КонецЕсли;
	
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ЗакрытиеСменыКассы");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПФ_MXL_ЗакрытиеСменыКассы",
		НСтр("ru = 'Закрытие смены'"),
		ПечатьЗакрытияСмены(МассивОбъектов, ОбъектыПечати, ПараметрыПечати),
		,
		"Документ.ЗакрытиеКассовойСмены.ПФ_MXL_ЗакрытиеСменыКассы");
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьПрайсЛиста(МассивОбъектов, ОбъектыПечати)
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = УправлениеПечатью.ПолучитьМакет("Документ.УстановкаЦенПроживания.ПФ_MXL_ПрайсЛист");
	ТабДок.Вывести(Макет.ПолучитьОбласть("Шапка"));
	Возврат ТабДок;
	
КонецФункции

Функция ПечатьЗакрытияСмены(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ПолеСлева = 0;
	ТабличныйДокумент.ПолеСправа = 0;
	ТабличныйДокумент.ПолеСнизу = 0;
	ТабличныйДокумент.ПолеСверху = 0;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗакрытиеКассовойСмены";
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	Макет = УправлениеПечатью.ПолучитьМакет("Документ.ЗакрытиеКассовойСмены.ПФ_MXL_ЗакрытиеСменыКассы");
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ЗакрытиеКассовойСмены_ПФ_MXL_ЗакрытиеСменыКассы";
	ЗаполнитьЗначенияСвойств(ТабличныйДокумент, ПараметрыПечати);	
	ТабличныйДокумент.ФиксацияСверху = 0;
	
	
	Запрос = Новый Запрос;
	ЗАпрос.УстановитьПараметр("МассивОбъектов",МассивОбъектов);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗакрытиеКассовойСмены.Ссылка,
	|	ЗакрытиеКассовойСмены.Организация,
	|	ЗакрытиеКассовойСмены.Касса,
	|	ЗакрытиеКассовойСмены.НаНачало,
	|	ЗакрытиеКассовойСмены.НаКонец,
	|	ЗакрытиеКассовойСмены.Недостачи,
	|	ЗакрытиеКассовойСмены.Излишки,
	|	ЗакрытиеКассовойСмены.Приход,
	|	ЗакрытиеКассовойСмены.Расход,
	|	ЗакрытиеКассовойСмены.СменуСдал
	|ИЗ
	|	Документ.ЗакрытиеКассовойСмены КАК ЗакрытиеКассовойСмены
	|ГДЕ
	|	ЗакрытиеКассовойСмены.Ссылка В (&МассивОбъектов)";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыгрузкаЗапроса = РезультатЗапроса.Выгрузить();
	ВыборкаЗапроса = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаЗапроса.Следующий() Цикл
		
		//Логотип	
		ОбластьЛоготип = Макет.ПолучитьОбласть("Логотип");
		ОбластьЛоготип.Параметры.Организация = ВыборкаЗапроса.Организация;
		ОбластьЛоготип.Параметры.Касса = ВыборкаЗапроса.Касса;
		ОбластьЛоготип.Параметры.ВремяПечати = ТекущаяДата();
		
		ТабличныйДокумент.Вывести(ОбластьЛоготип);
		//НаНачало
		
		ОбластьНаНачало = Макет.ПолучитьОбласть("НаНАчало");
		ОбластьНаНачало.Параметры.СуммаНаНачало = ВыборкаЗапроса.НаНачало;
		
		ТабличныйДокумент.Вывести(ОбластьНаНачало);
		
		//Приход
		ОбластьПриход = Макет.получитьОбласть("Приход");
		ОбластьПриход.Параметры.СуммаПриход = ВыборкаЗапроса.Приход;
		ТабличныйДокумент.Вывести(ОбластьПриход);
		ОбластьТаблицаПрихода = Макет.ПолучитьОбласть("ТаблицаПрихода");
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивДокументов", МассивОбъектов);
		Запрос.Текст = "ВЫБРАТЬ
		|	ЗакрытиеКассовойСменыДокументыПрихода.Ссылка,
		|	ЗакрытиеКассовойСменыДокументыПрихода.СтатьяДвижения,
		|	ЗакрытиеКассовойСменыДокументыПрихода.Сумма
		|ИЗ
		|	Документ.ЗакрытиеКассовойСмены.ДокументыПрихода КАК ЗакрытиеКассовойСменыДокументыПрихода
		|ГДЕ
		|	ЗакрытиеКассовойСменыДокументыПрихода.Ссылка В (&МассивДокументов)";
		ВыгрузкаЗапроса = Запрос.Выполнить().Выгрузить();
		
		Для каждого СтрокаВыгрузки Из ВыгрузкаЗапроса Цикл
			
			ОбластьТаблицаПрихода.Параметры.Приход = СтрокаВыгрузки.СтатьяДвижения;
			ОбластьТаблицаПрихода.Параметры.СуммаПриходДок = СтрокаВыгрузки.Сумма;
			ТабличныйДокумент.Вывести(ОбластьТаблицаПрихода);
			
		КонецЦикла;
		
		
		//Расход
		ОбластьТаблицаРасхода = Макет.ПолучитьОбласть("ТаблицаРасхода");
		ОбластьРасход = Макет.ПолучитьОбласть("Расход");
		ОбластьРасход.Параметры.СуммаРасход = ВыборкаЗапроса.Расход;
		ТабличныйДокумент.Вывести(ОбластьРасход);
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
		Запрос.Текст = "ВЫБРАТЬ
		|	ЗакрытиеКассовойСменыДокументыРасхода.Ссылка,
		|	ЗакрытиеКассовойСменыДокументыРасхода.СтатьяДвижения,
		|	ЗакрытиеКассовойСменыДокументыРасхода.Сумма
		|ИЗ
		|	Документ.ЗакрытиеКассовойСмены.ДокументыРасхода КАК ЗакрытиеКассовойСменыДокументыРасхода
		|ГДЕ
		|	ЗакрытиеКассовойСменыДокументыРасхода.Ссылка В (&МассивОбъектов)";
		
		ВыгрузкаЗапроса = Запрос.Выполнить().Выгрузить();
		Для каждого СтрокаВыгрузки Из ВыгрузкаЗапроса Цикл
			
			ОбластьТаблицаРасхода.Параметры.Расход = СтрокаВыгрузки.СтатьяДвижения;
			ОбластьТаблицаРасхода.Параметры.СуммаРасходДок = СтрокаВыгрузки.Сумма;
			ТабличныйДокумент.Вывести(ОбластьТаблицаРасхода);
			
		КонецЦикла;
		
		
		//Недостачи
		ОбластьНедостачи = Макет.ПолучитьОбласть("Недостачи");
		ОбластьНедостачи.Параметры.СуммаНедостачи = ВыборкаЗапроса.Недостачи;
		
		ТабличныйДокумент.Вывести(ОбластьНедостачи);
		
		//Излишки
		ОбластьИзлишки = Макет.ПолучитьОбласть("Излишки");
		ОбластьИзлишки.Параметры.СуммаИзлишки = ВыборкаЗапроса.Излишки;
		
		ТабличныйДокумент.Вывести(ОбластьИзлишки);
		
		//НаКонец
		ОбластьНаКонец = Макет.ПолучитьОбласть("Остаток");
		ОбластьНаКонец.Параметры.СуммаОстаток = ВыборкаЗапроса.НаКонец;
		
		ТабличныйДокумент.Вывести(ОбластьНаКонец);
		
		
		//Ответственный
		
		ФИОКассир = ВыборкаЗапроса.СменуСдал.Фамилия + " " + Лев(ВыборкаЗапроса.СменуСдал.Имя, 1) + "." + Лев(ВыборкаЗапроса.СменуСдал.Отчество, 1) + ".";

		
		ОбластьОтветственный = Макет.ПолучитьОбласть("Ответственный");
		ОбластьОтветственный.Параметры.Ответственный =  ФИОКассир;
		
		ТабличныйДокумент.Вывести(ОбластьОтветственный);	
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;	
	
КонецФункции