
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	НачатьТранзакцию();
	
	Попытка
		
		Движения.ДенежныеСредства.Записывать = Истина;
		
		Если Излишки > 0 Тогда
			Движения.ДенежныеСредства.ДобавитьСуммуПрихода(Дата, Организация, Касса, Излишки, Справочники.СтатьиДвиженияДенежныхСредств.ОприходованиеИзлишков);
		КонецЕсли;
		
		Если Недостачи > 0 Тогда
			Движения.ДенежныеСредства.ДобавитьСуммуРасхода(Дата, Организация, Касса, Недостачи, Справочники.СтатьиДвиженияДенежныхСредств.СписаниеНедостач);
		КонецЕсли;		
		
		Для Каждого ТекДок Из ДокументыПрихода Цикл
			ДокОбъект = ТекДок.Документ.ПолучитьОбъект();
			ДокОбъект.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт;
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЦикла;
		
		Для Каждого ТекДок Из ДокументыРасхода Цикл
			ДокОбъект = ТекДок.Документ.ПолучитьОбъект();
			ДокОбъект.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт;
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
	КонецПопытки;	
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	НачатьТранзакцию();
	
	Попытка
		
		Движения.ДенежныеСредства.Записывать = Истина;
		Движения.ДенежныеСредства.Очистить();
		
		Для Каждого ТекДок Из ДокументыПрихода Цикл
			ДокОбъект = ТекДок.Документ.ПолучитьОбъект();
			ДокОбъект.СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЦикла;
		
		Для Каждого ТекДок Из ДокументыРасхода Цикл
			ДокОбъект = ТекДок.Документ.ПолучитьОбъект();
			ДокОбъект.СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЦикла;

		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;	
	Ответственный = ЗаполнениеДокументовВызовСервера.ПолучитьТекущегоПользователя();
	
	Если ДанныеЗаполнения = Неопределено Тогда // Ввод нового объекта, заполняем по умолчанию
		
		ЗаполнениеДокументовВызовСервера.ЗаполнитьОбъект(ЭтотОбъект);
		
		ПараметрыСмены = УправлениеКассами.ПолучитьПараметрыСмены(Организация, Касса);
		НачалоСмены = ПараметрыСмены.НачалоСмены;
		КонецСмены = ПараметрыСмены.КонецСмены;
		СменуСдал = ЗаполнениеДокументовВызовСервера.ПолучитьЗначениеПользователяПоУмолчанию("ФизическоеЛицо"); 

	Иначе // Заполняем переданными значениями
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		
	КонецЕсли;

КонецПроцедуры
