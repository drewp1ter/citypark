///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 БИЗНЕС-ЛОГИКА НА СЕРВЕРЕ   ///////////////////////////////////////////


&НаСервере
Процедура ПересчитатьПоказателиПоНачалуСмены()

	Разница = Объект.НаНачалоФакт - Объект.НаНачало;
	Если Разница >= 0 Тогда
		Объект.Излишки = Разница;
		Объект.Недостачи = 0;
	ИначеЕсли Разница < 0 Тогда
		Объект.Излишки = 0;
		Объект.Недостачи = Разница * (-1);
	КонецЕсли;

	Объект.НаКонецФакт = Объект.НаНачало + Объект.Приход - Объект.Расход;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьПоказателиПоОкончаниюСмены()

	Разница = Объект.НаКонецФакт - (Объект.НаНачалоФакт + Объект.Приход - Объект.Расход);
	Если Разница >= 0 Тогда
		Объект.Излишки = Разница;
		Объект.Недостачи = 0;
	ИначеЕсли Разница < 0 Тогда
		Объект.Излишки = 0;
		Объект.Недостачи = Разница * (-1);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере()
	
	ПараметрыСмены = УправлениеКассами.ПолучитьСтруктуруДанныхКассыЗаПериод(Объект.НачалоСмены, Объект.КонецСмены, Объект.Организация, Объект.Касса);
	ЗаполнитьЗначенияСвойств(Объект, ПараметрыСмены);
	Объект.НаНачалоФакт = Объект.НаНачало;	
	Объект.НаКонецФакт = Объект.НаКонец;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоСмены);
	Запрос.УстановитьПараметр("КонецПериода", Объект.КонецСмены);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриходныйКассовыйОрдер.Ссылка КАК Документ,
	               |	ПриходныйКассовыйОрдер.Сумма,
	               |	ПриходныйКассовыйОрдер.СтатьяДвижения
	               |ИЗ
	               |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	               |ГДЕ
	               |	ПриходныйКассовыйОрдер.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ПриходныйКассовыйОрдер.Проведен";
	
	Объект.ДокументыПрихода.Очистить();
	Объект.ДокументыПрихода.Загрузить(Запрос.Выполнить().Выгрузить());
	Объект.Приход = Объект.ДокументыПрихода.Итог("Сумма");
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	РасходныйКассовыйОрдер.Ссылка КАК Документ,
	               |	РасходныйКассовыйОрдер.Сумма,
	               |	РасходныйКассовыйОрдер.СтатьяДвижения
	               |ИЗ
	               |	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	               |ГДЕ
	               |	РасходныйКассовыйОрдер.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И РасходныйКассовыйОрдер.Проведен";
	
	Объект.ДокументыРасхода.Очистить();
	Объект.ДокументыРасхода.Загрузить(Запрос.Выполнить().Выгрузить());
	Объект.Расход = Объект.ДокументыРасхода.Итог("Сумма");
	
	//Запрос.Текст = ;
	Объект.НеоплаченныеДокументыПроживания.Очистить();
	
	ПересчитатьПоказателиПоОкончаниюСмены();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыВыбранногоДокумента(ИндексСтроки, Вид)
	
	ПараметрыОткрытия = Новый Структура("Ключ, ТолькоПросмотр", , Истина);
	
	Если Вид = "Приход" Тогда
		ПараметрыОткрытия.Ключ = Объект.ДокументыПрихода[ИндексСтроки].Документ;
	Иначе
		ПараметрыОткрытия.Ключ = Объект.ДокументыРасхода[ИндексСтроки].Документ;
	КонецЕсли;
	
	Возврат ПараметрыОткрытия;
	
КонецФункции

&НаСервере
Процедура УстановитьДоступность()
	
	ЭтаФорма.ТолькоПросмотр = Объект.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт И Не РольДоступна("АдминистраторСистемы");
	
КонецПроцедуры

