
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнениеДокументов.ЗаполнитьШапку(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура РевизияНоменклатураПриИзменении(Элемент)
	
	Если Элементы.Ревизия.ТекущиеДанные <> Неопределено Тогда
		РевизияНоменклатураПриИзмененииНаСервере(Элементы.Ревизия.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РевизияНоменклатураПриИзмененииНаСервере(НомерСтроки)
	
	ТекСтрока = Объект.Ревизия[НомерСтроки];
	ТекСтрока.Цена = Ценообразование.ПолучитьЦенуНоменклатуры(Объект.Дата, Объект.Организация , Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("Цены продажи"),ТекСтрока.Номенклатура, ТекСтрока.Номенклатура.ОсновнаяЕдиницаИзмерения);
	ТекСтрока.Сумма = ТекСтрока.Количество * ТекСтрока.Цена;
	
КонецПроцедуры

&НаКлиенте
Процедура РевизияКоличествоПриИзменении(Элемент)
	
	Если Элементы.Ревизия.ТекущиеДанные <> Неопределено Тогда
		РевизияКоличествоПриИзмененииНаСервере(Элементы.Ревизия.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РевизияКоличествоПриИзмененииНаСервере(НомерСтроки)
	
	ТекСтрока = Объект.Ревизия[НомерСтроки];
	ТекСтрока.Сумма = ТекСтрока.Количество * ТекСтрока.Цена;
	
КонецПроцедуры

&НаКлиенте
Процедура РевизияЦенаПриИзменении(Элемент)
	Если Элементы.Ревизия.ТекущиеДанные <> Неопределено Тогда		
		РевизияЦенаПриИзмененииНаСервере(Элементы.Ревизия.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РевизияЦенаПриИзмененииНаСервере(НомерСтроки)
	
	ТекСтрока = Объект.Ревизия[НомерСтроки];
	ТекСтрока.Сумма = ТекСтрока.Количество * ТекСтрока.Цена;
	
КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)
	
	ЭтотОбъект.Записать();	 
	РассчитатьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьНаСервере()	
	
	Попытка
		ЭтотОбъект.Записать();
	Исключение
		Сообщить("Не удалось записать объект """ + Объект + """!
		|" + ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
	КонецПопытки;

	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
	Запрос.УстановитьПараметр("Дата",Объект.Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОстаткиТМЦОстатки.КоличествоОстаток КАК КоличествоУчет,
	               |	ОстаткиТМЦОстатки.Номенклатура
	               |ПОМЕСТИТЬ ВТ_Остаток
	               |ИЗ
	               |	РегистрНакопления.ОстаткиТМЦ.Остатки(&Дата, ) КАК ОстаткиТМЦОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИнвентаризацияТоваровРевизия.Ссылка,
	               |	ИнвентаризацияТоваровРевизия.Номенклатура,
	               |	ИнвентаризацияТоваровРевизия.Количество КАК КоличествоФакт,
	               |	ИнвентаризацияТоваровРевизия.Цена,
	               |	ИнвентаризацияТоваровРевизия.Сумма
	               |ПОМЕСТИТЬ ВТ_Факт
	               |ИЗ
	               |	Документ.ИнвентаризацияТоваров.Ревизия КАК ИнвентаризацияТоваровРевизия
	               |ГДЕ
	               |	ИнвентаризацияТоваровРевизия.Ссылка.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТ_Факт.Номенклатура,
	               |	ВТ_Факт.КоличествоФакт,
	               |	ВТ_Факт.Цена,
	               |	ВТ_Факт.Сумма,
	               |	ВТ_Остаток.КоличествоУчет
	               |ИЗ
	               |	ВТ_Факт КАК ВТ_Факт
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остаток КАК ВТ_Остаток
	               |		ПО ВТ_Факт.Номенклатура = ВТ_Остаток.Номенклатура";
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	Объект.Товары.Очистить();
	Объект.Оприходование.Очистить();
	Объект.Списание.Очистить();
	
	Выгрузка.Свернуть("Номенклатура,КоличествоУчет, КоличествоФакт, Цена , Сумма");
	
	КоличествоИтогоФакт = 0;
	КоличествоИтогоУчет = 0;
	
	Для каждого СтрокаВыгрузки из Выгрузка Цикл
		
		ТекСтрока = Объект.Товары.Добавить();
		ТекСтрока.Номенклатура = СтрокаВыгрузки.Номенклатура;
		ТекСтрока.КоличествоУчет = СтрокаВыгрузки.КоличествоУчет;
		ТекСтрока.КоличествоФакт = СтрокаВыгрузки.КоличествоФакт;
		ТекСтрока.КоличествоОткл = ТекСтрока.КоличествоФакт - ТекСтрока.КоличествоУчет;   
		ТекСтрока.Цена = СтрокаВыгрузки.Цена;
		ТекСтрока.СуммаФакт = ТекСтрока.КоличествоФакт * ТекСтрока.Цена;
		ТекСтрока.СуммаУчет = ТекСтрока.КоличествоУчет * ТекСтрока.Цена;
		ТекСтрока.СуммаОтклонение = ТекСтрока.СуммаФакт - ТекСтрока.СуммаУчет;
		
		КоличествоИтогоФакт = КоличествоИтогоФакт + ТекСтрока.КоличествоФакт;
		КоличествоИтогоУчет = КоличествоИтогоУчет + ТекСтрока.КоличествоУчет;
		
		
		Если ТекСтрока.КоличествоОткл < 0 Тогда
			
			СтрокаСписания = Объект.Списание.Добавить();
			СтрокаСписания.Номенклатура = ТекСтрока.Номенклатура;
			СтрокаСписания.Количество = ТекСтрока.КоличествоОткл;
			СтрокаСписания.Сумма = ТекСтрока.СуммаОтклонение;
			
		ИначеЕсли ТекСтрока.КоличествоОткл  > 0 Тогда
			
			СтрокаОприходования = Объект.Оприходование.Добавить();
			СтрокаОприходования.Номенклатура = ТекСтрока.Номенклатура;
			СтрокаОприходования.Количество = ТекСтрока.КоличествоОткл;
			СтрокаОприходования.ЦенаОприходования = ТекСтрока.Цена;
			СтрокаОприходования.Сумма = СтрокаОприходования.Количество * СтрокаОприходования.ЦенаОприходования;
			

		КонецЕсли;		
		
	КонецЦикла;
	
	Объект.ОстатокФакт = КоличествоИтогоФакт;
	Объект.ОстатокУчет = КоличествоИтогоУчет;
	Объект.Недостачи = КоличествоИтогоФакт - КоличествоИтогоУчет;
	
	Если Объект.Недостачи > 0 Тогда
		
		Объект.Излишки = Объект.Недостачи;
		Объект.Недостачи = 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПечатьМакет(Команда)
	
	ТабДок = ПолучитьПечатнуюФормуМакет();
	ТабДок.Показать();
	
КонецПроцедуры


&НаСервере
Функция ПолучитьПечатнуюФормуМакет();
	
	ТабДок = Новый ТабличныйДокумент;
	
	ДокОбъект = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.ИнвентаризацияТоваров"));
	Макет = ДокОбъект.ПолучитьМакет("Макет");
	
	Область = Макет.ПолучитьОбласть("Шапка");
	Область.Параметры.Заполнить(Объект);
	ТабДок.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("Параметры");
	Область.Параметры.Заполнить(Объект);
	ТабДок.Вывести(Область);
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		Область = Макет.ПолучитьОбласть("Заполнения");
		Область.Параметры.Заполнить(СтрокаТЧ);
		ТабДок.Вывести(Область);
	КонецЦикла;
	
	  Область = Макет.ПолучитьОбласть("заполнение1");
	Область.Параметры.Заполнить(Объект);
	ТабДок.Вывести(Область);
	
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.Защита = Истина;
	Возврат ТабДок;
	
КонецФункции





