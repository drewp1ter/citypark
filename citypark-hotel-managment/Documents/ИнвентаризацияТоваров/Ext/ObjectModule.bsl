
Процедура ОбработкаПроведения(Отказ, Режим)

	// регистр ОстаткиТМЦ Приход
	Движения.ОстаткиТМЦ.Записывать = Истина;
	Для Каждого ТекСтрокаОприходование Из Оприходование Цикл
		Движение = Движения.ОстаткиТМЦ.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Склад = Склад;
		Движение.Партия = Ссылка;
		Движение.Номенклатура = ТекСтрокаОприходование.Номенклатура;
		Движение.Количество = ТекСтрокаОприходование.Количество;
		Движение.Сумма = ТекСтрокаОприходование.Сумма;
	КонецЦикла;
	
	//списание
	Движения.ОстаткиТМЦ.Записывать = Истина;
	Для Каждого ТекСтрокаСписание Из Списание Цикл
		Движение = Движения.ОстаткиТМЦ.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Склад = Склад;
		Движение.Партия = Ссылка;
		Движение.Номенклатура = ТекСтрокаСписание.Номенклатура;
		Движение.Количество = ТекСтрокаСписание.Количество;
		Движение.Сумма = ТекСтрокаСписание.Сумма;
	КонецЦикла;
КонецПроцедуры
