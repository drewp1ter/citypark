&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Организация
	ЭтаФорма.Список.КомпоновщикНастроек.Настройки.Отбор.Элементы[0].ПравоеЗначение = Параметры.Организация;
	ЭтаФорма.Список.КомпоновщикНастроек.Настройки.Отбор.Элементы[0].Использование = ЗначениеЗаполнено(Параметры.Организация);
	
	// Корпус
	ЭтаФорма.Список.КомпоновщикНастроек.Настройки.Отбор.Элементы[1].ПравоеЗначение = Параметры.ГостиничныйКорпус;
	ЭтаФорма.Список.КомпоновщикНастроек.Настройки.Отбор.Элементы[1].Использование = ЗначениеЗаполнено(Параметры.ГостиничныйКорпус);
	
	// Статус
	ЭтаФорма.Список.КомпоновщикНастроек.Настройки.Отбор.Элементы[2].ПравоеЗначение = Перечисления.СтатусыДокументов.Открыт;
	ЭтаФорма.Список.КомпоновщикНастроек.Настройки.Отбор.Элементы[2].Использование = Истина;
	
КонецПроцедуры


