&НаКлиенте
Процедура КартаСоздана(Результат, Параметры) Экспорт
	
КонецПроцедуры

&НаКлиенте
Процедура ПользовательОтветилНаНеобходимостьПроведенияДокумента(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ПараметрыЗаписи = Новый Структура("РежимЗаписиДокумента", РежимЗаписиДокумента.Проведение);
		Записать(ПараметрыЗаписи);
		ОбновитьСтатусЗадолженности();
		ВыполнитьОплатуДокумента();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПользовательСовершилОплату(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		Если ДокументыСозданыУспешно(Результат) Тогда
			ОбновитьСтатусЗадолженности();
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПользовательВернулДенежныеСредства(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьСтатусЗадолженности();
	
КонецПроцедуры


