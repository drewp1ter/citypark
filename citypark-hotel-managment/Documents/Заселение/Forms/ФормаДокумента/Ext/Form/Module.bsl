&НаКлиенте
Процедура КомандаСоздатьКарту(Команда)
		
	//ПараметрыОткрытия = Новый Структура("ДатаВыселения, ГостиничныйНомер", Объект.ДатаВыселения, Объект.ГостиничныйНомер);
	//ОткрытьФорму("Обработка.СозданиеКартГостиница.Форма", ПараметрыОткрытия);
	
	ОповещениеОСозданииКарты = Новый  ОписаниеОповещения("КартаСоздана", ЭтаФорма);
	ПараметрыСозданияКарты = Новый Структура;
	ПараметрыСозданияКарты.Вставить("ГостиничныйНомер", Объект.ГостиничныйНомер);
	ПараметрыСозданияКарты.Вставить("ДатаВыселения", Объект.ДатаВыселения);
	
	МенеджерОборудованияУправлениеГостиницейКлиент.НачатьСозданиеКарты(ОповещениеОСозданииКарты, УникальныйИдентификатор, ПараметрыСозданияКарты);
	
КонецПроцедуры  

&НаКлиенте
Процедура КомандаСоздатьКопиюКарты(Команда)
	
	ОповещениеОСозданииКарты = Новый  ОписаниеОповещения("КартаСоздана", ЭтаФорма);
	ПараметрыСозданияКарты = Новый Структура;
	ПараметрыСозданияКарты.Вставить("ГостиничныйНомер", Объект.ГостиничныйНомер);
	ПараметрыСозданияКарты.Вставить("ДатаВыселения", Объект.ДатаВыселения);	
	
	МенеджерОборудованияУправлениеГостиницейКлиент.НачатьСозданиеКопииКарты(ОповещениеОСозданииКарты, УникальныйИдентификатор, ПараметрыСозданияКарты);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОплатить(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ВыполнитьОплатуДокумента();
		
	Иначе
		
		ОповещениеОбОтветеПользователя = Новый ОписаниеОповещения("ПользовательОтветилНаНеобходимостьПроведенияДокумента", ЭтаФорма);
	    ПоказатьВопрос(ОповещениеОбОтветеПользователя, "Перед оплатой документ необходимо записать. Записать?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;	        	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыселение(Команда)
	
	ДопПараметры = Новый Структура("Основание", Объект.Ссылка);
	ОткрытьФорму("Документ.Выселение.Форма.ФормаДокумента", ДопПараметры);
		
КонецПроцедуры


