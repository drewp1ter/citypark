
// Заполняет список команд печати.
//
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Прайс-лист
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.Заселение";
	КомандаПечати.Идентификатор = "СчетЗаПроживание";
	КомандаПечати.Представление = НСтр("ru = 'Счет за проживание'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетЗаПроживание");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"СчетЗаПроживание",
		НСтр("ru = 'Счет за проживание'"),
		ВыводМакетаСчетЗаПроживание(МассивОбъектов, ОбъектыПечати),
		,
		"Документ.Заселение.ПФ_MXL_СчетЗаПроживание");
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаСервере
Функция ВыводМакетаСчетЗаПроживание(МассивОбъектов, ОбъектыПечати)
	
	Документ = МассивОбъектов[0];	
	ТабДок = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("ПФ_MXL_СчетЗаПроживание");
	
	Область = Макет.ПолучитьОбласть("Шапка");
	Область.Параметры.Заполнить(Документ.Ссылка);
	
	Область.Параметры.ДатаЗаезда = Формат(Документ.ДатаЗаселения,"ДФ=dd.MM.yyyy");
	Область.Параметры.ДатаВыезда = Формат(Документ.ДатаВыселения,"ДФ=dd.MM.yyyy");
	Область.Параметры.Гость = "ФИО : " + Документ.Контрагент;
	Область.Параметры.Комната = Документ.ГостиничныйНомер;
	Область.Параметры.ДатаЗаезда =  Формат(Документ.ДатаЗаселения, "ДЛФ=D");
	Область.Параметры.Номер = Документ.ГостиничныйНомер;
	
	Для каждого СтрокаТч из Документ.Стоимость Цикл
		
		Область.Параметры.Сумма = СтрокаТЧ.Сумма;
		Область.Параметры.Стоимость  = СтрокаТЧ.Цена;
		Область.Параметры.количествоДней = Строкатч.Количество;
		ТабДок.Вывести(Область);
		
	КонецЦикла; 	
	
	Область = Макет.ПолучитьОбласть("Подвал");		
	Область.Параметры.СуммаДокумента = Документ.Сумма;
	Область.Параметры.СуммаПрописью = ЧислоПрописью(Документ.Сумма, ,"рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2");
	Область.Параметры.Ответственный = Документ.Ответственный;
	
	ТабДок.Вывести(Область);
	
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.Защита = Истина;
	
	Возврат ТабДок; 	
	
КонецФункции
