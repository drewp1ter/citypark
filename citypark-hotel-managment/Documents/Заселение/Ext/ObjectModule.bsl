
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
		
	НачатьТранзакцию();
		

	
	Если ЗначениеЗаполнено(Основание) И Основание.СтатусДокумента <> Перечисления.СтатусыДокументов.Закрыт Тогда
		
		ДокументЗаселения = Основание.ПолучитьОбъект();
		ДокументЗаселения.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт;
		ДокументЗаселения.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЕсли;
	
	
	Если Не Отказ И СтатусДокумента = Перечисления.СтатусыДокументов.Открыт Тогда
					
		// СостояниеНомеров
		Отказ = Не УправлениеЗаселением.НомерСвободенВДанномПериоде(ТекущаяДата(), ДатаЗаселения, ДатаВыселения, Организация, ГостиничныйНомер, Основание);
	
		Движения.СостояниеНомеров.Записывать = Истина;
		Для Каждого СтрокаПроживания Из Проживание Цикл			
			Движения.СостояниеНомеров.ДобавитьДвижение(Дата, Организация, ГостиничныйНомер, СтрокаПроживания.НачалоПериода, СтрокаПроживания.КонецПериода, Перечисления.ВидыСостоянийНомеров.Занят);
		КонецЦикла;

		// Взаиморасчеты
		Движения.ВзаиморасчетыЗаПроживание.Записывать = Истина;
		НомерСтроки = 1;
		Для Каждого СтрокаСтоимости Из Стоимость Цикл
			
			ЭтоПоследняяСтрока = НомерСтроки = Стоимость.Количество();
			Если ЭтоПоследняяСтрока Тогда
				Движения.ВзаиморасчетыЗаПроживание.ДобавитьЗадолженностьПоТарифамДляПоследнейСтроки(СтрокаСтоимости.НачалоПериода, СтрокаСтоимости.КонецПериода, Ссылка, СтрокаСтоимости.Тариф, СтрокаСтоимости.Количество, СтрокаСтоимости.Цена);		
			Иначе				
				Движения.ВзаиморасчетыЗаПроживание.ДобавитьЗадолженностьПоТарифам(СтрокаСтоимости.НачалоПериода, Ссылка, СтрокаСтоимости.Тариф, СтрокаСтоимости.Количество, СтрокаСтоимости.Цена);
			КонецЕсли;
			
			НомерСтроки = НомерСтроки + 1;			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Отказ Тогда
		ОтменитьТранзакцию();
	Иначе
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
		
	Движения.СостояниеНомеров.Очистить();
	Движения.СостояниеНомеров.Записать();
	
	Движения.ВзаиморасчетыЗаПроживание.Очистить();
	Движения.ВзаиморасчетыЗаПроживание.Записать();

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;		
	
	Если ДанныеЗаполнения = Неопределено Тогда // Ввод нового объекта, заполняем по умолчанию
		
		ЗаполнениеДокументовВызовСервера.ЗаполнитьОбъект(ЭтотОбъект);
		ТипЦен = ГостиничныйКорпус.ТипЦен;
		КоличествоГостей = 1;
		ДатаЗаселения = ТекущаяДата();
		
		// Добавляем проживание
		НоваяСтрокаПроживания = Проживание.Добавить();
		НоваяСтрокаПроживания.НачалоПериода = ДатаЗаселения;
		НоваяСтрокаПроживания.Тариф = Справочники.ТарифыПроживания.Сутки;
		НоваяСтрокаПроживания.Количество = 1;
		НоваяСтрокаПроживания.КонецПериода = УправлениеЗаселением.РассчитатьДатуПоТарифу(НоваяСтрокаПроживания.НачалоПериода, НоваяСтрокаПроживания.Тариф, 1);
		ДатаВыселения = НоваяСтрокаПроживания.КонецПериода;

		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Бронирование") Тогда 
		                             		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		Основание = ДанныеЗаполнения;
		КоличествоГостей = 1;
		
		Номер = "";
		Проживание.Загрузить(ДанныеЗаполнения.Проживание.Выгрузить());
		Стоимость.Загрузить(ДанныеЗаполнения.Стоимость.Выгрузить());
		Ценообразование.ЗаполнитьТаблицуСтоимостиПроживания(Организация, ТипЦен, ГостиничныйНомер.ТипНомера, Проживание, Стоимость);
		Сумма = Стоимость.Итог("Сумма");	
		
	Иначе // Заполняем переданными значениями
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		ТипЦен = ГостиничныйКорпус.ТипЦен;
		КоличествоГостей = 1;
		
		// Добавляем проживание
		НоваяСтрокаПроживания = Проживание.Добавить();
		НоваяСтрокаПроживания.НачалоПериода = ДатаЗаселения;
		НоваяСтрокаПроживания.Тариф = Справочники.ТарифыПроживания.Сутки;
		НоваяСтрокаПроживания.Количество = 1;
		НоваяСтрокаПроживания.КонецПериода = УправлениеЗаселением.РассчитатьДатуПоТарифу(НоваяСтрокаПроживания.НачалоПериода, НоваяСтрокаПроживания.Тариф, 1);
		ДатаВыселения = НоваяСтрокаПроживания.КонецПериода;

	КонецЕсли;	
	
	Ответственный = ЗаполнениеДокументовВызовСервера.ПолучитьТекущегоПользователя();

КонецПроцедуры
