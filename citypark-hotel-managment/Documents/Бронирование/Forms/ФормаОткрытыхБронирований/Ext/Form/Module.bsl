&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Организация
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Организация", Параметры.Организация,,, Истина);
	
	КонецЕсли;
	
	// Корпус
	Если ЗначениеЗаполнено(Параметры.ГостиничныйКорпус) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ГостиничныйКорпус", Параметры.ГостиничныйКорпус,,, Истина);

	КонецЕсли;
	
	// Статус документа
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "СтатусДокумента", Перечисления.СтатусыДокументов.Открыт,,, Истина);
	
КонецПроцедуры


