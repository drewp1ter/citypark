///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ ФОРМЫ    /////////////////////////////////////////////////


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступность();
	фДатаЗаселения = Объект.ДатаЗаселения;
	
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ РЕКВИЗИТОВ ФОРМЫ   ///////////////////////////////////////


&НаКлиенте
Процедура ДатаЗаселенияПриИзменении(Элемент)
	
	УправлениеЗаселением.ОбработатьИзменениеДатыЗаселения(Объект.ДатаЗаселения, фДатаЗаселения);
	ПересчитатьДатыВыселения();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаВыселенияПриИзменении(Элемент)
	
	ДатаВыселенияПриИзмененииНаСервере();
	
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ ТАБЛИЧНЫХ ЧАСТЕЙ ФОРМЫ    ////////////////////////////////


&НаКлиенте
Процедура ПроживаниеКоличествоПриИзменении(Элемент)
	
	ПересчитатьДатыВыселения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроживаниеТарифПриИзменении(Элемент)
	
	ПересчитатьДатыВыселения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроживаниеНачалоПериодаПриИзменении(Элемент)
	
	Если Элементы.Проживание.ТекущиеДанные <> Неопределено Тогда
		ИндексСтроки = Элементы.Проживание.ТекущиеДанные.НомерСтроки - 1;
		Если ИндексСтроки = 0 Тогда
			
			УправлениеЗаселением.ОбработатьИзменениеДатыЗаселения(Объект.Проживание[0].НачалоПериода, фДатаЗаселения);
			УстановитьДатуЗаселенияПоНачалуПериодаПроживанияНаСервере(ИндексСтроки);
			
		КонецЕсли;
	КонецЕсли;
	
	ПересчитатьДатыВыселения();
	
КонецПроцедуры


