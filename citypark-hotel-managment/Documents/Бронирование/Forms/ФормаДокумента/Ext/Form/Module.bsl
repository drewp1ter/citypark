#Область НаСервере

///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 БИЗНЕС-ЛОГИКА НА СЕРВЕРЕ   ///////////////////////////////////////////


&НаСервере
Процедура ПересчитатьДатыВыселения()
	
	СтартоваяДата = Объект.ДатаЗаселения;
	
	Для Каждого ТекСтрока Из Объект.Проживание Цикл
					
		ТекСтрока.НачалоПериода = СтартоваяДата;
		ТекСтрока.КонецПериода = УправлениеЗаселением.РассчитатьДатуПоТарифу(ТекСтрока.НачалоПериода, ТекСтрока.Тариф, ТекСтрока.Количество);
		СтартоваяДата = ТекСтрока.КонецПериода;
				
		Если ТекСтрока.НомерСтроки = Объект.Проживание.Количество() Тогда
			Объект.ДатаВыселения = ТекСтрока.КонецПериода;
		КонецЕсли;
		
	КонецЦикла;
	
	ПересчитатьСтоимость();
		
КонецПроцедуры

&НаСервере 
Процедура ПересчитатьСтоимость()

	Ценообразование.ЗаполнитьТаблицуСтоимостиПроживания(Объект.Организация, Объект.ТипЦен, Объект.ГостиничныйНомер.ТипНомера, Объект.Проживание, Объект.Стоимость);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДатуЗаселенияПоНачалуПериодаПроживанияНаСервере(ИндексСтроки)
	
	Объект.ДатаЗаселения = Объект.Проживание[ИндексСтроки].НачалоПериода;
	
КонецПроцедуры

&НаСервере
Процедура ДатаВыселенияПриИзмененииНаСервере()
	
	Объект.ДатаВыселения = УправлениеЗаселением.ПолучитьДатуИВремяВыселения(Объект.ДатаВыселения);
	
	Объект.Проживание.Очистить();
	НоваяСтрока = Объект.Проживание.Добавить();
	НоваяСтрока.НачалоПериода = Объект.ДатаЗаселения;
	НоваяСтрока.Тариф = Справочники.ТарифыПроживания.Сутки;
	НоваяСтрока.КонецПериода = Объект.ДатаВыселения;
	НоваяСтрока.Количество = УправлениеЗаселением.РассчитатьКоличествоЕдиницТарифаПоДатам(Объект.ДатаЗаселения, Объект.ДатаВыселения, НоваяСтрока.Тариф);
	
	ПересчитатьСтоимость();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступность()
	
	ЭтаФорма.ТолькоПросмотр = ЭтаФорма.ТолькоПросмотр ИЛИ (Объект.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт И Не РольДоступна("АдминистраторСистемы"));
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ ФОРМЫ   		///////////////////////////////////////////


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

	// СтандартныеПодсистемы.Печать
	УправлениеПечатью.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Печать
			
КонецПроцедуры


