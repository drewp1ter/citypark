
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.УборкаНомеров.Записывать = Истина;
	Движение = Движения.УборкаНомеров.Добавить();
	Движение.Период = Дата;
	Движение.Убран = Истина ;
	Движение.ГостиничныйНомер = ГостиничныйНомер;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		
		ГостиничныйНомер = ДанныеЗаполнения.ГостиничныйНомер;
		
	КонецЕсли;
	
КонецПроцедуры
