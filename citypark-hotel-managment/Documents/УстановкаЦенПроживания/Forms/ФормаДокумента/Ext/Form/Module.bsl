///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 БИЗНЕС-ЛОГИКА НА СЕРВЕРЕ   ///////////////////////////////////////////


&НаСервере
Процедура ПересчитатьСезонныеЦены(ИндексСтроки)
	
	Тарификатор = Объект.ТипЦен.СезонныйТариф;  	
	ТекСтрока = Объект.Цены[ИндексСтроки]; 	
	
	ТекСтрока.Январь = ТекСтрока.Цена * Тарификатор.Январь;
	ТекСтрока.Февраль = ТекСтрока.Цена * Тарификатор.Февраль;
	ТекСтрока.Март = ТекСтрока.Цена * Тарификатор.Март;
	ТекСтрока.Апрель = ТекСтрока.Цена * Тарификатор.Апрель;
	ТекСтрока.Май = ТекСтрока.Цена * Тарификатор.Май;
	ТекСтрока.Июнь = ТекСтрока.Цена * Тарификатор.Июнь;
	ТекСтрока.Июль = ТекСтрока.Цена * Тарификатор.Июль;
	ТекСтрока.Август = ТекСтрока.Цена * Тарификатор.Август;
	ТекСтрока.Сентябрь = ТекСтрока.Цена * Тарификатор.Сентябрь;
	ТекСтрока.Октябрь = ТекСтрока.Цена * Тарификатор.Октябрь;
	ТекСтрока.Ноябрь = ТекСтрока.Цена * Тарификатор.Ноябрь;
	ТекСтрока.Декабрь = ТекСтрока.Цена * Тарификатор.Декабрь;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	
	ЭтоСезонныеЦены = Объект.ТипЦен.ТипЦенообразования = Перечисления.ТипЦенообразованияПроживания.Сезонный;
	
	Элементы.СезонныеЦеныЯнварь.Видимость = ЭтоСезонныеЦены;
	Элементы.СезонныеЦеныФевраль.Видимость = ЭтоСезонныеЦены;
	Элементы.СезонныеЦеныМарт.Видимость = ЭтоСезонныеЦены;
	Элементы.СезонныеЦеныАпрель.Видимость = ЭтоСезонныеЦены;
	Элементы.СезонныеЦеныМай.Видимость = ЭтоСезонныеЦены;
	Элементы.СезонныеЦеныИюнь.Видимость = ЭтоСезонныеЦены;
	Элементы.СезонныеЦеныИюль.Видимость = ЭтоСезонныеЦены;
	Элементы.СезонныеЦеныАвгуст.Видимость = ЭтоСезонныеЦены;
	Элементы.СезонныеЦеныСентябрь.Видимость = ЭтоСезонныеЦены;
	Элементы.СезонныеЦеныОктябрь.Видимость = ЭтоСезонныеЦены;
	Элементы.СезонныеЦеныНоябрь.Видимость = ЭтоСезонныеЦены;
	Элементы.СезонныеЦеныДекабрь.Видимость = ЭтоСезонныеЦены;
	
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ ФОРМЫ   		///////////////////////////////////////////


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

	// СтандартныеПодсистемы.Печать
	УправлениеПечатью.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Печать
	
	ЗаполнениеДокументов.ЗаполнитьШапку(Объект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры


