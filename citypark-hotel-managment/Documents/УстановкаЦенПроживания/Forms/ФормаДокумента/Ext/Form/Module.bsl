&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимость();
	
КонецПроцедуры   


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ РЕКВИЗИТОВ ФОРМЫ   ///////////////////////////////////////


&НаКлиенте
Процедура ТипЦенПриИзменении(Элемент)
	
	УстановитьВидимость();
	
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ ТАБЛИЧНЫХ ЧАСТЕЙ ФОРМЫ    ////////////////////////////////


&НаКлиенте
Процедура СезонныеЦеныТипНомераПриИзменении(Элемент)
	
	Если Элементы.Цены.ТекущиеДанные <> Неопределено Тогда
		ПересчитатьСезонныеЦены(Элементы.Цены.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СезонныеЦеныТарифПриИзменении(Элемент)
	
	Если Элементы.Цены.ТекущиеДанные <> Неопределено Тогда
		ПересчитатьСезонныеЦены(Элементы.Цены.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СезонныеЦеныЦенаПриИзменении(Элемент)
	
	Если Элементы.Цены.ТекущиеДанные <> Неопределено Тогда
		ПересчитатьСезонныеЦены(Элементы.Цены.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;
	
КонецПроцедуры


