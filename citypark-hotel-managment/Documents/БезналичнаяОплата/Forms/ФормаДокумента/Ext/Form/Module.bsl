&НаКлиенте
Процедура ДатаОтменыОткрытие(Элемент, СтандартнаяОбработка)
	
	 Объект.ДатаОтмены = ТекущаяДата();
	 
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ,Элемент ,СтандартнаяОбработка)
		
	Если Объект.Сторн = Истина тогда
		Элементы.Сторн1.Видимость = Истина;
	Иначе
		Элементы.Сторн1.Видимость = Ложь;
	Конецесли;
	
    ДатаОтменыОткрытие(Элемент ,СтандартнаяОбработка);

КонецПроцедуры





