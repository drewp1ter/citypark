
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	НачатьТранзакцию();
	
	Если ЗначениеЗаполнено(Основание) И Основание.СтатусДокумента <> Перечисления.СтатусыДокументов.Закрыт Тогда
		
		Попытка
			
			ДокументБронирования = Основание.ПолучитьОбъект();
			ДокументБронирования.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт;
			ДокументБронирования.Записать(РежимЗаписиДокумента.Проведение);
			
		Исключение
			Отказ = Истина;
		КонецПопытки;
		
	КонецЕсли;       

	Если Отказ Тогда
		ОтменитьТранзакцию();
	Иначе
		ЗафиксироватьТранзакцию();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если Не Отказ Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		ДокументБронирования = Основание.ПолучитьОбъект();
		ДокументБронирования.СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;
		Попытка
			ДокументБронирования.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Отказ = Истина;
		КонецПопытки;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли; 

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Ответственный = ЗаполнениеДокументовВызовСервера.ПолучитьТекущегоПользователя();
	
	Если ДанныеЗаполнения = Неопределено Тогда // Ввод нового объекта, заполняем по умолчанию
		
		ЗаполнениеДокументовВызовСервера.ЗаполнитьОбъект(ЭтотОбъект);		
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Бронирование") Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		Основание = ДанныеЗаполнения;
		
	КонецЕсли;

КонецПроцедуры
