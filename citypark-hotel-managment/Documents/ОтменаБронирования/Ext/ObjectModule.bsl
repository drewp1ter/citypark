
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ОнлайнБронирование.ЗаблокироватьДокумент(ЭтотОбъект);
	// Запись документа уже выполняется в транзакции платформы.
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Основание) И Основание.СтатусДокумента <> Перечисления.СтатусыДокументов.Закрыт Тогда
		ДокументБронирования = Основание.ПолучитьОбъект();
		ДокументБронирования.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт;
		ДокументБронирования.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ОнлайнБронирование.ЗаблокироватьДокумент(ЭтотОбъект);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ДокументБронирования = Основание.ПолучитьОбъект();
	// Проверяем конфликт под общей блокировкой до записи основания.
	Если Не УправлениеЗаселением.НомерСвободенВДанномПериоде(ТекущаяДата(),
		ДокументБронирования.ДатаЗаселения, ДокументБронирования.ДатаВыселения,
		ДокументБронирования.Организация, ДокументБронирования.ГостиничныйНомер, Основание) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ПрежнийПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ДокументБронирования.СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;
		ДокументБронирования.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийПривилегированныйРежим);
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Ответственный = ЗаполнениеДокументовВызовСервера.ПолучитьТекущегоПользователя();
	
	Если ДанныеЗаполнения = Неопределено Тогда // Ввод нового объекта, заполняем по умолчанию
		
		ЗаполнениеДокументовВызовСервера.ЗаполнитьОбъект(ЭтотОбъект);		
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Бронирование") Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		Основание = ДанныеЗаполнения;
		
	КонецЕсли;

КонецПроцедуры


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	ОнлайнБронирование.ЗаблокироватьДокумент(ЭтотОбъект);
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	ОнлайнБронирование.ЗаблокироватьДокумент(ЭтотОбъект);
КонецПроцедуры
