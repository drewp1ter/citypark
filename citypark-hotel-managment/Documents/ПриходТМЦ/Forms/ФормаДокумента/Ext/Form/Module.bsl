
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнениеДокументов.ЗаполнитьШапку(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	Если Элементы.Товары.ТекущиеДанные <> Неопределено Тогда
		ТоварыНоменклатураПриИзмененииНаСервере(Элементы.Товары.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;
	
 	  ПересчитатьСумму()


КонецПроцедуры

&НаСервере
Процедура ТоварыНоменклатураПриИзмененииНаСервере(НомерСтроки)
	
	ТекСтрока = Объект.Товары[НомерСтроки];
	ТекСтрока.ЕдиницаИзмерения = ТекСтрока.Номенклатура.ОсновнаяЕдиницаИзмерения;
	ТекСтрока.Коэффициент = ТекСтрока.ЕдиницаИзмерения.Коэффициент;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияПриИзменении(Элемент)
		
	Если Элементы.Товары.ТекущиеДанные <> Неопределено Тогда
		ТоварыЕдиницаИзмеренияПриИзмененииНаСервере(Элементы.Товары.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;

КонецПроцедуры


&НаСервере
Процедура ТоварыЕдиницаИзмеренияПриИзмененииНаСервере(НомерСтроки)
	
	ТекСтрока = Объект.Товары[НомерСтроки];
	ТекСтрока.Коэффициент = ТекСтрока.ЕдиницаИзмерения.Коэффициент;
		
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество;
	ПересчитатьСумму()
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество;
	ПересчитатьСумму()

КонецПроцедуры

&НаКлиенте
Процедура ТоварыСуммаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТабличнойЧасти.Количество >0 Тогда
		СтрокаТабличнойЧасти.Цена = СтрокаТабличнойЧасти.Сумма /  СтрокаТабличнойЧасти.Количество;
	КонецЕсли;
	
	    Сумма = 0;		
	Для каждого СтрокаТЧ из ОБъект.Товары Цикл
		
		Сумма = СТрокаТЧ.Сумма + Сумма;
		
	КонецЦикла;
	
	ПересчитатьСумму()

	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПересчитатьСумму()

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСумму()
	
	Сумма = 0;		
	Для каждого СтрокаТЧ из ОБъект.Товары Цикл
		
		Сумма = СТрокаТЧ.Сумма + Сумма;
		
	КонецЦикла;
	
	Объект.СуммаДокумента = Сумма;

	
КонецПРоцедуры
