
// Заполняет список команд печати.
//
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Прайс-лист
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.Выселение";
	КомандаПечати.Идентификатор = "ПечатьФормыБО18";
	КомандаПечати.Представление = НСтр("ru = 'Форма БО 18'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	//3Г
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.Выселение";
	КомандаПечати.Идентификатор = "ПечатьФормы3Г";
	КомандаПечати.Представление = НСтр("ru = 'Форма 3 Г'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;

	//Анкета
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.Выселение";
	КомандаПечати.Идентификатор = "ПечатьФормыАнкета";
	КомандаПечати.Представление = НСтр("ru = 'Форма Анкета'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;

	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПечатьФормыБО18");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПечатьФормыБО18",
		НСтр("ru = 'Форма БО 18'"),
		ПечатьФормыБО18(МассивОбъектов, ОбъектыПечати),
		,
		"Документ.Выселение.ПФ_MXL_БО18");
	КонецЕсли;
	
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПечатьФормы3Г");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПечатьФормы3Г",
		НСтр("ru = 'Форма 3 Г'"),
		ПечатьФормы3Г(МассивОбъектов, ОбъектыПечати),
		,
		"Документ.Выселение.ПФ_MXL_3Г");
	КонецЕсли;
	
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПечатьФормыАнкета");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПечатьФормыАнкета",
		НСтр("ru = 'Форма Анкета'"),
		ПечатьФормыАнкета(МассивОбъектов, ОбъектыПечати),
		,
		"Документ.Выселение.ПФ_MXL_Анкета");
	КонецЕсли;


	
КонецПроцедуры

Функция ПечатьФормыБО18(МассивОбъектов, ОбъектыПечати)
	
	// Создаем табличный документ и устанавливаем имя параметров печати.
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_Выселение";
	
	Макет = УправлениеПечатью.ПолучитьМакет("Документ.Выселение.ПФ_MXL_БО18");
	
	// Получаем запросом необходимые данные.
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	Выселение.Ссылка,
	               |	Выселение.ВерсияДанных,
	               |	Выселение.ПометкаУдаления,
	               |	Выселение.Номер,
	               |	Выселение.Дата,
	               |	Выселение.Проведен,
	               |	Выселение.ГостиничныйКорпус.НомерНаПечать КАК ГостиничныйКорпус,
	               |	Выселение.ГостиничныйНомер.НомерНаПечать КАК ГостиничныйНомер,
	               |	Выселение.ДатаЗаселения,
	               |	Выселение.ДатаВыселения,
	               |	Выселение.Комментарий,
	               |	Выселение.Контрагент,
	               |	Выселение.Организация,
	               |	Выселение.Основание,
	               |	Выселение.Ответственный,
	               |	Выселение.ПричинаРаннегоСъезда,
	               |	Выселение.Сумма,
	               |	Выселение.ТипЦен,
	               |	Выселение.Стоимость.(
	               |		Ссылка,
	               |		НомерСтроки,
	               |		НачалоПериода,
	               |		Тариф,
	               |		Количество,
	               |		Цена,
	               |		Сумма,
	               |		КонецПериода
	               |	),
	               |	Выселение.Валюта
	               |ИЗ
	               |	Документ.Выселение КАК Выселение
	               |ГДЕ
	               |	Выселение.Ссылка В(&МассивОбъектов)";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Шапка = Запрос.Выполнить().Выбрать();
	ПервыйДокумент = Истина;
	
	Пока Шапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Сумма = 0;
		// Вывод шапки
		Область = Макет.ПолучитьОбласть("Шапка");
		Область.Параметры.Заполнить(Шапка);
		Область.Параметры.Номер = ПрефиксацияОбъектовКлиентСервер.ПолучитьНомерНаПечать(Шапка.Номер, Истина);		
		
		ТабличныйДокумент.Вывести(Область);
		
		// Вывод таблицы проживания
		ТаблицаПроживания = Шапка.Стоимость.Выгрузить();		
		НомерПоПорядку = 4;
		Для Каждого СтрокаТч Из ТаблицаПроживания Цикл
			
			Область = Макет.ПолучитьОбласть("СтрокаПроживания");
			Область.Параметры.Заполнить(СтрокаТч);
			Область.Параметры.НомерПоПорядку = НомерПоПорядку;
			ТабличныйДокумент.Вывести(Область);
			
			Сумма = Сумма + СтрокаТч.Сумма;
			НомерПоПорядку = НомерПоПорядку + 1;
			
		КонецЦикла;
		
		// Вывод заказов		
		ЗапросЗаказов = Новый Запрос;
		ЗапросЗаказов.УстановитьПараметр("ДокументРасчетов", Шапка.Основание);
		ЗапросЗаказов.Текст = "ВЫБРАТЬ
		                      |	ЧекККМТовары.Номенклатура,
		                      |	ЧекККМТовары.ЕдиницаИзмерения,
		                      |	СУММА(ЧекККМТовары.Количество) КАК Количество,
		                      |	ЧекККМТовары.Цена,
		                      |	СУММА(ЧекККМТовары.Сумма) КАК Сумма
		                      |ИЗ
		                      |	Документ.ЧекККМ.Товары КАК ЧекККМТовары
		                      |ГДЕ
		                      |	ЧекККМТовары.Ссылка.Основание = &ДокументРасчетов
		                      |
		                      |СГРУППИРОВАТЬ ПО
		                      |	ЧекККМТовары.ЕдиницаИзмерения,
		                      |	ЧекККМТовары.Номенклатура,
		                      |	ЧекККМТовары.Цена";
		
		ТаблицаЗаказов = ЗапросЗаказов.Выполнить().Выгрузить();
		
		Для Каждого СтрокаЗаказа Из ТаблицаЗаказов Цикл
			
			Область = Макет.ПолучитьОбласть("СтрокаЗаказа");
			Область.Параметры.Заполнить(СтрокаЗаказа);
			Область.Параметры.НомерПоПорядку = НомерПоПорядку;
			ТабличныйДокумент.Вывести(Область);
			
			Сумма = Сумма + СтрокаЗаказа.Сумма;
			НомерПоПорядку = НомерПоПорядку + 1;
			
		КонецЦикла;
		
		// Вывод подвала
		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(Шапка);
		Область.Параметры.Сумма = Сумма;
		Область.Параметры.СуммаПрописью = РаботаСКурсамиВалют.СформироватьСуммуПрописью(Сумма, Шапка.Валюта);
		
		СуммаОплаты = Взаиморасчеты.ПолучитьСуммуОплатыЗаПроживание(Шапка.Основание);
		Область.Параметры.СуммаОплатыПрописью = РаботаСКурсамиВалют.СформироватьСуммуПрописью(СуммаОплаты, Шапка.Валюта);
		Область.Параметры.СуммаОплатыЦелые = Окр(СуммаОплаты,0);
		Область.Параметры.СуммаОплатыКопейки = (СуммаОплаты - Окр(СуммаОплаты,0)) * 100;
		ТабличныйДокумент.Вывести(Область); 		
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно 
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьФормы3Г(МассивОбъектов , ОбъектыПечати)
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = УправлениеПечатью.ПолучитьМакет("Документ.Выселение.ПФ_MXL_3Г");
	ТабДок.Вывести(Макет.ПолучитьОбласть("Шапка"));
	
	Возврат ТабДок;	
	
	
КонецФУнкции

Функция ПечатьФормыАнкета(МассивОбъектов , ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_Выселение";
	Макет = УправлениеПечатью.ПолучитьМакет("Документ.Выселение.ПФ_MXL_Анкета");
	ТекДок = МассивОбъектов[0];
	Область = Макет.ПолучитьОбласть("Область");
	ФИО =ФизическиеЛицаКлиентСервер.ФамилияИмяОтчество(ТекДок.Контрагент.Наименование);
	Область.Параметры.Фамилия = ФИО.Фамилия;
	Область.Параметры.Имя = ФИО.Имя;
	Область.Параметры.Отчество = ФИО.Отчество;
	Область.Параметры.ДатаРождения =Формат(ТекДок.Контрагент.ДатаРождения,"ДФ=dd.MM.yyyy" ) ;
	Область.Параметры.МестоРождения =ТекДок.Контрагент.МестоРождения;
    Область.Параметры.Пол =ТекДок.Контрагент.Пол;
	Область.Параметры.Комната = ТекДок.ГостиничныйНомер.НомерНаПечать;
	Область.Параметры.Гражданство =ТекДок.Контрагент.Гражданство;
	Область.Параметры.ДокументУдос =ТекДок.Контрагент.ВидДокумента;
	Область.Параметры.Серия = ТекДок.Контрагент.Серия;
	Область.Параметры.Номер = ТекДок.Контрагент.Номер ;
	Область.Параметры.ВыданДата = Формат(ТекДок.Контрагент.ДатаВыдачи,"ДФ=dd.MM.yyyy" );
	Область.Параметры.ВыданКем = ТекДок.Контрагент.КемВыдан;
	Область.Параметры.МестоЖительство = ТекДок.Контрагент.МестоЖительства;
	Область.Параметры.Прибыл = Формат(ТекДок.ДатаЗаселения,"ДФ=dd.MM.yyyy" );
	Область.Параметры.Выбыл = Формат(ТекДок.ДатаВыселения,"ДФ=dd.MM.yyyy" );
	Область.Параметры.Зарегистрировал = Формат(ТекДок.ДатаЗаселения,"ДФ=dd.MM.yyyy" );
	Область.Параметры.Код = ТекДок.Контрагент.КодПодразделения;

	  	



	
	ТабличныйДокумент.Вывести(Область);
	
		
	Возврат ТабличныйДокумент;
КонецФункции