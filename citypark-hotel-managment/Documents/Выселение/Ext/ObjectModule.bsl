
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	НачатьТранзакцию();
	
	Если Основание.СтатусДокумента <> Перечисления.СтатусыДокументов.Закрыт Тогда
		
		ДокументЗаселения = Основание.ПолучитьОбъект();
		ДокументЗаселения.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт;
		ДокументЗаселения.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЕсли;
	
	// Состояние номеров
	Движения.СостояниеНомеров.Записывать = Истина;
	Для Каждого СтрокаПроживания Из Проживание Цикл			
		Движения.СостояниеНомеров.ДобавитьДвижение(Дата, Организация, ГостиничныйНомер, СтрокаПроживания.НачалоПериода, СтрокаПроживания.КонецПериода, Перечисления.ВидыСостоянийНомеров.Завершен);
	КонецЦикла;
	
	// Взаиморасчеты
	Движения.ВзаиморасчетыЗаПроживание.Записывать = Истина;
	
	НомерСтроки = 1;
	Для Каждого СтрокаСтоимости Из Стоимость Цикл
		
		ЭтоПоследняяСтрока = НомерСтроки = Стоимость.Количество();
		Если ЭтоПоследняяСтрока Тогда
			ИспользуемаяДатаВыселения = ?(СтрокаСтоимости.КонецПериода < Дата, СтрокаСтоимости.КонецПериода, Дата);
			Движения.ВзаиморасчетыЗаПроживание.ДобавитьЗадолженностьПоТарифамДляПоследнейСтроки(СтрокаСтоимости.НачалоПериода, ИспользуемаяДатаВыселения, Основание, СтрокаСтоимости.Тариф, СтрокаСтоимости.Количество, СтрокаСтоимости.Цена);		
		Иначе
			Движения.ВзаиморасчетыЗаПроживание.ДобавитьЗадолженностьПоТарифам(СтрокаСтоимости.НачалоПериода, Основание, СтрокаСтоимости.Тариф, СтрокаСтоимости.Количество, СтрокаСтоимости.Цена);		
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	// Уборка Номера
	Движения.УборкаНомеров.Записывать = Истина;
	Движение = Движения.УборкаНомеров.Добавить();
	Движение.Период = Дата;
	Движение.Убран = Ложь;
	Движение.ГостиничныйНомер = ГостиничныйНомер; 

	Если Отказ Тогда
		ОтменитьТранзакцию();
	Иначе
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если Не Отказ Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Движения.СостояниеНомеров.Очистить();
		Движения.СостояниеНомеров.Записать();
		
		Движения.ВзаиморасчетыЗаПроживание.Очистить();
		Движения.ВзаиморасчетыЗаПроживание.Записать();
		
		ДокументЗаселения = Основание.ПолучитьОбъект();
		ДокументЗаселения.СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;
		Попытка
			ДокументЗаселения.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Отказ = Истина;
		КонецПопытки;

		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли; 
	
КонецПроцедуры
