&НаСервере 
Процедура ПересчитатьСуммуДокумента()
	
	Ценообразование.ЗаполнитьТаблицуСтоимостиПроживания(Объект.Организация, Объект.ТипЦен, Объект.ГостиничныйНомер.ТипНомера, Объект.Проживание, Объект.Стоимость);
	Объект.Сумма = Объект.Стоимость.Итог("Сумма") + Объект.Заказы.Итог("Сумма");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусЗадолженности()
	
	Если Объект.Проведен Тогда // Документ проведен, он сформировал движения задолженности
		КОплате = Взаиморасчеты.ПолучитьДолгЗаПроживание(Объект.Ссылка, Объект.Основание, Объект.Сумма);
	Иначе
		КОплате = Взаиморасчеты.ПолучитьДолгЗаПроживание(Объект.Основание, Объект.Основание, Объект.Сумма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДокументыСозданыУспешно(ПараметрыОплаты)
	
	Результат = Ложь;
	
	НачатьТранзакцию();
	
	Попытка		
			
		Если ПараметрыОплаты.Наличные > 0 Тогда
			
			КассовыйЧек = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
			КассовыйЧек.СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;
			ЗаполнениеДокументов.ЗаполнитьОбъект(КассовыйЧек);
			КассовыйЧек.Организация = Объект.Организация;
			КассовыйЧек.ВидОперации = Перечисления.ВидыОперацийПКО.ОплатаНомера;
			КассовыйЧек.Основание = Объект.Основание;
			КассовыйЧек.Сумма = ПараметрыОплаты.Наличные;
			КассовыйЧек.Касса = Объект.ГостиничныйКорпус.Касса;
			КассовыйЧек.СтатьяДвижения = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПроживания;
			КассовыйЧек.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЕсли;
		
		Если ПараметрыОплаты.Безналичные > 0 Тогда

			БезналичнаяОплата = Документы.БезналичнаяОплата.СоздатьДокумент();
			БезналичнаяОплата.ВидОперации = Перечисления.ВидыОперацийБезналичнойОплаты.ОплатаНомеров;
			ЗаполнениеДокументов.ЗаполнитьОбъект(БезналичнаяОплата);
			БезналичнаяОплата.Организация = Объект.Организация;
			БезналичнаяОплата.Основание = Объект.Основание;
			БезналичнаяОплата.Сумма = ПараметрыОплаты.Безналичные;
			БезналичнаяОплата.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
		Результат = Истина;
		
	Исключение
		
		ОтменитьТранзакцию();
		
	КонецПопытки; 	
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПересчитатьДатыВыселения()
	
	СтартоваяДата = Объект.ДатаЗаселения;
	
	Для Каждого ТекСтрока Из Объект.Проживание Цикл
					
		ТекСтрока.НачалоПериода = СтартоваяДата;
		ТекСтрока.КонецПериода = УправлениеЗаселением.РассчитатьДатуПоТарифу(ТекСтрока.НачалоПериода, ТекСтрока.Тариф, ТекСтрока.Количество);
		СтартоваяДата = ТекСтрока.КонецПериода;
				
		Если ТекСтрока.НомерСтроки = Объект.Проживание.Количество() Тогда
			Объект.ДатаВыселения = ТекСтрока.КонецПериода;
		КонецЕсли;
		
	КонецЦикла;
	
	ПересчитатьСуммуДокумента();
		
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступность()
	
	ЭтаФорма.ТолькоПросмотр = ЭтаФорма.ТолькоПросмотр ИЛИ (Объект.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт И Не РольДоступна("АдминистраторСистемы"));
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ ФОРМЫ   		///////////////////////////////////////////


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
		
	// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

	// СтандартныеПодсистемы.Печать
	УправлениеПечатью.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Печать
	
	ЗаполнениеДокументов.ЗаполнитьШапку(Объект);
	
	Если ЗначениеЗаполнено(Параметры.Основание) Тогда
		
		Объект.Основание = Параметры.Основание;
		Объект.ГостиничныйКорпус = Параметры.Основание.ГостиничныйКорпус;
		Объект.ГостиничныйНомер = Параметры.Основание.ГостиничныйНомер;
		Объект.ДатаЗаселения = Параметры.Основание.ДатаЗаселения;
		Объект.ДатаВыселения = ТекущаяДата();
		Объект.Контрагент = Параметры.Основание.Контрагент;
		Объект.Организация = Параметры.Основание.Организация;
		Объект.ТипЦен = Параметры.Основание.ТипЦен;
		
		Для Каждого СтрокаПроживания Из Объект.Основание.Проживание Цикл
			
			НоваяСтрока = Объект.Проживание.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПроживания);
			
			Если СтрокаПроживания.КонецПериода >= Объект.ДатаВыселения Тогда
				
				НоваяСтрока.Количество = УправлениеЗаселением.РассчитатьКоличествоЕдиницТарифаПоДатам(НоваяСтрока.НачалоПериода, Объект.ДатаВыселения, НоваяСтрока.Тариф);
				НоваяСтрока.КонецПериода = Объект.ДатаВыселения;				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ПересчитатьСуммуДокумента();
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Валюта) Тогда
		Объект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	ОбновитьСтатусЗадолженности();
	
	
	
КонецПроцедуры


