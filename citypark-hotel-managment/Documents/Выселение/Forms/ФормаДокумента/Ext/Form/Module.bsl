////////////////////////////////	 БИЗНЕС-ЛОГИКА НА КЛИЕНТЕ   ///////////////////////////////////////////


&НаКлиенте
Процедура ВыполнитьОплатуДокумента()
	
	ПараметрыОткрытия = Новый Структура;
	
	Если КОплате > 0 Тогда
		
		ОповещениеОбОплате = Новый ОписаниеОповещения("ПользовательСовершилОплату", ЭтаФорма);
		ПараметрыОплаты = Новый Структура;
		ПараметрыОплаты.Вставить("КОплате", КОплате);
		ПараметрыОплаты.Вставить("Проживание", Объект.Стоимость);
		ПараметрыОплаты.Вставить("РазрешенаЧастичнаяОплата", Истина);
		ПараметрыОплаты.Вставить("Основание", Объект.Основание);
		
		ОткрытьФорму("ОбщаяФорма.ФормаОплаты", ПараметрыОплаты,,,,, ОповещениеОбОплате);
		
	ИначеЕсли КОплате < 0 Тогда
		
		ПараметрыОткрытия.Вставить("Сумма", КОплате * (-1));
		ПараметрыОткрытия.Вставить("Основание", Объект.Ссылка);		
		ПараметрыОткрытия.Вставить("СтатьяДвижения", ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ВозвратОплатыЗаПроживание"));
		ПараметрыОткрытия.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийРКО.ВозвратПоНомеру"));
		ПараметрыОткрытияФормыРКО = Новый Структура("ЗначенияЗаполнения", ПараметрыОткрытия);
		ОповещениеОВозвратеДС = Новый ОписаниеОповещения("ПользовательВернулДенежныеСредства", ЭтаФорма);
		ОткрытьФорму("Документ.РасходныйКассовыйОрдер.ФормаОбъекта", ПараметрыОткрытияФормыРКО,,,,, ОповещениеОВозвратеДС);

	КонецЕсли;

КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 КОМАНДЫ     //////////////////////////////////////////////////////////


&НаКлиенте
Процедура КомандаОплатить(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ВыполнитьОплатуДокумента();
		
	Иначе
		
		ОповещениеОбОтветеПользователя = Новый ОписаниеОповещения("ПользовательОтветилНаНеобходимостьПроведенияДокумента", ЭтаФорма);
	    ПоказатьВопрос(ОповещениеОбОтветеПользователя, "Перед оплатой документ необходимо записать. Записать?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;	  	
		
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ ФОРМЫ    /////////////////////////////////////////////////


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступность();
	ОбновитьСтатусЗадолженности();
	ЗаполнениеТЧЗаказы();
	
КонецПроцедуры

&НаКлиенте
Процедура  ЗаполнениеТЧЗаказы()
	
	Заказ = Заказы(Объект.Основание);
	Если Заказ <>Неопределено Тогда
		
		Для Каждого Строка Из Заказ Цикл
			
			СтрокаТЧЗаказы = ЭтаФорма.Объект.Заказы.Добавить();
			СтрокаТЧЗаказы.Дата = Строка.Дата;
			СтрокаТЧЗаказы.Номенклатура = Строка.Номенклатура;
			СтрокаТЧЗаказы.ЕдиницаИзмерения = Строка.ЕдиницаИзмерения;
			СтрокаТЧЗаказы.Количество = Строка.Количество;
			СтрокаТЧЗаказы.Коэффициент = Строка.Коэффициент;
			СтрокаТЧЗаказы.Сумма = Строка.Сумма;
			СтрокаТЧЗаказы.Цена = Строка.Сумма / Строка.Количество;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция Заказы(Основание)
	
	мсДанные = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("Основание",Основание);
	Запрос.Параметры.Вставить("ДатаНачало",Основание.ДатаЗаселения);
	Запрос.Параметры.Вставить("ДатаКонец",Основание.ДатаВыселения);
	Запрос.Текст ="ВЫБРАТЬ
	|	ПродажиОбороты.Период КАК Период,
	|	ПродажиОбороты.ЕдиницаИзмерения.Коэффициент КАК ЕдиницаИзмеренияКоэффициент,
	|	ПродажиОбороты.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПродажиОбороты.Номенклатура КАК Номенклатура,
	|	ПродажиОбороты.КоличествоОборот,
	|	ПродажиОбороты.СуммаОборот,
	|	ПродажиОбороты.Регистратор.Основание
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&ДатаНачало, &ДатаКонец, Регистратор, ) КАК ПродажиОбороты
	|ГДЕ
	|	ПродажиОбороты.Регистратор.Основание = &Основание";
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	мсДанные = Новый Массив;
	
	Для каждого Строка из Выгрузка Цикл
		
		Результат = Новый Структура("Дата,ЕдиницаИзмерения,Номенклатура,Сумма,Количество,Коэффициент",Строка.Период,Строка.ЕдиницаИзмерения,Строка.Номенклатура,Строка.СуммаОборот,Строка.КоличествоОборот,Строка.ЕдиницаИзмеренияКоэффициент);
		мсДанные.Добавить(Результат);
	КонецЦикла;
	
	Возврат мсДанные;

  КонецФункции 

