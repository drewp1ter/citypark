	ОбновитьСтатусЗадолженности();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроживаниеКоличествоПриИзменении(Элемент)
	
	ПересчитатьДатыВыселения();
	ОбновитьСтатусЗадолженности();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроживаниеКонецПериодаПриИзменении(Элемент)
	
	ОбновитьСтатусЗадолженности();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроживаниеТарифПриИзменении(Элемент)
	
	ПересчитатьДатыВыселения();
	ОбновитьСтатусЗадолженности();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроживаниеНачалоПериодаПриИзменении(Элемент)
	
	ПересчитатьДатыВыселения();
	ОбновитьСтатусЗадолженности();
	
КонецПроцедуры


