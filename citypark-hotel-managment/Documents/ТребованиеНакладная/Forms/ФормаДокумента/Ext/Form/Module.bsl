
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнениеДокументов.ЗаполнитьШапку(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	Если Элементы.Товары.ТекущиеДанные <> Неопределено Тогда
		ТоварыНоменклатураПриИзмененииНаСервере(Элементы.Товары.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ТоварыНоменклатураПриИзмененииНаСервере(НомерСтроки)
	
	ТекСтрока = Объект.Товары[НомерСтроки];
	ТекСтрока.ЕдиницаИзмерения = ТекСтрока.Номенклатура.ОсновнаяЕдиницаИзмерения;
	ТекСтрока.Коэффициент = ТекСтрока.ЕдиницаИзмерения.Коэффициент;
	ТекСтрока.Склад = Объект.Склад;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияПриИзменении(Элемент)
	
	Если Элементы.Товары.ТекущиеДанные <> Неопределено Тогда
		ТоварыЕдиницаИзмеренияПриИзмененииНаСервере(Элементы.Товары.ТекущиеДанные.НомерСтроки - 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ТоварыЕдиницаИзмеренияПриИзмененииНаСервере(НомерСтроки)
	
	ТекСтрока = Объект.Товары[НомерСтроки];
	ТекСтрока.Коэффициент = ТекСтрока.ЕдиницаИзмерения.Коэффициент;
		
КонецПроцедуры
