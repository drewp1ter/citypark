
// Заполняет список команд печати.
//
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Прайс-лист
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.УстановкаЦенПроживания";
	КомандаПечати.Идентификатор = "ПрайсЛист";
	КомандаПечати.Представление = НСтр("ru = 'Прайс-лист'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	// Прайс-лист
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ЗакрытиеСменыАдминистратораГостиницы";
	КомандаПечати.Идентификатор = "ПФ_MXL_ЗакрытиеСменыГостиницы";
	КомандаПечати.Представление = НСтр("ru = 'ЗакрытиеСмены'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПрайсЛист");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПрайсЛист",
		НСтр("ru = 'Прайс-лист'"),
		ПечатьПрайсЛиста(МассивОбъектов, ОбъектыПечати),
		,
		"Документ.УстановкаЦенПроживания.ПФ_MXL_ПрайсЛист");
	КонецЕсли;
	
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ЗакрытиеСменыГостиницы");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПФ_MXL_ЗакрытиеСменыГостиницы",
		НСтр("ru = 'ЗакрытиеСмены'"),
		ПечатьЗакрытиеСменыГостиницы(МассивОбъектов, ОбъектыПечати, ПараметрыПечати),
		,
		"Документ.ЗакрытиеСменыАдминистратораГостиницы.ПФ_MXL_ЗакрытиеСменыГостиницы");
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПечатьЗакрытиеСменыГостиницы(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Создаем табличный документ , получаем макет
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = УправлениеПечатью.ПолучитьМакет("Документ.ЗакрытиеСменыАдминистратораГостиницы.ПФ_MXL_ЗакрытиеСменыГостиницы");
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ЗакрытиеСменыАдминистратораГостиницы_ПФ_MXL_ЗакрытиеСменыГостиницы";
	ЗаполнитьЗначенияСвойств(ТабличныйДокумент, ПараметрыПечати);	
	
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 	"ВЫБРАТЬ
	|	ЗакрытиеСменыАдминистратораГостиницы.Ссылка,
	|	ЗакрытиеСменыАдминистратораГостиницы.Организация,
	|	ЗакрытиеСменыАдминистратораГостиницы.ГостиничныйКорпус,
	|	ЗакрытиеСменыАдминистратораГостиницы.СменуПринял,
	|	ЗакрытиеСменыАдминистратораГостиницы.СменуСдал
	|ИЗ
	|	Документ.ЗакрытиеСменыАдминистратораГостиницы КАК ЗакрытиеСменыАдминистратораГостиницы
	|ГДЕ
	|	ЗакрытиеСменыАдминистратораГостиницы.Ссылка В (&МассивОбъектов)";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		//ЛОГОТИП
		ОбластьЛоготип = Макет.ПолучитьОбласть("Логотип");
		ОбластьЛоготип.Параметры.Организация = Выборка.Организация;
		ОбластьЛоготип.Параметры.ГостиничныйКорпус = Выборка.ГостиничныйКорпус;
		ОбластьЛоготип.Параметры.ВремяПечати = ТекущаяДата();
		
		ТабличныйДокумент.Вывести(ОбластьЛоготип);
		
		//Выселение
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивОбъектов",МассивОбъектов);
		Запрос.Текст = "ВЫБРАТЬ
		|	ЗакрытиеСменыАдминистратораГостиницыВыселения.Ссылка,
		|	ЗакрытиеСменыАдминистратораГостиницыВыселения.ГостиничныйНомер
		|ИЗ
		|	Документ.ЗакрытиеСменыАдминистратораГостиницы.Выселения КАК ЗакрытиеСменыАдминистратораГостиницыВыселения
		|ГДЕ
		|	ЗакрытиеСменыАдминистратораГостиницыВыселения.Ссылка В (&МассивОбъектов)";
		
		ВыгрузкаЗапроса = Запрос.Выполнить().Выгрузить();
		
		ОбластьВыселения = Макет.ПолучитьОбласть("ВыселенныеНомера");
		ОбластьВыселеноКоличество = Макет.ПолучитьОбласть("НадписьВыселеноНомеров");
		ОбластьВыселеноКоличество.Параметры.Выселено = ВыгрузкаЗапроса.Количество();
		ТабличныйДокумент.Вывести(ОбластьВыселеноКоличество);
		
		
		Номер = "";
		Для Каждого СтрокаВыгрузки из ВыгрузкаЗапроса Цикл
			
			Если СтрокаВыгрузки.ГостиничныйНомер.НомерНаПечать <> null Тогда
				
				
				Номер =  Номер  + СтрокаВыгрузки.ГостиничныйНомер.НомерНаПечать + "," ;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Номер =  Сред(Номер, 1 ,СтрДлина(Номер) -1);
		ОбластьВыселения.Параметры.Номер = Номер;
		ТабличныйДокумент.Вывести(ОбластьВыселения);
		
		
		//ЗанятоНомеров
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивОбъектов",МассивОбъектов);
		Запрос.Текст = "ВЫБРАТЬ
		|	ЗакрытиеСменыАдминистратораГостиницыЗанятыеНомера.Ссылка,
		|	ЗакрытиеСменыАдминистратораГостиницыЗанятыеНомера.ГостиничныйНомер
		|ИЗ
		|	Документ.ЗакрытиеСменыАдминистратораГостиницы.ЗанятыеНомера КАК ЗакрытиеСменыАдминистратораГостиницыЗанятыеНомера
		|ГДЕ
		|	ЗакрытиеСменыАдминистратораГостиницыЗанятыеНомера.Ссылка В (&МассивОбъектов)";
		
		ВыгрузкаЗапроса = Запрос.Выполнить().Выгрузить();
		
		ОбластьЗанятостьНомеров = Макет.ПолучитьОбласть("ЗанятоНомеров");
		ОбластьКолВоЗанятыхНомеров = Макет.ПолучитьОбласть("НадписьЗанятоНомеров");
		ОбластьКолВоЗанятыхНомеров.Параметры.Занято = ВыгрузкаЗапроса.Количество();
		ТабличныйДокумент.Вывести(ОбластьКолВоЗанятыхНомеров);
		
		Номер = "";
		Для Каждого СтрокаВыгрузки из ВыгрузкаЗапроса Цикл
			
			Если СтрокаВыгрузки.ГостиничныйНомер.НомерНаПечать <> null Тогда
				
				
				Номер =  Номер   + СтрокаВыгрузки.ГостиничныйНомер.НомерНаПечать + "," ;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Номер =  Сред(Номер, 1 ,СтрДлина(Номер) -1);
		
		ОбластьЗанятостьНомеров.Параметры.Номер = Номер;
			ТабличныйДокумент.Вывести(ОбластьЗанятостьНомеров);

		
		//СМЕНА
		ОбластьСмена = Макет.ПОлучитьОбласть("Смена");
		
		ФИОСдал = выборка.СменуСдал.Фамилия + " " + Лев(Выборка.СменуСдал.Имя, 1) + "." + Лев(Выборка.СменуСдал.Отчество, 1) + ".";
		ФИОПринял = выборка.СменуПринял.Фамилия + " " + Лев(Выборка.СменуПринял.Имя, 1) + "." + Лев(Выборка.СменуПринял.Отчество, 1) + ".";



		ОбластьСмена.Параметры.СменуСдал = ФИОСдал;
		ОбластьСмена.Параметры.СменуПринял = ФИОПринял;
		
		ТабличныйДокумент.Вывести(ОбластьСмена);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьПрайсЛиста(МассивОбъектов, ОбъектыПечати)
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = УправлениеПечатью.ПолучитьМакет("Документ.УстановкаЦенПроживания.ПФ_MXL_ПрайсЛист");
	ТабДок.Вывести(Макет.ПолучитьОбласть("Шапка"));
	Возврат ТабДок;
	
КонецФункции