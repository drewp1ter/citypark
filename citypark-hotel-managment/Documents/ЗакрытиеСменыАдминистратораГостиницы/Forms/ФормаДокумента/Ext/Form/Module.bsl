&НаСервере
Процедура ЗаполнитьДокументНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ГостиничныйКорпус", Объект.ГостиничныйКорпус);
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостояниеНомеровСрезПоследних.ГостиничныйНомер,
	               |	СостояниеНомеровСрезПоследних.Состояние,
	               |	МАКСИМУМ(СостояниеНомеровСрезПоследних.ДатаЗаселения) КАК Дата,
	               |	СостояниеНомеровСрезПоследних.ДатаВыселения
	               |ИЗ
	               |	РегистрСведений.СостояниеНомеров.СрезПоследних(
	               |			&Период,
	               |			Организация = &Организация
	               |				И ГостиничныйНомер.Владелец = &ГостиничныйКорпус) КАК СостояниеНомеровСрезПоследних
	               |ГДЕ
	               |	СостояниеНомеровСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Завершен)
	               |	И СостояниеНомеровСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Свободен)
	               |	И &Период МЕЖДУ СостояниеНомеровСрезПоследних.ДатаЗаселения И СостояниеНомеровСрезПоследних.ДатаВыселения
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СостояниеНомеровСрезПоследних.ДатаВыселения,
	               |	СостояниеНомеровСрезПоследних.ГостиничныйНомер,
	               |	СостояниеНомеровСрезПоследних.Состояние";
	
	Объект.ЗанятыеНомера.Очистить();
	Объект.ЗанятыеНомера.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостояниеНомеровСрезПоследних.ГостиничныйНомер,
	               |	СостояниеНомеровСрезПоследних.Состояние,
	               |	МАКСИМУМ(СостояниеНомеровСрезПоследних.ДатаЗаселения) КАК Дата,
	               |	СостояниеНомеровСрезПоследних.ДатаВыселения,
	               |	СостояниеНомеровСрезПоследних.Регистратор КАК Документ
	               |ИЗ
	               |	РегистрСведений.СостояниеНомеров.СрезПоследних(
	               |			&Период,
	               |			Организация = &Организация
	               |				И ГостиничныйНомер.Владелец = &ГостиничныйКорпус) КАК СостояниеНомеровСрезПоследних
	               |ГДЕ
	               |	СостояниеНомеровСрезПоследних.ДатаВыселения < &Период
	               |	И СостояниеНомеровСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Завершен)
	               |	И СостояниеНомеровСрезПоследних.Состояние <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийНомеров.Свободен)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СостояниеНомеровСрезПоследних.ДатаВыселения,
	               |	СостояниеНомеровСрезПоследних.ГостиничныйНомер,
	               |	СостояниеНомеровСрезПоследних.Состояние,
	               |	СостояниеНомеровСрезПоследних.Регистратор";
				   
	Объект.НезакрытыеДокументы.Очистить();
	Объект.НезакрытыеДокументы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Запрос.УстановитьПараметр("НачалоСмены", Объект.НачалоСмены);
	Запрос.УстановитьПараметр("КонецСмены", Объект.КонецСмены);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Выселение.ГостиничныйНомер,
	               |	Выселение.Ссылка КАК Документ,
	               |	СУММА(ОстаткиЗадолженности.Задолженность) КАК Задолженность
	               |ИЗ
	               |	Документ.Выселение КАК Выселение
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВзаиморасчетыЗаПроживаниеОстатки.ДокументРасчетов КАК ДокументРасчетов,
	               |			ВзаиморасчетыЗаПроживаниеОстатки.СуммаОстаток КАК Задолженность
	               |		ИЗ
	               |			РегистрНакопления.ВзаиморасчетыЗаПроживание.Остатки(&КонецСмены, ) КАК ВзаиморасчетыЗаПроживаниеОстатки
	               |		ГДЕ
	               |			ВзаиморасчетыЗаПроживаниеОстатки.СуммаОстаток > 0) КАК ОстаткиЗадолженности
	               |		ПО Выселение.Основание = ОстаткиЗадолженности.ДокументРасчетов
	               |ГДЕ
	               |	Выселение.Дата МЕЖДУ &НачалоСмены И &КонецСмены
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Выселение.Ссылка,
	               |	Выселение.ГостиничныйНомер";
				   
	Объект.Выселения.Очистить();
	Объект.Выселения.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступность()
	
	ЭтаФорма.ТолькоПросмотр = Объект.СтатусДокумента = Перечисления.СтатусыДокументов.Закрыт И Не РольДоступна("АдминистраторСистемы");
	
КонецПроцедуры


