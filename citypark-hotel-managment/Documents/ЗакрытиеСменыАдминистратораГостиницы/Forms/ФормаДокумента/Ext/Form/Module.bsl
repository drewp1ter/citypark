&НаКлиенте
Процедура КомандаЗаполнить(Команда)
	
	Если ЗначениеЗаполнено(Объект.НачалоСмены) Тогда
		
		Если ЗначениеЗаполнено(Объект.КонецСмены) Тогда
			
			ЗаполнитьДокументНаСервере();
			
		Иначе
			
			Сообщить("Не указано время окончания смены!");
			
		КонецЕсли;
		
	Иначе
		
		Сообщить("Не указано время начала смены!");
		
	КонецЕсли;
	
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ ФОРМЫ    /////////////////////////////////////////////////


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.НезакрытыеДокументы.Количество() > 0 Тогда
		
		Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаНезакрытыеНомера;
		
	КонецЕсли;
	
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ РЕКВИЗИТОВ ФОРМЫ   ///////////////////////////////////////



&НаКлиенте
Процедура НовыйАдминистраторПриИзменении(Элемент)
	
	Если Объект.СменуСдал = Объект.СменуПринял Тогда
		
		Объект.СменуПринял = ПредопределенноеЗначение("Справочник.ФизическиеЛица.ПустаяСсылка");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя принять смену от самого себя!", Объект.СменуПринял, "СменуПринял");
		
	КонецЕсли;
	
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////	 ОБРАБОТЧИКИ ТАБЛИЧНЫХ ЧАСТЕЙ ФОРМЫ    ////////////////////////////////


&НаКлиенте
Процедура НезакрытыеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Документ = Объект.НезакрытыеДокументы.НайтиПоИдентификатору(ВыбраннаяСтрока).Документ;
	ПараметрыОткрытия = Новый Структура("Ключ", Объект.НезакрытыеДокументы.НайтиПоИдентификатору(ВыбраннаяСтрока).Документ);
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.Заселение") Тогда
			
		ОткрытьФорму("Документ.Заселение.ФормаОбъекта", ПараметрыОткрытия);	
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.Бронирование") Тогда
		
		ОткрытьФорму("Документ.Бронирование.ФормаОбъекта", ПараметрыОткрытия);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыселенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Объект.Выселения.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ПараметрыОткрытия = Новый Структура("Ключ", ТекущаяСтрока.Документ);
	ОткрытьФорму("Документ.Выселение.ФормаОбъекта", ПараметрыОткрытия);
	
КонецПроцедуры

