
Процедура ОбработкаПроведения(Отказ, Режим)
	
	// регистр Продажи 
	Движения.Продажи.Записывать = Истина;
	Для Каждого ТекСтрокаТовары Из Товары Цикл		
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.ТорговаяТочка = ТорговаяТочка;
		Движение.ВидОперации = ВидОперации;
		Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
		Движение.ЕдиницаИзмерения = ТекСтрокаТовары.ЕдиницаИзмерения;
		Движение.Количество = ТекСтрокаТовары.Количество;
		Движение.Сумма = ТекСтрокаТовары.Сумма;
	КонецЦикла;
	
	// регистр ОстаткиТМЦ Расход
	Движения.ОстаткиТМЦ.Записывать = Истина;
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		
		Если Не ТекСтрокаТовары.Номенклатура.Услуга Тогда
			
			Движение = Движения.ОстаткиТМЦ.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Организация = Организация;
			Движение.Склад = Склад;
			Движение.Партия = Ссылка;
			Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
			Движение.Количество = ТекСтрокаТовары.Количество;
			Движение.Сумма = ТекСтрокаТовары.Сумма;
			
		КонецЕсли;
		
	КонецЦикла;
		
	Если СтатусДокумента = Перечисления.СтатусыДокументов.Открыт Тогда	
		
		Если ВидОперации = Перечисления.ВидыОперацийЧекККМ.ВключитьВСчетЗаНомер Тогда
			
			Движения.ВзаиморасчетыЗаПроживание.Записывать = Истина;
			Движения.ВзаиморасчетыЗаПроживание.ДобавитьЗадолженность(Дата, Основание, Сумма);
			
		КонецЕсли; 		
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	СтатусДокумента = Перечисления.СтатусыДокументов.Открыт;	
	Ответственный = ЗаполнениеДокументовВызовСервера.ПолучитьТекущегоПользователя();
	
	Если ДанныеЗаполнения = Неопределено Тогда // Ввод нового объекта, заполняем по умолчанию
		
		ВидОперации = Перечисления.ВидыОперацийЧекККМ.Продажа;
		ЗаполнениеДокументовВызовСервера.ЗаполнитьОбъект(ЭтотОбъект);
		
	Иначе // Заполняем переданными значениями
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры
