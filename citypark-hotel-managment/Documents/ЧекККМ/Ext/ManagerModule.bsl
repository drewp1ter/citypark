
// Заполняет список команд печати.
//
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Чек
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ЧекККМ";
	КомандаПечати.Идентификатор = "ПечатьЧекККМ";
	КомандаПечати.Представление = НСтр("ru = 'Чек ККМ'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	// Печать чека
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПечатьЧекККМ");
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПечатьЧекККМ",
		НСтр("ru = 'Чек ККМ'"),
		ПечатьЧекККМ(МассивОбъектов, ОбъектыПечати),
		,
		"Документ.ЧекККМ.ПФ_MXL_Чек");
	КонецЕсли;
	
	// Печать заявок на приготовление блюд
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗаявкиНаПриготовление");
	Если НужноПечататьМакет Тогда
		
		Если ПараметрыПечати.Свойство("СоответствиеПринтеров") Тогда
						
			Для Каждого ДокументПечати Из МассивОбъектов Цикл
				
				ТаблицаТоваров = ДокументПечати.Товары.Выгрузить();
				ТаблицаТоваров.Колонки.Добавить("НоменклатурнаяГруппа");
				
				Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
					
					СтрокаТовара.НоменклатурнаяГруппа = СтрокаТовара.Номенклатура.НоменклатурнаяГруппа;
					
				КонецЦикла;
				
				ТаблицаТоваров.Свернуть("НоменклатурнаяГруппа, Номенклатура, ЕдиницаИзмерения, Коэффициент, Цена", "Количество, Сумма");
				
				ТаблицаНоменклатурныхГрупп = ТаблицаТоваров.Скопировать();
				ТаблицаНоменклатурныхГрупп.Свернуть("НоменклатурнаяГруппа");
				
				Для Каждого ТекущаяНоменклатурнаяГруппа Из ТаблицаНоменклатурныхГрупп Цикл
					
					ИмяПринтера = ПолучитьИмяПринтераДляНоменклатурнойГруппы(ПараметрыПечати, ТекущаяНоменклатурнаяГруппа.НоменклатурнаяГруппа);
					
					Если ИмяПринтера <> "" Тогда
						
						Отбор = Новый Структура("НоменклатурнаяГруппа", ТекущаяНоменклатурнаяГруппа.НоменклатурнаяГруппа); 						
						СтрокиКПечати = ТаблицаТоваров.НайтиСтроки(Отбор);
						
						Если СтрокиКПечати.Количество() > 0 Тогда
							
							УИД = Новый УникальныйИдентификатор();
							НовыйТабДок = КоллекцияПечатныхФорм.Добавить();
							НовыйТабДок.ИмяВРег = ВРег("ЗаявкиНаПриготовление" + Строка(УИД));
							НовыйТабДок.ИмяМакета = "ЗаявкиНаПриготовление" + Строка(УИД);
							НовыйТабДок.Экземпляров = 1;
							
							УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ЗаявкиНаПриготовление" + Строка(УИД),
								НСтр("ru = 'Заявка на приготовление " + ТекущаяНоменклатурнаяГруппа.НоменклатурнаяГруппа + "'"),
								ПечатьЗаявокНаПриготовление(ДокументПечати, ТекущаяНоменклатурнаяГруппа.НоменклатурнаяГруппа, СтрокиКПечати, ОбъектыПечати, ИмяПринтера)
							,
							"Документ.ЧекККМ.ПФ_MXL_ЗаявкаНаПриготовление");
							
						КонецЕсли;
						
					Иначе
						
						Сообщить("Не задан чековый принтер по умолчанию! Печать невозможна!");
						
					КонецЕсли;
					
				КонецЦикла; 
				
			КонецЦикла;	
			
			// Удаляем пустые документы
			Индекс = КоллекцияПечатныхФорм.Количество() - 1;
			Пока Индекс >= 0 Цикл
				
				Если КоллекцияПечатныхФорм[Индекс].ТабличныйДокумент = Неопределено Тогда
					КоллекцияПечатныхФорм.Удалить(КоллекцияПечатныхФорм.Получить(Индекс));
				КонецЕсли;
				
				Индекс = Индекс - 1;
				
			КонецЦикла;
			
		Иначе
			
			Сообщить("Не заданы настройки чекового принтера для данного рабочего места! Печать невозможна!");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьЧекККМ(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ЧекККМ";
	
	Макет = УправлениеПечатью.ПолучитьМакет("Документ.ЧекККМ.ПФ_MXL_Чек");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЧекККМ.ТорговаяТочка КАК ТорговыйЗал,
	|	ЧекККМ.ВидОперации,
	|	ЧекККМ.Склад,
	|	ЧекККМ.Дата КАК ВремяПечати,
	|	ЧекККМ.Основание,
	|	ЧекККМ.Номер,
	|	ЧекККМ.Сумма,
	|	ЧекККМ.Ссылка
	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|ГДЕ
	|	ЧекККМ.Ссылка В(&МассивОбъектов)";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Шапка = Запрос.Выполнить().Выбрать();
	ПервыйДокумент = Истина;
	
	
	Пока Шапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Сумма = 0;
		
		Область = Макет.ПолучитьОбласть("Логотип");
		Область.Параметры.Заполнить(Шапка);
		Область.Параметры.ВремяПечати = ТекущаяДата();
		
		ТабличныйДокумент.Вывести(Область);
		
		// Вывод заказов		
		ЗапросЗаказов = Новый Запрос;
		ЗапросЗаказов.УстановитьПараметр("Основание", Шапка.Ссылка);
		ЗапросЗаказов.Текст = "ВЫБРАТЬ
		                      |	ЧекККМТовары.Номенклатура,
		                      |	ЧекККМТовары.ЕдиницаИзмерения,
		                      |	СУММА(ЧекККМТовары.Количество) КАК Количество,
		                      |	СУММА(ЧекККМТовары.Сумма) КАК Сумма,
		                      |	ЧекККМТовары.Цена
		                      |ИЗ
		                      |	Документ.ЧекККМ.Товары КАК ЧекККМТовары
		                      |ГДЕ
		                      |	ЧекККМТовары.Ссылка = &Основание
		                      |
		                      |СГРУППИРОВАТЬ ПО
		                      |	ЧекККМТовары.ЕдиницаИзмерения,
		                      |	ЧекККМТовары.Номенклатура,
		                      |	ЧекККМТовары.Цена";
		
		ТаблицаЗаказов = ЗапросЗаказов.Выполнить().Выгрузить();
		
		Для Каждого СтрокаЗаказа Из ТаблицаЗаказов Цикл
			
			Область = Макет.ПолучитьОбласть("СтрокаЗаказа");
			Область.Параметры.Заполнить(СтрокаЗаказа);
			ТабличныйДокумент.Вывести(Область);
			
			Сумма = Сумма + СтрокаЗаказа.Сумма;
			
		КонецЦикла;
		
		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(Шапка);
		Область.Параметры.СуммаИтого = Сумма;
		
		
		
		СуммаОплаты = Взаиморасчеты.ПолучитьСуммуОплатыЗаПроживание(Шапка.Основание);
		ТабличныйДокумент.Вывести(Область); 		
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьЗаявокНаПриготовление(ДокументПечати, НоменклатурнаяГруппа, СтрокиКПечати, ОбъектыПечати, ИмяПринтера)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ЧекККМ_ЗаявкиНаПриготовление";
	ТабличныйДокумент.ИмяПринтера = ИмяПринтера;
	
	Макет = УправлениеПечатью.ПолучитьМакет("Документ.ЧекККМ.ПФ_MXL_ЗаявкаНаПриготовление");
	Область = Макет.ПолучитьОбласть("Шапка");
	Область.Параметры.ТорговыйЗал = ДокументПечати.ТорговаяТочка;
	Область.Параметры.Склад = НоменклатурнаяГруппа;
	Область.Параметры.ВремяПечати = ТекущаяДата();
	Область.Параметры.ВидОперации = "Заявка с гостиницы";
	ТабличныйДокумент.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("НомерДоставки");
	Область.Параметры.НомерДоставки = ДокументПечати.ГостиничныйНомер;
	ТабличныйДокумент.Вывести(Область);
	
	СуммаИтого = 0;
	Для Каждого СтрокаТовара Из СтрокиКПечати Цикл
		
		Область = Макет.ПолучитьОбласть("СтрокаЗаказа");
		Область.Параметры.Заполнить(СтрокаТовара);
		СуммаИтого = СуммаИтого + СтрокаТовара.Сумма;
		ТабличныйДокумент.Вывести(Область);
		
	КонецЦикла;
	
	Область = Макет.ПолучитьОбласть("Подвал");
	Область.Параметры.СуммаИтого = СуммаИтого;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ПолеСверху = 0; ТабличныйДокумент.ПолеСнизу = 0;
	ТабличныйДокумент.ПолеСлева = 0;  ТабличныйДокумент.ПолеСправа = 0;			
	ТабличныйДокумент.Вывести(Область);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПолучитьИмяПринтераДляНоменклатурнойГруппы(ПараметрыПечати, НоменклатурнаяГруппа) 
	
	ИмяПринтера = ПараметрыПечати.СоответствиеПринтеров[НоменклатурнаяГруппа];
	
	Если ИмяПринтера = "" Тогда
		
		ИмяПринтера = ПараметрыПечати.ПринтерПоУмолчанию;
		
	КонецЕсли;
	
	Возврат ИмяПринтера;
	
КонецФункции
