# Release tag matching the loaded image archive.
RELEASE_TAG=
# HTTPS origins, without a trailing slash or path. Replace these domains in nginx too.
SITE_ORIGIN=https://citypark.example.com
ADMIN_ORIGIN=https://admin.citypark.example.com
# Required: generate with openssl rand -hex 32 (hex avoids URI escaping in DATABASE_URL).
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
# iiko photo hostname only, e.g. images.example.com (no scheme or path).
MENU_IMAGE_HOST=
# Optional public build settings. Changing these requires rebuilding the website.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
