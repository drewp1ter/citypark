# Application
APP_ENV=development
PORT=3000
DEBUG=false
APP_TIMEZONE=Europe/Moscow
DEFAULT_PAGE_SIZE=100

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/citypark_dev?sslmode=disable

# Authentication
JWT_SECRET=changeme
JWT_EXPIRES_IN=24h

# Admin account created at startup
ADMIN_EMAIL=dev@dev.io
ADMIN_PASSWORD=devdevdev
ADMIN_PHONE=+79990000000

# iiko
IIKO_BASE_URL=https://api-ru.iiko.services/api
IIKO_API_KEY=
IIKO_APP_ID=
IIKO_CLIENT_SECRET=
IIKO_ORGANIZATION_ID=
IIKO_EXTERNAL_MENU_ID=
IIKO_UPDATE_TOKEN=
# how often the server syncs the menu, e.g. 30m; 0 = never (production: 30m)
IIKO_SYNC_INTERVAL=0

# Telegram
TELEGRAM_BASE_URL=https://api.telegram.org
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID_FOR_ORDER_CREATED=
TELEGRAM_CHAT_ID_FOR_ORDER_CONFIRMED=

# Moneta
MONETA_ID=
MONETA_SECRET=
MONETA_TEST_MODE=true

# Hotel: shared secret for POST /hotel/rooms (X-Webhook-Secret header); empty disables the endpoint
HOTEL_WEBHOOK_SECRET=

# where uploaded images are stored (a persistent volume in production)
UPLOAD_DIR=./uploads
# public origin of this server; uploaded image URLs start with it
PUBLIC_BASE_URL=http://localhost:3000

# Working hours
WORKING_HOURS_START=9:00
WORKING_HOURS_END=22:00

# Frontend
THANK_YOU_PAGE_PAYMENT_CASH=http://localhost:3001/thankyou
