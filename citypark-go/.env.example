# Application
APP_ENV=development
PORT=3000
DEBUG=false
APP_TIMEZONE=Europe/Moscow
DEFAULT_PAGE_SIZE=100

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/citypark_dev?sslmode=disable

# Authentication
JWT_SECRET=changeme
CUSTOMER_AUTH_ENABLED=false
CUSTOMER_PUBLIC_ORIGIN=http://localhost:3001
# Leave all Google fields empty until Google sign-in is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Customer email links use /account/verify and /account/email on this origin.
# Customer email. Leave all fields empty until customer authentication is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
JWT_EXPIRES_IN=24h

# Admin account created at startup
ADMIN_EMAIL=dev@dev.io
ADMIN_PASSWORD=devdevdev
ADMIN_PHONE=+79990000000

# iiko
IIKO_BASE_URL=https://api-ru.iiko.services/api
IIKO_API_KEY=
IIKO_APP_ID=
IIKO_CLIENT_SECRET=
IIKO_ORGANIZATION_ID=
IIKO_EXTERNAL_MENU_ID=
IIKO_UPDATE_TOKEN=
# paid online orders are created in iiko; without the first two ids they are not sent
IIKO_TERMINAL_GROUP_ID=
IIKO_PAYMENT_TYPE_ID=
IIKO_PAYMENT_TYPE_KIND=Card
# placeholder address of the iiko order (the restaurant); the real address goes into the comment
IIKO_ADDRESS_CITY=Белореченск
IIKO_ADDRESS_STREET=Гоголя
IIKO_ADDRESS_HOUSE=61
# how often the server syncs the menu, e.g. 30m; 0 = never (production: 30m)
IIKO_SYNC_INTERVAL=0

# Telegram
TELEGRAM_BASE_URL=https://api.telegram.org
TELEGRAM_TOKEN=
CUSTOMER_TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_FOR_ORDER_CREATED=
TELEGRAM_CHAT_ID_FOR_ORDER_CONFIRMED=

# Moneta
MONETA_ID=
MONETA_SECRET=
MONETA_TEST_MODE=true
# Production: https://www.payanyway.ru/assistant.htm
MONETA_URL=https://assistant.demo.moneta.ru/
MONETA_SUCCESS_URL=http://localhost:3001/checkout/done
MONETA_FAIL_URL=http://localhost:3001/checkout?payment=failed

# Hotel: shared secret for POST /hotel/rooms (X-Webhook-Secret header); empty disables the endpoint
HOTEL_WEBHOOK_SECRET=

# 1C HTTP services of the hotel database; empty URL disables /reports
ONEC_HOTEL_URL=
ONEC_USER=
ONEC_PASSWORD=

# where uploaded images are stored (a persistent volume in production)
UPLOAD_DIR=./uploads
# public origin of this server; uploaded image URLs start with it
PUBLIC_BASE_URL=http://localhost:3000
